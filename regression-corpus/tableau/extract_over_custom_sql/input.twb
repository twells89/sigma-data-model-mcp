<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1'>
  <datasources>
    <datasource caption='Funnel Creation - POD Targets' inline='true' name='federated.extractcsql01' version='18.1'>
      <!-- .hyper EXTRACT over a Custom SQL query. The extract is the PRIMARY
           <connection>; its relation is the [Extract].[Extract] placeholder
           (no columns child). The live connection + the Custom SQL that defines
           the real schema are NESTED. connRelations(conn)[0] would pick the
           placeholder and emit a 0-column [Extract].[Extract] warehouse-table
           (the reported extract-over-Custom-SQL bug); pickRootRelation must
           prefer the type='text' Custom SQL relation instead. Targets
           TJ.PUBLIC.SUPERSTORE_ORDERS for portability (same table as
           single_custom_sql). -->
      <connection class='hyper' dbname='C:/Temp/funnel.hyper' schema='Extract' tablename='Extract'>
        <relation name='Extract' table='[Extract].[Extract]' type='table' />
        <named-connections>
          <named-connection caption='CSA Snowflake' name='snowflake.csatj01'>
            <connection authentication='Username Password' class='snowflake' dbname='TJ' schema='PUBLIC' server='csa.snowflakecomputing.com' warehouse='WH' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.csatj01' name='Custom SQL Query' type='text'>SELECT ORDER_ID, SEGMENT, SALES, PROFIT FROM TJ.PUBLIC.SUPERSTORE_ORDERS</relation>
        <metadata-records>
          <metadata-record class='column'><remote-name>ORDER_ID</remote-name><local-name>[ORDER_ID]</local-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>SEGMENT</remote-name><local-name>[SEGMENT]</local-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>SALES</remote-name><local-name>[SALES]</local-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>PROFIT</remote-name><local-name>[PROFIT]</local-name><local-type>real</local-type></metadata-record>
        </metadata-records>
      </connection>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='POD Targets Vs Actual'>
      <table><view><datasources><datasource caption='Funnel Creation - POD Targets' name='federated.extractcsql01'/></datasources></view></table>
    </worksheet>
  </worksheets>
</workbook>

          ]
        }
      },
      {
        "name": "Customer Key",
        "logicalColumnSource": {
          "physicalMappings": [
            { "physicalExpression": { "text": "\"CSA\".\"TJ\".\"ORDER_FACT\".\"CUSTOMER_KEY\"" } }
          ]
        }
      },
      {
        "name": "Gross Revenue",
        "aggregation": { "rule": "SUM" },
        "logicalColumnSource": {
          "physicalMappings": [
            { "physicalExpression": { "text": "\"CSA\".\"TJ\".\"ORDER_FACT\".\"GROSS_REVENUE\"" } }
          ]
        }
      },
      {
        "name": "Segmented Revenue",
        "logicalColumnSource": {
          "logicalExpression": {
            "text": "CASE WHEN \"Customer Dim\".\"Customer Segment\" = 'Enterprise' THEN \"Order Fact\".\"Gross Revenue\" * 1.1 ELSE \"Order Fact\".\"Gross Revenue\" END"
          }
        }
      }
    ],
    "joins": [

      <column datatype='string' name='[ROLE_SP]' role='dimension' type='nominal' />
      <column caption='Vendors OB Staffing' datatype='real' name='[Regional Staffing (copy)_2310065177616936960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Regional Staffing QoQ' datatype='real' hidden='true' name='[Regional Staffing YoY (copy)_148126253410705444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;/&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Vendors OB Staffing YoY' datatype='real' name='[Regional Staffing YoY (copy)_6915347642908274752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;/&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Role Goals' datatype='string' name='[Role (copy)_6915347642917625947]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ROLE]' />
      </column>
      <column datatype='string' hidden='true' name='[Role (group) 1]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[ROLE]' new-bin='true'>
          <bin default-name='false' value='&quot;Inbound Vendor&quot;'>
            <value>&quot;Inbound VND - Regalix&quot;</value>
            <value>&quot;Inbound VND - TaskUs&quot;</value>
            <value>&quot;Inbound VND - Teleperformance&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Outbound Vendor&quot;'>
            <value>&quot;OB Vendors - Regalix&quot;</value>
            <value>&quot;OB Vendors - Teleperformance&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Team by Org' datatype='string' name='[Role (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[ROLE]' new-bin='true'>
          <bin default-name='false' value='&quot;IB Vendor&quot;'>
            <value>&quot;Inbound VND - Regalix&quot;</value>
            <value>&quot;Inbound VND - TaskUs&quot;</value>
            <value>&quot;Inbound VND - Teleperformance&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;IS Regional&quot;'>
            <value>&quot;AE&quot;</value>
            <value>&quot;Blitz (AE)&quot;</value>
            <value>&quot;CAN AE&quot;</value>
            <value>&quot;OB aAE&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;IS Strategic&quot;'>
            <value>&quot;CAN SAE&quot;</value>
            <value>&quot;CAN SAE (Top Mx)&quot;</value>
            <value>&quot;SAE&quot;</value>
            <value>&quot;SAE (Top Mx)&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;OB Vendor&quot;'>
            <value>&quot;OB Vendors - Regalix&quot;</value>
            <value>&quot;OB Vendors - TaskUs&quot;</value>
            <value>&quot;OB Vendors - Teleperformance&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;OS Regional&quot;'>
            <value>&quot;CAN ML&quot;</value>
            <value>&quot;ML&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;OS Strategic&quot;'>
            <value>&quot;CAN SML&quot;</value>
            <value>&quot;SGL&quot;</value>
            <value>&quot;SML&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Role - Top Mx Tracking (copy)' datatype='string' name='[Role - Top Mx Tracking (copy)_6870522710121390126]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ROLE_SP]' />
      </column>
      <column caption='Activations by Team' datatype='string' name='[Role Activations (copy)_2137872874715025422]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_ACTIVATIONS] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;ML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;else [ROLE_ACTIVATIONS]&#10;end' />
      </column>
      <column caption='Inbound Roles filter' datatype='string' name='[Role Goals (copy)_1814950713024585729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if REGEXP_MATCH([ROLE], &apos;Inbound VND&apos;) = true then&#10;[ROLE]&#10;else null end' />
      </column>
      <column caption='ORG ' datatype='string' hidden='true' name='[Role Mx (copy)_5838987343205638149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ORG  (copy)_937100624850956290] in (&apos;OS Strategic&apos; , &apos;OS Regional&apos;) then &apos;Outside&apos;&#10;elseif [ORG  (copy)_937100624850956290] in (&apos;IS Strategic&apos; , &apos;IS Regional&apos;) then &apos;Inside&apos;&#10;ELSEIF [ORG  (copy)_937100624850956290] in (&apos;Outbound Vendor&apos;, &apos;Inbound Vendor&apos;) then &apos;Vendor&apos;&#10;else &apos;Self Serve&apos;&#10;end' />
      </column>
      <column caption='Sales' datatype='real' hidden='true' name='[SALES]' role='measure' type='quantitative' />
      <column caption='Sales Manager' datatype='string' name='[SALES_MANAGER]' role='dimension' type='nominal' />
      <column caption='Sales Owner ' datatype='string' name='[SALES_OWNER (PRESALES_ACTIVE_HC)]' role='dimension' type='nominal' />
      <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
        </aliases>
      </column>
      <column caption='Sales Owner Id' datatype='string' hidden='true' name='[SALES_OWNER_ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[SDR_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='SDR' datatype='string' name='[SDR_OWNER]' role='dimension' type='nominal' />
      <column caption='Commission Rate' datatype='real' name='[SFDC_COMMISSION]' role='measure' type='quantitative' />
      <column caption='SML Staffing - avg per weeks FINAL' datatype='real' hidden='true' name='[SML Staffing (copy)_4591490232390529110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [DAYS_OFF] end)&#10;)&#10;&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [WORKING_DAYS] end)&#10;}&#10;&#10;&#10;&#10;///countd([Week Of (Presales Active Hc)])&#10;&#10;//(([sml HC] * [sml working week days]) - [Days off per week sml])/[sml working week days]' />
      </column>
      <column caption='SP: Whales Goal' datatype='real' hidden='true' name='[SP: Aces Goal (copy)_1538401536447074396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Whales&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='SP: Holdouts Goal' datatype='real' name='[SP: Aces Goal (copy)_1538401536449429600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Holdouts&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='SP: Apex Goal' datatype='real' hidden='true' name='[SP: Holdouts Goal (copy)_1538401536454344806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Apex&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='Top Mx Activations' datatype='integer' name='[SP: Top Mx (copy)_4245346387502661635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [TOP_MX] = true &#10;and isnull([MERCHANT_CLOSE_DATE])=false then [STORE_ID] end)' />
      </column>
      <column caption='Tier Actuals' datatype='integer' name='[SP: Top Mx (copy)_5820832199702355969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#10;&#10;if [MERCHANT_CLOSE_DATE] &lt;= date(&apos;2024-09-30&apos;) &#10;&#9;then  (if [TIER (copy)_4245346387496407042] in (3,4,5)&#10;&#9;&#9;&#9;or [ROLE_SP (Custom SQL Query)] = &apos;Blitz (AE)&apos;&#10;&#9;&#9;&#9;or ([SUBMARKET_ID]&lt;&gt;0 and isnull([TIER (copy)_4245346387496407042]) )&#10;&#9;&#9;&#9; then [STORE_ACCOUNT_ID] end)&#10; &#10; elseif [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2024-10-01&apos;) &#10;&#9; then  (if [TIER (copy)_4245346387496407042] in (4,5)&#10;&#9;&#9;&#9;//or [Role_SP_Copy] = &apos;Blitz (AE)&apos;&#10;&#9;&#9;&#9;&#10;&#9;&#9;&#9; then [STORE_ACCOUNT_ID] end)&#10;end)&#10;&#10;/*&#10;(&#10;    if [TIER] in (&apos;3&apos;,&apos;4&apos;,&apos;5&apos;) OR&#10;        ((str([LEAD_LIST_CUSTOMIZED]) &gt;= &apos;2024-01-01&apos; or str([LEAD_LIST_CUSTOMIZED]) &lt; &apos;2024-04-01&apos;)&#10;            and [TIER] in (&apos;1&apos;, &apos;2&apos;))&#10;    THEN [Account Id]&#10;END&#10;&#10;)&#10;*/' />
      </column>
      <column caption='Market Maker' datatype='integer' name='[SP: Top Mx (copy)_5850457434446196736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [MARKET_MAKER] = True then 1 else 0 END' />
      </column>
      <column caption='Top Mx Activations Goal' datatype='real' name='[SP: Top Mx Goal (copy)_4245346387502661636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query2)] = &apos;Top Mx Activations&apos; then [INITIATIVE_GOAL (Custom SQL Query2)] end)' />
      </column>
      <column caption='Tier Goal' datatype='real' name='[SP: Top Mx Goal (copy)_5820832199702355970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query)] = &apos;T3-5 CW&apos; or  [INITIATIVE (Custom SQL Query)] = &apos;T4-5 CW&apos;&#10;then [INITIATIVE_GOAL (Custom SQL Query)] end)' />
      </column>
      <column caption='SP: Top Mx' datatype='integer' name='[SP: Whales (copy)_3215429439119798272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [TOP_MX] = true then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='SP: Top Mx Goal' datatype='real' name='[SP: Whales Goal (copy)_3215429439120236545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Top Mx&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='SSMO C/W Pacing' datatype='real' hidden='true' name='[SSMO + Inbound C/W Pacing (copy) (copy)_833799264809963525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SSMO + Inbound CW (copy)_833799264809111552]/sum([SSMO + Inbound CW Goal (copy)_833799264809607170])' />
      </column>
      <column caption='Inbound C/W Pacing' datatype='real' hidden='true' name='[SSMO + Inbound C/W Pacing (copy)_833799264809959428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SSMO + Inbound CW (copy)_833799264809201665]/sum([SSMO + Inbound CW Goal (copy) (copy)_833799264809615363])' />
      </column>
      <column caption='YoY Change %: SSMO + Inbound CW' datatype='real' hidden='true' name='[SSMO + Inbound CW (copy)_3548766151981105154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// YoY: Curr QTD SSMO + Inbound CWs&#10;(&#10;(countd(if [YoY Curr QTD (copy)_607845257019625490] then &#10;(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Formstack&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;SSMO&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound Onshore&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self-Serve Integration User&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)&#10;end&#10;))&#10;-&#10;(countd(if [YoY: Prev YR QTD (copy)_607845257020370963] then &#10;(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Formstack&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;SSMO&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound Onshore&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self-Serve Integration User&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)&#10;end&#10;))&#10;)&#10;/&#10;(countd(if [YoY: Prev YR QTD (copy)_607845257020370963] then &#10;(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Formstack&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;SSMO&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound Onshore&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self-Serve Integration User&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)&#10;end&#10;))' />
      </column>
      <column caption='SSMO CW' datatype='integer' hidden='true' name='[SSMO + Inbound CW (copy)_833799264809111552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Formstack&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self-Serve Integration User&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)' />
      </column>

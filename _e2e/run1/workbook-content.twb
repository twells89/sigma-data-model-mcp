    <dashboard name='Vendor Outbound'>
      <repository-location derived-from='https://REDACTED_INTERNAL_HOST/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard/VendorOutbound?rev=' id='VendorOutbound' path='/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard' revision='' site='DoorDash' />
      <style />
      <size maxheight='5500' maxwidth='1500' minheight='5500' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
          <calculation class='tableau' formula='&quot;% of Signs&quot;' />
          <members>
            <member value='&quot;Total Signs&quot;' />
            <member value='&quot;\% of Signs&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
        <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
        </column>
        <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
        </column>
        <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
        </column>
        <column caption='Clean Combined Country (copy)' datatype='string' name='[Clean Combined Country (copy)_1355442808591441921]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='tableau' formula='[Cw Country (copy)_522769460683739155]' />
        </column>
        <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
        <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
        <column caption='Week ' datatype='date' datatype-customized='true' name='[WEEK_OF (PRESALE_WEEKLY_GOALS)]' role='dimension' type='ordinal' />
        <column-instance column='[MERCHANT_CLOSE_DATE]' derivation='Month' name='[mn:MERCHANT_CLOSE_DATE:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Calculation_2500482980966989824]' derivation='None' name='[none:Calculation_2500482980966989824:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_3645452848303554638]' derivation='None' name='[none:Calculation_3645452848303554638:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_4591490232318570497]' derivation='None' name='[none:Calculation_4591490232318570497:nk]' pivot='key' type='nominal' />
        <column-instance column='[Clean Combined Country (copy)_1355442808591441921]' derivation='None' name='[none:Clean Combined Country (copy)_1355442808591441921:nk]' pivot='key' type='nominal' />
        <column-instance column='[INCREMENTAL_SIGN_TAM]' derivation='None' name='[none:INCREMENTAL_SIGN_TAM:qk]' pivot='key' type='quantitative' />
        <column-instance column='[WEEK_OF (PRESALE_WEEKLY_GOALS)]' derivation='None' name='[none:WEEK_OF (PRESALE_WEEKLY_GOALS):ok]' pivot='key' type='ordinal' />

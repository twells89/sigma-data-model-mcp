      <column caption='% SDR Supported' datatype='real' name='[Calculation_1814950712652083200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([SDR_OWNER])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='Ace - Signs by Deck Rank' datatype='real' name='[Calculation_1829939221923893248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Ace&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Ace&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='ace deck rank helper' datatype='string' hidden='true' name='[Calculation_1829939221983617042]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if (([Calculation_1829939221923893248])) &lt; 1 &#10;&#10;then str(round([Calculation_1829939221923893248] * 100, 0)) + &quot;%&quot;&#10;Else str(([Calculation_1829939221923893248]))&#10;End' />
      </column>
      <column caption='Selection Mx' datatype='string' hidden='true' name='[Calculation_1906570804156416000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PRIMARY_CAMPAIGN_SOURCE] = &apos;S&amp;OSelectIntel_07.01.23_TOFU_SBLookalikeTopMxQ32023_ListUpload_Eng&apos; then &apos;Apex&apos;&#10;elseif [PRIMARY_CAMPAIGN_SOURCE] = &apos;Market_Maker_Whale_Mx_Multiplier_SalesS&amp;O&apos; then &apos;Whales&apos;&#10;else &quot;&quot;&#10;end' />
      </column>
      <column caption='SP: Apex' datatype='integer' hidden='true' name='[Calculation_1906570804201074693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [PRIMARY_CAMPAIGN_SOURCE] = &apos;S&amp;OSelectIntel_07.01.23_TOFU_SBLookalikeTopMxQ32023_ListUpload_Eng&apos; then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='SP: Whales' datatype='integer' hidden='true' name='[Calculation_1906570804201144326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [PRIMARY_CAMPAIGN_SOURCE] = &apos;Market_Maker_Whale_Mx_Multiplier_SalesS&amp;O&apos; then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='SP: Aces Actuals' datatype='integer' name='[Calculation_1906570804201603079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [DECK_RANK] = &apos;Ace&apos;&#10;        then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='SP: Aces Goal' datatype='real' name='[Calculation_1906570804203618321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Aces&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='Holdouts Goal' datatype='integer' hidden='true' name='[Calculation_1906570804204171283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='212' />
      </column>
      <column caption='SGL Nav Filter' datatype='string' name='[Calculation_1906570804225806379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 16]' />
      </column>
      <column caption='Activations Pacing' datatype='real' name='[Calculation_2137872874710614022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2319283496593170440]/sum([ACTIVATION_GOAL])' />
      </column>
      <column caption='TAM / Activations' datatype='real' name='[Calculation_2137872874714521612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([INCREMENTAL_SIGN_TAM])/[Calculation_2319283496593170440]' />
      </column>
      <column caption='% of Total Signs' datatype='real' name='[Calculation_2226256020511526912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SP: Whales (copy)_3215429439119798272]/[Calculation_3783938539825639424]' />
      </column>
      <column caption='% of Total Signs (T4-5)' datatype='real' name='[Calculation_2226256020515844097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SP: Top Mx (copy)_5820832199702355969]/[Calculation_3783938539825639424]' />
      </column>
      <column caption='CURR QTD CW' datatype='boolean' hidden='true' name='[Calculation_2307320765860491268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='quarter([MERCHANT_CLOSE_DATE]) = QUARTER(TODAY())' />
      </column>
      <column caption='YoY Curr QTD' datatype='boolean' name='[Calculation_2307320765861478405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//get week nums&#10;datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,today()))&#10;and quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;and year([MERCHANT_CLOSE_DATE]) = year(today())' />
      </column>
      <column caption='TAM temp curr qtd' datatype='real' hidden='true' name='[Calculation_2307320765862567943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//get week nums&#10;if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt;= (datepart(&apos;week&apos;,date(today())))&#10;and quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;then ([INCREMENTAL_SIGN_TAM])&#10;else 0&#10;end' />
      </column>
      <column caption='YoY: Prev YR QTD' datatype='boolean' name='[Calculation_2307320765864128521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*datediff(&apos;quarter&apos;, [Merchant Close Date], TODAY())=4 and [Merchant Close Date]&#10;&lt;= dateadd(&apos;year&apos;,-1,today())*/&#10;datepart(&apos;week&apos;,[MERCHANT_CLOSE_DATE]-1) &lt;= datepart(&apos;week&apos;,today()-1) and&#10;quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;and year([MERCHANT_CLOSE_DATE]) = year(today())-1&#10;and [OPP_TYPE] = &apos;Marketplace&apos;&#10;and [Calculation_6116099428441112578] in (&apos;Inbound VND&apos;, &apos;OS Strategic&apos;, &apos;IS Strategic&apos; , &apos;OS Regional&apos;, &apos;IS Regional&apos;, &apos;Outbound VND&apos;, &apos;SSMO&apos;)' />
      </column>
      <column caption='YoY: Prev Yr QTD TAM' datatype='real' hidden='true' name='[Calculation_2307320765864251402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [YoY: Prev YR QTD (copy)_607845257020370963] then [INCREMENTAL_SIGN_TAM] end)' />
      </column>
      <column caption='YoY: Curr QTD TAM' datatype='real' hidden='true' name='[Calculation_2307320765864763404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [YoY Curr QTD (copy)_607845257019625490] then [INCREMENTAL_SIGN_TAM] end)' />
      </column>
      <column caption='YoY: QTD TAM Change %' datatype='real' hidden='true' name='[Calculation_2307320765864894477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2307320765864763404] - [Calculation_2307320765864251402]) / [Calculation_2307320765864251402]' />
      </column>
      <column caption='Activations - Actuals' datatype='integer' name='[Calculation_2319283496593170440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF ISNULL([MERCHANT_ACTIVATION_DATE]) THEN &#10;        NULL &#10;    ELSE &#10;        [STORE_ID] &#10;    END&#10;)' />
      </column>
      <column caption='Quarter of Mx Goal' datatype='string' hidden='true' name='[Calculation_2319283496595312651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([WEEK_GOAL_MX]))+&quot;-Q&quot;+str(QUARTER([WEEK_GOAL_MX]))' />
      </column>
      <column caption='Mgr Org' datatype='string' hidden='true' name='[Calculation_241012997606731782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;) then &apos;Strategic&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;) then &apos;Regional&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Regalix&apos;,&#10;&apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Regalix&apos;) then &apos;Vendor&apos; &#10; end' />
      </column>
      <column caption='OS v IS Mgr' datatype='string' hidden='true' name='[Calculation_241012997609254922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;AE&apos;, &apos;OB aAE&apos;) then &apos;Inside&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;ML&apos;, &apos;SML&apos;, &apos;SGL&apos;) then &apos;Outside&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Regalix&apos;,&#10;&apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Regalix&apos;) then &apos;Vendor&apos; &#10; end' />
      </column>
      <column caption='testing prodd' datatype='real' hidden='true' name='[Calculation_241012997617070102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [ROLE (PRESALE_PRODUCT_GOALS1)], [PRODUCT (PRESALE_PRODUCT_GOALS1)] :&#10;sum( if [PRODUCT (PRESALE_PRODUCT_GOALS1)] = &apos;DashPass&apos; then [PRODUCT_GOAL (PRESALE_PRODUCT_GOALS1)] else null end)&#10;}' />
      </column>
      <column caption='Attainment Detail Filter' datatype='string' hidden='true' name='[Calculation_241012997636231210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14]' />
      </column>
      <column caption='Mgr Toggle Filter' datatype='string' hidden='true' name='[Calculation_241012997645660204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 15]' />
      </column>
      <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
      </column>
      <column caption='Mgr: DP Pacing' datatype='real' hidden='true' name='[Calculation_265853164554964998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Dashpass % (copy)_241012997629923359]/avg(if [PRODUCT (PRESALE_PRODUCT_GOALS1)] = &apos;DashPass&apos; then [PRODUCT_GOAL (PRESALE_PRODUCT_GOALS1)] else null end)' />
      </column>
      <column caption='Mgr: Ads Pacing' datatype='real' hidden='true' name='[Calculation_265853164555010055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Promos (copy)_170784960784449547]/avg(if [PRODUCT (PRESALE_PRODUCT_GOALS1)] = &apos;Ads&apos; then [PRODUCT_GOAL (PRESALE_PRODUCT_GOALS1)] else null end)' />
      </column>
      <column caption='Mgr: Promos Pacing' datatype='real' hidden='true' name='[Calculation_265853164555063304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_170784960782204935]/avg(if [PRODUCT (PRESALE_PRODUCT_GOALS1)] = &apos;Promos&apos; then [PRODUCT_GOAL (PRESALE_PRODUCT_GOALS1)] else null end)' />
      </column>
      <column caption='Mgr: Signs Pacing' datatype='real' hidden='true' name='[Calculation_265853164555116553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783938539825639424]/sum([CW_GOAL])' />
      </column>
      <column caption='Quarter of Mgr Goal' datatype='datetime' hidden='true' name='[Calculation_265853164618371093]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, [WEEK])' />
      </column>
      <column caption='color placeholder' datatype='integer' hidden='true' name='[Calculation_265853164619989014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Deck Rank Param Calc' datatype='real' name='[Calculation_272115961656373248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 10]&#10;when &quot;Total Signs&quot; then [Calculation_3783938539825639424]&#10;when &quot;% of Signs&quot; then [Calculation_3783938539825639424]/window_sum([Calculation_3783938539825639424])&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Deck Rank Prop by Date' datatype='real' name='[Calculation_272115961657233409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[Signs - Actuals]/(sum({fixed [Merchant Close Date]: [Signs - Actuals]}))&#10;&#10;&#10;//[Signs - Actuals]/&#10;//sum ({fixed [Deck Rank], [Merchant Close Date]: ([Signs - Actuals])})&#10;&#10;&#10;//[Signs - Actuals]/&#10;//([Signs - Actuals] + lookup([Signs - Actuals],-1))&#10;&#10;if [Parameters].[Parameter 10] = &quot;% of Signs&quot; then&#10;[Calculation_3783938539825639424]/&#10;sum ({exclude [DECK_RANK]: ([Calculation_3783938539825639424])})&#10;ELSEIF [Parameters].[Parameter 10] = &quot;Total Signs&quot; then&#10;0&#10;end' />
      </column>
      <column caption='&gt;1 Deck Rank Param Calc' datatype='real' name='[Calculation_272115961664032773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_272115961656373248] = 0 then 0&#10;elseif [Calculation_272115961656373248] &gt; 1 then&#10;[Calculation_272115961656373248]&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='OS v IS' datatype='string' name='[Calculation_272115961694973986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Cw Owner Role Official Title (group)]&#10;when &apos;IS Regional&apos; then &apos;Inside&apos;&#10;when &apos;OS Regional&apos; then &apos;Outside&apos;&#10;when &apos;IS Strategic&apos; then &apos;Inside&apos;&#10;when &apos;OS Strategic&apos; then &apos;Outside&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;else &apos;Inside&apos;&#10;end' />
      </column>
      <column caption='Menu Rejection' datatype='real' hidden='true' name='[Calculation_2744451451374333953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [MENU_REJECTION] = 1 then [STORE_ACCOUNT_ID] end)/&#10;COUNTD([STORE_ACCOUNT_ID])' />
      </column>
      <column caption='Activation_Week' datatype='date' name='[Calculation_2788220767980802053]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [MERCHANT_ACTIVATION_DATE] = date(&apos;2024-09-30&apos;) then date(dateadd(&apos;day&apos;, -7, datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)))&#10;elseif date(datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)) = date(&apos;2024-09-30&apos;) then date( datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;tuesday&apos;))&#10;else date(datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)) end' />
      </column>
      <column caption='WO Number' datatype='string' name='[Calculation_2837338173342060544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[WORK_ORDER_NUMBER]' />
      </column>
      <column caption='Has SDR' datatype='boolean' name='[Calculation_3146749521975640072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([SDR_ID]) then False &#10;&#9;else True&#10;    end' />
      </column>
      <column caption='Quarter of Activations' datatype='string' name='[Calculation_3146749531872968718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(YEAR([WEEK_GOAL_ACTIVATIONS]))+&quot;-Q&quot;+str(QUARTER([WEEK_GOAL_ACTIVATIONS]))' />
      </column>
      <column caption='All Teams' datatype='string' hidden='true' name='[Calculation_3215429439157272580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Total Org&apos;' />
      </column>
      <column caption='Max Date' datatype='string' name='[Calculation_3251035995590299649]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Includes all CWs before: &quot; + str( Max([MERCHANT_CLOSE_DATE]))' />
      </column>
      <column caption='Quarter Lookup' datatype='string' hidden='true' name='[Calculation_3347863437983137797]' role='measure' type='nominal'>
        <calculation class='tableau' formula='lookup(attr(&#10;&#10;str(year([MERCHANT_CLOSE_DATE]))+&quot;-Q&quot;+str(QUARTER([MERCHANT_CLOSE_DATE]))&#10;&#10;&#10;&#10;),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='QoQ Mx Health Actuals Toggle Calc Filter' datatype='real' hidden='true' name='[Calculation_3347863438047195146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5838987343198711810]) - LOOKUP(ZN([Calculation_5838987343198711810]), -1)) / ABS(LOOKUP(ZN([Calculation_5838987343198711810]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='real' hidden='true' name='[Calculation_335729289228140544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in&#10;(&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;,&#10;&apos;OB Vendors - Concentrix&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Calculation3' datatype='real' hidden='true' name='[Calculation_335729289228255233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in&#10;(&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;, &apos;OB Vendors - Concentrix&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Tam excl SSMO' datatype='real' hidden='true' name='[Calculation_346847549964255232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Formstack&apos; then 0&#10;when &apos;Self-Serve Integration User&apos;  then 0&#10;when &apos;Self Serve&apos; then 0&#10;else [INCREMENTAL_SIGN_TAM]&#10;end' />
      </column>
      <column caption='Outbound C/W' datatype='integer' hidden='true' name='[Calculation_346847549965332482]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Inbound VND - Regalix&apos; then null&#10;when &apos;Inbound VND - Teleperformance&apos; then null&#10;when &apos;Inbound VND - TaskUs&apos; then null&#10;when &apos;Self Serve&apos; then null&#10;when &apos;Self-Serve Integration User&apos; then null&#10;else [STORE_ACCOUNT_ID]&#10;end&#10;)' />
      </column>
      <column caption='Outbound Vendors Signs' datatype='integer' hidden='true' name='[Calculation_346847549966721028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;OB Vendors - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;OB Vendors - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;OB Vendors - Concentrix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;OB Vendors - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)' />
      </column>
      <column caption='Inbound Signs' datatype='integer' hidden='true' name='[Calculation_346847549967892487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(&#10;case [OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Inbound VND - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)' />
      </column>
      <column caption='Inbound AHC' datatype='real' hidden='true' name='[Calculation_346847549968379913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [OWNER_ROLE_OFFICIAL_TITLE]&#10;WHEN 0 THEN 0&#10;ELSE ((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))/avg([WORKING_DAYS])&#10;END' />
      </column>
      <column caption='SSMO + Inbound CW' datatype='integer' hidden='true' name='[Calculation_346847549969924109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Formstack&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;SSMO&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Inbound VND - TaskUs&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self Serve&apos; then [STORE_ACCOUNT_ID]&#10;when &apos;Self-Serve Integration User&apos; then [STORE_ACCOUNT_ID]&#10;else null&#10;end&#10;)' />
      </column>
      <column caption='Outbound Onshore Signs' datatype='integer' hidden='true' name='[Calculation_346847549970493454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_346847549965332482] - [Calculation_346847549966721028]' />
      </column>
      <column caption='Inbound vs Outbound' datatype='string' name='[Calculation_346847549971795983]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [ROLE]&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Inbound&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Inbound&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Inbound&apos;&#10;else &apos;Outbound&apos;&#10;end' />
      </column>
      <column caption='Vendor v Onshore' datatype='string' name='[Calculation_346847549973364752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [ROLE]&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor&apos;&#10;WHEN &apos;OB Vendors - TaskUs&apos; THEN &apos;Vendor&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor&apos;&#10;else &apos;Onshore&apos;&#10;end' />
      </column>
      <column caption='Max QTD' datatype='integer' hidden='true' name='[Calculation_346847549980479509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[WEEK_OF (Custom SQL Query3)] - TODAY()' />
      </column>
      <column caption='QTD Select Week Filter' datatype='real' hidden='true' name='[Calculation_3548766151975219200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([QTD Select Week]) &lt;= (date(today())) and quarter([QTD Select Week]) = QUARTER(today())&#10;&#10;if [MERCHANT_CLOSE_DATE] &lt;= [Parameters].[Parameter 4] and [QTR_YR] = [Parameters].[Parameter 5]&#10;then [CLOSES]&#10;end' />
      </column>
      <column caption='YoY Commission Rate' datatype='real' hidden='true' name='[Calculation_3548766151985459208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((if [YoY Curr QTD (copy)_607845257019625490] then [SFDC_COMMISSION]&#10;end)&#10;-&#10;(if [YoY: Prev YR QTD (copy)_607845257020370963] then [SFDC_COMMISSION]&#10;end))&#10;/ &#10;(if [YoY: Prev YR QTD (copy)_607845257020370963] then [SFDC_COMMISSION]&#10;end)' />
      </column>
      <column caption='W/W % Pacing Change: Signs' datatype='real' name='[Calculation_3645452848249196560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(running_sum(COUNTD(if [WEEK_OF] &lt;=  dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;=  dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; then [CLOSES] end)) //last week goal&#10;)&#10;-&#10;(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;=  dateadd(&apos;day&apos;, 2, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [CLOSES] end)) //last week goal&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
      </column>
      <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
      </column>
      <column caption='Signs Pacing' datatype='real' name='[Calculation_3783938539829059585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3783938539825639424])/round(SUM([CLOSES]),0)' />
      </column>
      <column caption='Conditional Color' datatype='integer' hidden='true' name='[Calculation_3783938539830513666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Calculation_3783938539825639424])/SUM([CLOSES]) &lt; 1 THEN 0 &#10;ELSEIF ([Calculation_3783938539825639424])/SUM([CLOSES]) &gt;= 1 then 1&#10;END' />
      </column>
      <column caption='NARR Pacing' datatype='real' hidden='true' name='[Calculation_3783938539831132163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NARR])/SUM([NARR (PRESALE_WEEKLY_GOALS)])' />
      </column>
      <column caption='Active HC - Actuals' datatype='integer' datatype-customized='true' name='[Calculation_3783938539836088324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))/avg([WORKING_DAYS]))' />
      </column>
      <column caption='Days Worked' datatype='real' hidden='true' name='[Calculation_3783938539839033349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))' />
      </column>
      <column caption='Active HC Pacing' datatype='real' name='[Calculation_3783938539841773579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3783938539836088324])/SUM([AHC_GOAL])' />
      </column>
      <column caption='Dashpass Attachment' datatype='real' name='[Calculation_3783938539842052109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([IS_DASHPASS])/([Calculation_3783938539825639424])' />
      </column>
      <column caption='Pickup Attachment' datatype='real' name='[Calculation_3783938539854696462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([IS_PICKUP])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='Alcohol Attachment' datatype='real' name='[Calculation_3783938539854921743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([IS_ALCOHOL])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='Storefront Attachment' datatype='real' name='[Calculation_3783938539855089680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([IS_STOREFRONT])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='CWs / AHC' datatype='real' name='[Calculation_3783938539858427923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3783938539825639424])/([Calculation_3783938539836088324])' />
      </column>
      <column caption='TAM / CW' datatype='real' name='[Calculation_3783938539858702356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([INCREMENTAL_SIGN_TAM])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='Outside v Inside Filter' datatype='string' hidden='true' name='[Calculation_3783938539867480085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [OWNER_ROLE_OFFICIAL_TITLE] &#10;when &apos;ML&apos; then &apos;Outside&apos;&#10;when &apos;SML&apos; then &apos;Outside&apos;&#10;when &apos;SGL&apos; then &apos;Outside&apos;&#10;when &apos;Self Serve&apos; then &apos;Self Serve&apos;&#10;else &apos;Inside&apos; end' />
      </column>
      <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
      </column>
      <column caption='Mx Health Sheet Toggle' datatype='string' hidden='true' name='[Calculation_4057039640394534912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 19]' />
      </column>
      <column caption='Team - Tier Activations Tracking' datatype='string' name='[Calculation_4245346387489398784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;,&apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
      </column>
      <column caption='Top Mx Activations Pacing' datatype='real' name='[Calculation_4245346387502854149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([SP: Top Mx (copy)_4245346387502661635]/[SP: Top Mx Goal (copy)_4245346387502661636])' />
      </column>
      <column caption='QTD Signs Goal' datatype='real' hidden='true' name='[Calculation_4334925757743652864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// datediff(&apos;quarter&apos;,[Week Of],today())=0 and &#10;&#10;sum(if datediff(&apos;quarter&apos;,date(&apos;2023-02-20&apos;),today())=0 and date(&apos;2023-02-20&apos;)&lt;today() then [CLOSES] end)' />
      </column>
      <column caption='Curr QTD Goal' datatype='boolean' hidden='true' name='[Calculation_4334925757746180098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//([Week ]) &lt;= (date(today())) and quarter([Week ]) = QUARTER(today())&#10;&#10;([WEEK_OF (Custom SQL Query3)]) &lt; datetrunc(&apos;week&apos;,(date(today()))) and quarter([WEEK_OF (Custom SQL Query3)]) = QUARTER(today())&#10;and year([WEEK_OF (Custom SQL Query3)]) = year(today())' />
      </column>
      <column caption='TAM Goal' datatype='integer' hidden='true' name='[Calculation_4334925757747978243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='TAM (excl. SSMO) Goal' datatype='integer' hidden='true' name='[Calculation_4334925757749915652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='TAM / Rep Goal' datatype='integer' hidden='true' name='[Calculation_4334925757750370309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='SSMO + Inbound CW Goal' datatype='real' hidden='true' name='[Calculation_4362439938066046977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [ROLE]&#10;when &apos;Formstack&apos; then [CLOSES]&#10;when &apos;SSMO&apos; then [CLOSES]&#10;when &apos;Inbound VND - Regalix&apos; then [CLOSES]&#10;when &apos;Inbound VND - Teleperformance&apos; then [CLOSES]&#10;when &apos;Inbound VND - TaskUs&apos; then [CLOSES]&#10;when &apos;Self Serve&apos; then [CLOSES]&#10;else 0 end' />
      </column>
      <column caption='Holdouts (table)' datatype='real' name='[Calculation_4387350494069833729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [IS_HOLDOUT] = 1&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [IS_HOLDOUT] = 1&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
      </column>
      <column caption='BIS Toggle Calc' datatype='real' hidden='true' name='[Calculation_4470104127754018850]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then&#10;    (&#10;        (sum(if [Last Week - Goals (copy)_5843842750859100188] then ([HC]) end) * &#10;        AVG(if [Last Week - Goals (copy)_5843842750859100188] then ([WORKING_DAYS]) end))&#10;        - sum(if [Last Week - Goals (copy)_5843842750859100188] then ([DAYS_OFF]) end)&#10;        )&#10;    / AVG(if [Last Week - Goals (copy)_5843842750859100188] then ([WORKING_DAYS]) end)&#10;&#10;&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;&#10;(&#10;    (&#10;        (sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([HC]) end) * &#10;        AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end))&#10;        - sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([DAYS_OFF]) end)&#10;        )&#10;    / AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end)&#10;&#10;) /&#10;&#10;COUNTD(if [YoY Curr QTD (copy)_4470104127756128291] then [WEEK_OF (PRESALES_ACTIVE_HC)] end)&#10;&#10;end&#10;&#10;&#10;//(((sum([HC]) * avg([Working Days]))-sum([Days Off]))/avg([Working Days])/COUNTD([Week ]))' />
      </column>
      <column caption='CWs / BIS Toggle' datatype='real' hidden='true' name='[Calculation_4470104127785881682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then&#10;[Signs Toggle Calc (copy)_4470104127771701294] / ([Calculation_4470104127754018850])&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then &#10;([Signs Toggle Calc (copy)_4470104127771701294] / ([Calculation_4470104127754018850]))&#10;/&#10;COUNTD(if [YoY Curr QTD (copy)_4470104127756128291] then&#10;([WEEK_OF (PRESALES_ACTIVE_HC)])&#10;end&#10;)&#10;end' />
      </column>
      <column caption='CWs / BIS Goal Toggle' datatype='real' hidden='true' name='[Calculation_4470104127789301852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Signs Goal Toggle Calc (copy)_4470104127787495511]/[BIS Toggle Calc (copy)_4470104127759069220]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Signs QTD Avg' datatype='real' hidden='true' name='[Calculation_4470104127790481502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then&#10;countd(if [Calculation_2307320765861478405] then [STORE_ACCOUNT_ID] end)&#10;/countd(if [Calculation_2307320765861478405] then [WEEK_OF] end)&#10;&#10;else if[Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;0 end&#10;end' />
      </column>
      <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
      </column>
      <column caption='Strategic v Regional v Vendor' datatype='string' name='[Calculation_4591490232365199376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
      </column>
      <column caption='TAM trailing 2 week' datatype='real' hidden='true' name='[Calculation_4591490232369053737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if&#10;datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; ((datepart(&apos;week&apos;,date(today()))) - 2)&#10;then [INCREMENTAL_SIGN_TAM] end)' />
      </column>
      <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
      </column>
      <column caption='Strategic Staffing' datatype='real' name='[Calculation_4591490232373194802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Days off per week sml' datatype='real' hidden='true' name='[Calculation_4591490232381157443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(&#10;{ fixed [WEEK_OF (Custom SQL Query3)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: sum(&#10;if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then &#10;[DAYS_OFF] end)}&#10;)' />
      </column>
      <column caption='sml HC' datatype='real' hidden='true' name='[Calculation_4591490232383811660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]&#10;: &#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then &#10;([HC])&#10;end)&#10;})' />
      </column>
      <column caption='sml working week days' datatype='real' hidden='true' name='[Calculation_4591490232385704017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(&#10;{ fixed [WEEK_OF (Custom SQL Query3)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] : avg(&#10;if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then&#10;[WORKING_DAYS] end)}&#10;&#10;)' />
      </column>
      <column caption='CAN Inside Roles' datatype='string' name='[Calculation_467107770447921153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE] = &apos;CAN AE&apos; then &apos;Include CAN AE&apos;&#10;elseif [ROLE] = &apos;CAN SAE&apos; then &apos;Include CAN SAE&apos; &#10;elseif [ROLE] = &apos;CAN SAE (Top Mx)&apos; then &apos;Include CAN SAE (Top Mx)&apos; &#10;end' />
      </column>
      <column caption='testing YoY signs' datatype='integer' hidden='true' name='[Calculation_467178137805877256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_2307320765864128521] = true then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='New YoY Prev' datatype='string' hidden='true' name='[Calculation_467178137809276940]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*datediff(&apos;quarter&apos;, [Merchant Close Date], TODAY())=4 and [Merchant Close Date]&#10;&lt;= dateadd(&apos;year&apos;,-1,today())*/&#10;&#10;if quarter([Parameters].[Parameter 12]) = quarter(today()) and&#10;year([Parameters].[Parameter 12]) = year(TODAY())&#10;then &#10;&#10;(&#10;//quarter([Merchant Close Date]) = QUARTER(today())&#10;//and year([Merchant Close Date]) = year(TODAY())-1&#10;&#10;str(YEAR([MERCHANT_CLOSE_DATE]))+&quot;-Q&quot;+str(QUARTER([MERCHANT_CLOSE_DATE]))&#10;&#10;)&#10;&#10;ELSE&#10;//quarter([Merchant Close Date])  = (quarter([Quarter of CW Param])) and&#10;//year([Merchant Close Date]) = year([Quarter of CW Param]) - 1&#10;&#10;str(YEAR([Parameters].[Parameter 12])-1)+&quot;-Q&quot;+str(QUARTER([Parameters].[Parameter 12]))&#10;&#10;end' />
      </column>
      <column caption='Commission Rate Goal' datatype='real' hidden='true' name='[Calculation_4738279400721563651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.23' />
      </column>
      <column caption='Outbound Onshore C/W Pacing' datatype='real' hidden='true' name='[Calculation_4738279400722051076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_346847549970493454]) / sum([Outbound Onshore Signs (copy)_4738279400720318466])' />
      </column>
      <column caption='SSMO + Inbound C/W Pacing' datatype='real' hidden='true' name='[Calculation_4738279400722710533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_346847549969924109]/sum([Calculation_4362439938066046977])' />
      </column>
      <column caption='Outbound C/W Pacing' datatype='real' hidden='true' name='[Calculation_4738279400722989062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_346847549965332482]/sum([Outbound Signs (copy)_4738279400720318464])' />
      </column>
      <column caption='Outbound Vendors C/W Pacing' datatype='real' hidden='true' name='[Calculation_4738279400723197959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_346847549966721028]/sum([Outbound Vendors Signs (copy)_4738279400720318465])' />
      </column>
      <column caption='Commission Rate Pacing' datatype='real' hidden='true' name='[Calculation_4738279400723750920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SFDC_COMMISSION]/[Calculation_4738279400721563651]' />
      </column>
      <column caption='BIS Pacing' datatype='real' hidden='true' name='[Calculation_4738279400725159945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active HC - Actuals (copy)_4334925757750915082]/[BIS (copy)_4334925757753368588]' />
      </column>
      <column caption='AHC Pacing (SMB Weekly)' datatype='real' name='[Calculation_4738279400726130703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783938539858427923]&#10;/&#10;avg([CLOSES] / [AHC_GOAL]&#10;)' />
      </column>
      <column caption='CURR QTR' datatype='boolean' hidden='true' name='[Calculation_4738279401101676560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='quarter([WEEK_OF (Custom SQL Query3)]) = QUARTER(TODAY())' />
      </column>
      <column caption='Calculation8' datatype='real' hidden='true' name='[Calculation_5107293117939163156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [PRODUCT] = &apos;Ads &amp; Promos&apos; and [ROLE (PRESALE_PRODUCT_GOALS)] in&#10;(&apos;SML&apos;, &apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;) then [Calculation_170784960780750853] end' />
      </column>
      <column caption='color band' datatype='integer' hidden='true' name='[Calculation_5172313847114264583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if index() &lt; 5 then 1&#10;ELSEIF index() &lt; 11 then 2&#10;else 3&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Level Dim' datatype='string' hidden='true' name='[Calculation_522769459944423427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN 1 THEN [Calculation_3783938539867480085]&#10;WHEN 2 THEN [ROLE]&#10;WHEN 3 THEN [MANAGER_NAME]&#10;WHEN 4 THEN [STORE_ACCOUNT_ID]&#10;&#10;END' />
      </column>
      <column caption='Add Input' datatype='string' hidden='true' name='[Calculation_522769459944816644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] &lt; 4&#10;THEN [Parameters].[Parameter 2] + &quot;,&quot; + [Calculation_522769459944423427]&#10;ELSE [Parameters].[Parameter 2]&#10;END' />
      </column>
      <column caption='Input Filter' datatype='boolean' hidden='true' name='[Calculation_522769459944955909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN 1 THEN TRUE&#10;WHEN 2 THEN SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 2) = [MANAGER_NAME]&#10;WHEN 3 THEN SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 2) = [MANAGER_NAME] AND SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 3) = [ROLE]&#10;WHEN 4 THEN SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 2) = [MANAGER_NAME] AND SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 3) = [ROLE]&#10;            AND SPLIT([Parameters].[Parameter 2], &apos;,&apos;, 4) =  [STORE_ACCOUNT_ID]&#10;&#10;END' />
      </column>
      <column caption='Previous Level Display' datatype='string' hidden='true' name='[Calculation_522769459945250822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;when 1 then &apos;All&apos;&#10;when 2 then [Calculation_3783938539867480085]&#10;when 3 then [Calculation_3783938539867480085]+&quot;&#10;  ∟&quot;+[ROLE]+&quot; &quot;&#10;when 4 then [MANAGER_NAME]+&quot;&#10;  ∟&quot;+[ROLE]+&quot;&#10;    ∟&quot;+ [STORE_ACCOUNT_ID]+&quot; &quot;&#10;&#10;END' />
      </column>
      <column caption='Level Down' datatype='integer' hidden='true' name='[Calculation_522769459945676807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 4&#10;THEN [Parameters].[Parameter 1]&#10;ELSE [Parameters].[Parameter 1] + 1&#10;END' />
      </column>
      <column caption='Level Up' datatype='integer' hidden='true' name='[Calculation_522769459948277768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1&#10;THEN 1&#10;ELSE [Parameters].[Parameter 1] -1&#10;END' />
      </column>
      <column caption='Previous Level Input' datatype='string' hidden='true' name='[Calculation_522769459948388361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Parameters].[Parameter 2],FINDNTH([Parameters].[Parameter 2],&apos;,&apos;,[Parameters].[Parameter 1]-1)-1)' />
      </column>
      <column caption='Level Up Label' datatype='string' hidden='true' name='[Calculation_522769459948511242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 2 THEN &quot;Role&quot;&#10;WHEN 3 THEN &quot;Manager&quot;&#10;WHEN 4 THEN &quot;Account Id&quot;&#10;END' />
      </column>
      <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
      </column>
      <column caption='Limit Rows' datatype='boolean' hidden='true' name='[Calculation_522769460694503447]' role='measure' type='nominal'>
        <calculation class='tableau' formula='index()&lt;=10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='TAM / HC' datatype='real' name='[Calculation_522769460714700825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([INCREMENTAL_SIGN_TAM])/sum([HC])' />
      </column>
      <column caption='Holdout Signs' datatype='integer' name='[Calculation_5359283586570813441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [IS_HOLDOUT] = 1 then [STORE_ACCOUNT_ID] else null end)' />
      </column>
      <column caption='Pickup %' datatype='real' hidden='true' name='[Calculation_5509731953887649823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783938539854696462]' />
      </column>
      <column caption='Dashpass %' datatype='real' hidden='true' name='[Calculation_5509731953887932448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783938539842052109]' />
      </column>
      <column caption='Color Attach' datatype='integer' hidden='true' name='[Calculation_5509731953900884003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([Calculation_170784960789442581]) / [Calculation_3783938539825639424] &gt;= avg([Calculation_170784961148108848])&#10;then 1 else 0 end' />
      </column>
      <column caption='Show/Hide' datatype='string' name='[Calculation_573927491580395521]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If INDEX()&lt;=200&#10;then &apos;Show&apos;&#10;else &apos;Hide&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='previous tam' datatype='real' name='[Calculation_573927491581394946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='lookup(sum([INCREMENTAL_SIGN_TAM]),-52)'>
          <table-calc ordering-field='[federated.1d44dls1qne6m411a222e1j5w12c].[MERCHANT_CLOSE_DATE]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Lookup Date' datatype='integer' name='[Calculation_573927491585601539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='lookup(attr([Lookup Merchant Close Date]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='lookup filter' datatype='string' name='[Calculation_573927491585724420]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_573927491585601539] = year(TODAY()) &#10;and [Lookup Date (copy)_2117114051411013634]  = year(TODAY()) &#10;then &apos;Show&apos; else &apos;Hide&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Canada roles' datatype='string' name='[Calculation_5837439233833500672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([CW_COUNTRY])+([ROLE])' />
      </column>
      <column caption='% On Time' datatype='real' hidden='true' name='[Calculation_5838987343197241344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2319283496593170440]/countd([STORE_ID (PRESALES_CW_ACTIVATIONS)])' />
      </column>
      <column caption='On Time Pacing' datatype='real' hidden='true' name='[Calculation_5838987343199453187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5838987343197241344] / avg([Calculation_2319283496591097857])' />
      </column>
      <column caption='Signs Toggle Calc' datatype='integer' hidden='true' name='[Calculation_5843842750778290177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then [Calculation_3783938539825639424]&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then running_sum([Calculation_3783938539825639424])&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Signs Goal Pacing Toggle' datatype='real' hidden='true' name='[Calculation_5843842750781722627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Signs Toggle Calc (copy)_5843842750789283852]) / sum([Signs Goal Toggle Calc (copy)_5843842750851801110])' />
      </column>
      <column caption='Strategic v Regional (Current Role Title)' datatype='string' name='[Calculation_6116099428441112578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#10;(&#10;IFNULL(&#10;        (case&#10;        [OWNER_ROLE_OFFICIAL_TITLE]&#10;        when &quot;ML&quot; then &quot;OS Regional&quot;&#10;        when &quot;SML&quot; then &quot;OS Strategic&quot;&#10;        when &quot;GML&quot; then &quot;OS Regional&quot;&#10;        when &quot;aGML&quot; then &quot;OS Regional&quot;&#10;        when &quot;SGL&quot; then &quot;OS Strategic&quot;&#10;        When &quot;AE&quot; then &quot;IS Regional&quot;&#10;        when &quot;Blitz (AE)&quot; then &quot;IS Regional&quot;&#10;        when &quot;OB aAE&quot; then &quot;IS Regional&quot;&#10;        when &quot;SAE&quot; then &quot;IS Strategic&quot;&#10;        when &quot;SAE (Top Mx)&quot; then &quot;IS Strategic&quot;&#10;        when &quot;Self Serve&quot; then &quot;SSMO&quot;&#10;        when &quot;Formstack&quot; then &quot;SSMO&quot;&#10;        when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;        when &quot;OB Vendors - Regalix&quot; then &quot;Outbound VND&quot;&#10;&#9;&#9;when &quot;OB Vendors - MarketStar&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - Movate&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - Teleperformance&quot; then &quot;Outbound VND&quot;&#10;       when &quot;OB Vendors - Concentrix&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - TaskUs&quot; then &quot;Outbound VND&quot;&#10;        when &quot;Inbound VND - Regalix&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Inbound VND - Teleperformance&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Inbound VND - TaskUs&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Concentrix&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Team Lead- Outside Sales&quot; then &quot;OS Regional&quot;&#10;        end)&#10;    , [CW_OWNER_ROLE_OFFICIAL_TITLE])&#10;)&#10;when &quot;ML&quot; then &quot;OS Regional&quot;&#10;when &quot;SML&quot; then &quot;OS Strategic&quot;&#10;when &quot;SGL&quot; then &quot;OS Strategic&quot;&#10;when &quot;GML&quot; then &quot;OS Regional&quot;&#10;when &quot;aGML&quot; then &quot;OS Regional&quot;&#10;When &quot;AE&quot; then &quot;IS Regional&quot;&#10;When &quot;Blitz (AE)&quot; then &quot;IS Regional&quot;&#10;when &quot;OB aAE&quot; then &quot;IS Regional&quot;&#10;when &quot;SAE&quot; then &quot;IS Strategic&quot;&#10;when &quot;SAE (Top Mx)&quot; then &quot;IS Strategic&quot;&#10;when &quot;Self Serve&quot; then &quot;SSMO&quot;&#10;when &quot;Formstack&quot; then &quot;SSMO&quot;&#10;when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;when &quot;OB Vendors - Regalix&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Teleperformance&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - TaskUs&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - MarketStar&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Movate&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Concentrix&quot; then &quot;Outbound VND&quot;&#10;when &quot;Inbound VND - Regalix&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Teleperformance&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - TaskUs&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Concentrix&quot; then &quot;Inbound VND&quot;&#10;when &quot;OS Regional&quot; then &quot;OS Regional&quot;&#10;when &quot;IS Regional&quot; then &quot;IS Regional&quot;&#10;when &quot;OS Strategic&quot; then &quot;OS Strategic&quot;&#10;when &quot;IS Strategic&quot; then &quot;IS Strategic&quot;&#10;when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;when &quot;Inbound VND&quot; then &quot;Inbound VND&quot;&#10;when &quot;Outbound VND&quot; then &quot;Outbound VND&quot;&#10;end' />
      </column>
      <column caption='Activation Goal (via param)' datatype='real' name='[Calculation_6190408836544167938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 22]  = &apos;All&apos; or &#10;[COUNTRY (Custom SQL Query4)] = [Parameters].[Parameter 22] &#10;    THEN [ACTIVATION_GOAL] &#10;    ELSE 0&#10;END' />
      </column>
      <column caption='Special Project: Aces Goal' datatype='real' hidden='true' name='[Calculation_6405244619892813827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Aces&apos; then [INITIATIVE_GOAL] end)' />
      </column>
      <column caption='Product Attach Prop by Date' datatype='real' hidden='true' name='[Calculation_6423821945584472167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_170784960789442581])/sum({fixed [MERCHANT_CLOSE_DATE]: sum([Calculation_170784960789442581])})' />
      </column>
      <column caption='Sort By Field' datatype='real' hidden='true' name='[Calculation_6461117419658522629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 21]&#10;    when &apos;QoQ % Change&apos; then (ZN([Calculation_5838987343198711810]) - LOOKUP(ZN([Calculation_5838987343198711810]), -1)) / ABS(LOOKUP(ZN([Calculation_5838987343198711810]), -1))&#10;    when &apos;Actuals&apos; then [Calculation_5838987343198711810]&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Activations excl last 2 weeks' datatype='boolean' hidden='true' name='[Calculation_6461117419709931533]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&apos;week&apos;,([START_DT])) &lt; (datepart(&apos;week&apos;,date(today())) - 14&#10;&#10;) = true then true end' />
      </column>
      <column caption='Strategic Staffing - Goals' datatype='real' name='[Calculation_649925764156874755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Regional Staffing -  Goals' datatype='real' name='[Calculation_649925764158148612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Vendors OB Staffing - Goals' datatype='real' name='[Calculation_649925764158341126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in&#10;(&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;, &apos;OB Vendors - Concentrix&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Vendor IB Staffing - Goals' datatype='real' name='[Calculation_649925764158705671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Concentrix&apos;) then [AHC_GOAL] end)})' />
      </column>
      <column caption='Strategic Signs - Goals' datatype='real' name='[Calculation_649925764159447048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;SML&apos;, &apos;SGL&apos;,&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;Strategic Inbound&apos;) then [CLOSES] end)' />
      </column>
      <column caption='Regional Signs - Goals' datatype='real' name='[Calculation_649925764159578121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;ML&apos;,&apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [CLOSES] end)' />
      </column>
      <column caption='Vendor OB Signs - Goals' datatype='real' name='[Calculation_649925764159709194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;OB Vendors - Teleperformance&apos;,&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;, &apos;OB Vendors - Movate&apos;) then [CLOSES] end)' />
      </column>
      <column caption='Vendor IB Signs - Goals' datatype='real' name='[Calculation_649925764159963147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;Inbound VND - TaskUs&apos;,&apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Concentrix&apos;) then [CLOSES] end)' />
      </column>
      <column caption='SSMO Signs - Goals' datatype='real' name='[Calculation_649925764160098316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ROLE] = &apos;Self Serve&apos; then [CLOSES] end)' />
      </column>
      <column caption='Strategic Signs Pacing' datatype='real' name='[Calculation_649925764160872462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Strategic&apos; then [STORE_ACCOUNT_ID] end)/round([Calculation_649925764159447048],0)' />
      </column>
      <column caption='Regional Signs Pacing' datatype='real' name='[Calculation_649925764161249295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Regional&apos; then [STORE_ACCOUNT_ID] end)/round([Calculation_649925764159578121],0)' />
      </column>
      <column caption='Vendor OB Signs Pacing' datatype='real' name='[Calculation_649925764161466384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor OB&apos; then [STORE_ACCOUNT_ID] end)/[Calculation_649925764159709194]' />
      </column>
      <column caption='Vendor IB Signs Pacing' datatype='real' name='[Calculation_649925764161867793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor IB&apos; then [STORE_ACCOUNT_ID] end)/[Calculation_649925764159963147]' />
      </column>
      <column caption='SSMO Signs Pacing' datatype='real' name='[Calculation_649925764162174994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;SSMO&apos; then [STORE_ACCOUNT_ID] end)/[Calculation_649925764160098316]' />
      </column>
      <column caption='Strategic Staffing Pacing' datatype='real' name='[Calculation_649925764162400275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4591490232373194802]/[Calculation_649925764156874755]' />
      </column>
      <column caption='Regional Staffing Pacing' datatype='real' name='[Calculation_649925764162674708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Strategic Staffing (copy)_4591490232394051671]/[Calculation_649925764158148612]' />
      </column>
      <column caption='Vendor OB Staffing Pacing' datatype='real' name='[Calculation_649925764162871317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Regional Staffing (copy)_2310065177616936960]/[Calculation_649925764158341126]' />
      </column>

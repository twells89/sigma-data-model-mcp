        </calculation>
      </column>
      <column caption='Product Attach Goals Toggle' datatype='real' hidden='true' name='[Calculation_170784961148108848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;when &quot;Ads&quot; then (if [PRODUCT] = &apos;Ads&apos; then [Calculation_170784960780750853] else null end)&#10;when &quot;Promos&quot; then (if [PRODUCT] = &apos;Promos&apos; then [Calculation_170784960780750853] else null end)&#10;when &quot;Ads &amp; Promos&quot; then (if [PRODUCT] = &apos;Ads &amp; Promos&apos; then [Calculation_170784960780750853] else null end)&#10;when &quot;PickUp&quot; then (if [PRODUCT] = &apos;PickUp&apos; then [Calculation_170784960780750853] else null end)&#10;when &quot;DashPass&quot; then (if [PRODUCT] = &apos;DashPass&apos; then [Calculation_170784960780750853] else null end)&#10;when &quot;Storefront Attach&quot; then (if [PRODUCT] = &apos;Storefront Attach&apos; then [IS_STOREFRONT] else null end)&#10;end' />
      </column>
      <column caption='Opp URL' datatype='string' name='[Calculation_170784961179340851]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MERCHANT_CLOSE_DATE] &lt; DATE(2024-10-28) THEN&#10;&quot;https://figment.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;ELSE &quot;https://doordashmx.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;END' />
      </column>
      <column caption='Week_start' datatype='datetime' name='[Calculation_1755629835042418713]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [MERCHANT_CLOSE_DATE] &gt;= DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE])  &#10;             AND [MERCHANT_CLOSE_DATE] &lt; datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;, 1, DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE]))) &#10;        THEN DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE]) &#10;        ELSE DATETRUNC(&apos;week&apos;, [MERCHANT_CLOSE_DATE]) END' />
      </column>
      <column caption='Org - Top Mx Tracking' datatype='string' name='[Calculation_1755629837070975002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Team - Tier Tracking (copy)_4245346387490271233] in (&apos;Strategic&apos;, &apos;Regional&apos;, &apos;BD&apos;, &apos;OB Vendor&apos;) then &apos;Outbound Signs&apos; &#10;else &apos;Inbound + SSMO Signs&apos;&#10;end' />
      </column>
      <column caption='Org - Tier Tracking' datatype='string' name='[Calculation_1755629837072850971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_4245346387489398784] in (&apos;Strategic&apos;, &apos;Regional&apos;, &apos;OB Vendor&apos;) then &apos;Outbound Signs&apos; &#10;else &apos;Inbound + SSMO Signs&apos; &#10;end' />
      </column>
      <column caption='Commission Above 25%' datatype='real' hidden='true' name='[Calculation_181340297466654720]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='countd(if [SFDC_COMMISSION] &gt;= 0.25&#10;then [STORE_ACCOUNT_ID] end)&#10;/ [Calculation_3783938539825639424]' />
      </column>
      <column caption='Commission Pacing' datatype='real' hidden='true' name='[Calculation_181340297467199489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_181340297466654720]/avg([GOAL])' />

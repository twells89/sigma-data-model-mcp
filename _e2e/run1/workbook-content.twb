    <worksheet name='Total Org _Activations'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Org - Activations&#10;</run>
            <run fontsize='10'>Activations are counted as: Store IDs with an Activation Date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
              <calculation class='tableau' formula='&quot;% of Signs&quot;' />
            </column>
            <column caption='Activations Country' datatype='string' name='[Parameter 22]' param-domain-type='list' role='measure' type='nominal' value='&quot;United States&quot;'>
              <calculation class='tableau' formula='&quot;United States&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Activation Goal' datatype='real' name='[ACTIVATION_GOAL]' role='measure' type='quantitative' />
            <column caption='King - Activations by Deck Rank' datatype='real' name='[Ace - Activations by Deck Rank (copy)_2137872874710343685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;King&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;King&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Ace - Activations by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy)_2137872874709295108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Ace&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Ace&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='COUNTRY Activations' datatype='string' name='[COUNTRY (Custom SQL Query4)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Activations Pacing' datatype='real' name='[Calculation_2137872874710614022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2319283496593170440]/sum([ACTIVATION_GOAL])' />
            </column>
            <column caption='TAM / Activations' datatype='real' name='[Calculation_2137872874714521612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([INCREMENTAL_SIGN_TAM])/[Calculation_2319283496593170440]' />
            </column>
            <column caption='Activations - Actuals' datatype='integer' name='[Calculation_2319283496593170440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF ISNULL([MERCHANT_ACTIVATION_DATE]) THEN &#10;        NULL &#10;    ELSE &#10;        [STORE_ID] &#10;    END&#10;)' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='Activation Goal (via param)' datatype='real' name='[Calculation_6190408836544167938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 22]  = &apos;All&apos; or &#10;[COUNTRY (Custom SQL Query4)] = [Parameters].[Parameter 22] &#10;    THEN [ACTIVATION_GOAL] &#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Clean Combined Country - Activations' datatype='string' name='[Clean Combined Country (copy 2)_7030541291992502274]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Combined Country (copy)_7030541291992104961]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Combined Country - Activations' datatype='string' name='[Combined Country (copy)_7030541291992104961]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY (Custom SQL Query4)],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
            <column caption='Exclude this Week - Activations' datatype='boolean' name='[Exclude this Week (copy)_1819595047244206080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([MERCHANT_ACTIVATION_DATE])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Joker - Activations by Deck Rank' datatype='real' name='[Jack - Activations by Deck Rank (copy)_2137872874711425033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Joker&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Joker&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Unranked - Activations by Deck Rank' datatype='real' name='[Jack - Activations by Deck Rank (copy)_2137872874711531530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF isnull([DECK_RANK])&#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE])) &#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF isnull([DECK_RANK])&#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Queen - Activations by Deck Rank' datatype='real' name='[King - Activations by Deck Rank (copy)_2137872874711126023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Queen&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Queen&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Jack - Activations by Deck Rank' datatype='real' name='[King - Activations by Deck Rank (copy)_2137872874711298056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Jack&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Jack&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Activation Date' datatype='date' name='[MERCHANT_ACTIVATION_DATE]' role='dimension' type='ordinal' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='QTD (last full week) - Activations' datatype='boolean' name='[QTD (last full week) (copy)_1819595047244267521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Exclude this Week (copy)_1819595047244206080] = True then True&#10;end' />

              <relation name='ACTIVATIONS_GOALS_PRESALES (REDACTED_DB.ACTIVATIONS_GOALS_PRESALES)_A7411E97F2BA4C63B646C21748EF2F85' table='[Extract].[ACTIVATIONS_GOALS_PRESALES (REDACTED_DB.ACTIVATIONS_GOALS_PRESALES)_A7411E97F2BA4C63B646C21748EF2F85]' type='table' />

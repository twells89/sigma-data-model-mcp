    <worksheet name='Deck Rank by Team'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Signs broken down by Deck Rank, QoQ</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='9'>Green</run>
            <run fontalignment='1' fontsize='9'> is a net </run>
            <run bold='true' fontalignment='1' fontsize='9'>increase</run>
            <run fontalignment='1' fontsize='9'> from one quarter to the next, i.e. we&apos;re selling more into this deck rank</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#fd6a08' fontsize='9'>Orange/Red</run>
            <run fontalignment='1' fontsize='9'> is a net </run>
            <run bold='true' fontalignment='1' fontsize='9'>decrease</run>
            <run fontalignment='1' fontsize='9'> from one quarter to the next, i.e. we&apos;re selling less into this deck rank</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#666666' fontsize='9'>Grey</run>
            <run fontalignment='1' fontsize='9'> is no material change from one quarter to the next</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
              <calculation class='tableau' formula='&quot;% of Signs&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='&lt;1 Deck Rank Param Calc' datatype='real' name='[&gt;1 Deck Rank Param Calc (copy)_272115961664331782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_272115961656373248] = 0 then 0&#10;elseif [Calculation_272115961656373248] &lt; 1 then&#10;[Calculation_272115961656373248]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Deck Rank Param Calc' datatype='real' name='[Calculation_272115961656373248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 10]&#10;when &quot;Total Signs&quot; then [Calculation_3783938539825639424]&#10;when &quot;% of Signs&quot; then [Calculation_3783938539825639424]/window_sum([Calculation_3783938539825639424])&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Deck Rank Prop by Date' datatype='real' name='[Calculation_272115961657233409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Signs - Actuals]/(sum({fixed [Merchant Close Date]: [Signs - Actuals]}))&#10;&#10;&#10;//[Signs - Actuals]/&#10;//sum ({fixed [Deck Rank], [Merchant Close Date]: ([Signs - Actuals])})&#10;&#10;&#10;//[Signs - Actuals]/&#10;//([Signs - Actuals] + lookup([Signs - Actuals],-1))&#10;&#10;if [Parameters].[Parameter 10] = &quot;% of Signs&quot; then&#10;[Calculation_3783938539825639424]/&#10;sum ({exclude [DECK_RANK]: ([Calculation_3783938539825639424])})&#10;ELSEIF [Parameters].[Parameter 10] = &quot;Total Signs&quot; then&#10;0&#10;end' />
            </column>
            <column caption='&gt;1 Deck Rank Param Calc' datatype='real' name='[Calculation_272115961664032773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_272115961656373248] = 0 then 0&#10;elseif [Calculation_272115961656373248] &gt; 1 then&#10;[Calculation_272115961656373248]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OS v IS' datatype='string' name='[Calculation_272115961694973986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Cw Owner Role Official Title (group)]&#10;when &apos;IS Regional&apos; then &apos;Inside&apos;&#10;when &apos;OS Regional&apos; then &apos;Outside&apos;&#10;when &apos;IS Strategic&apos; then &apos;Inside&apos;&#10;when &apos;OS Strategic&apos; then &apos;Outside&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;else &apos;Inside&apos;&#10;end' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Regional v Strategic v OS v IS' datatype='string' name='[Cw Owner Role Official Title (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CW_OWNER_ROLE_OFFICIAL_TITLE]' new-bin='true'>
                <bin default-name='false' value='&quot;IS Regional&quot;'>
                  <value>&quot;AE&quot;</value>
                  <value>&quot;AE Manager&quot;</value>
                  <value>&quot;OB aAE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IS Strategic&quot;'>
                  <value>&quot;SAE&quot;</value>
                  <value>&quot;SAE (Top Mx)&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Inbound VND&quot;'>
                  <value>&quot;Inbound VND - Concentrix&quot;</value>
                  <value>&quot;Inbound VND - Regalix&quot;</value>
                  <value>&quot;Inbound VND - TaskUs&quot;</value>
                  <value>&quot;Inbound VND - Teleperformance&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Misc (Intl, NVx, etc. -- don&apos;t use)&quot;'>
                  <value>&quot;AUS AE&quot;</value>
                  <value>&quot;Account Executive&quot;</value>
                  <value>&quot;Account Executive - In Training&quot;</value>

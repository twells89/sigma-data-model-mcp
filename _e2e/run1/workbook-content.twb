            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Vendor OB&apos; and [...' datatype='integer' name='[Calculation_7654993470864814092]' role='measure' type='quantitative' user:unnamed='Prev QTD'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor OB&apos; and [Calculation_2307320765864128521] = TRUE&#10; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Vendor IB&apos; and [...' datatype='integer' name='[Calculation_7654993470864916493]' role='measure' type='quantitative' user:unnamed='Prev QTD'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor IB&apos; and [Calculation_2307320765864128521] = TRUE&#10; then [STORE_ACCOUNT_ID] end)' />

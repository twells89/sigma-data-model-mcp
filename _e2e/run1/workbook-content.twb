    <worksheet name='CW View'>
      <layout-options>
        <title>
          <formatted-text>
            <run>CW Detail&#10;</run>
            <run bold='true' fontcolor='#e15759' fontsize='8' italic='true'>If you are missing CWs due to the sales roster, please reach out to the Data Infrastructure team (Bhanuprakash Nallabothula) directly. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Account Name' datatype='string' name='[ACCOUNT_NAME]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Opp URL' datatype='string' name='[Calculation_170784961179340851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [MERCHANT_CLOSE_DATE] &lt; DATE(2024-10-28) THEN&#10;&quot;https://figment.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;ELSE &quot;https://doordashmx.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;END' />
            </column>
            <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
            </column>
            <column caption='WO Number' datatype='string' name='[Calculation_2837338173342060544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[WORK_ORDER_NUMBER]' />
            </column>
            <column caption='Has SDR' datatype='boolean' name='[Calculation_3146749521975640072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([SDR_ID]) then False &#10;&#9;else True&#10;    end' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Show/Hide' datatype='string' name='[Calculation_573927491580395521]' role='measure' type='nominal'>
              <calculation class='tableau' formula='If INDEX()&lt;=200&#10;then &apos;Show&apos;&#10;else &apos;Hide&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Top Mx' datatype='integer' name='[Calculation_6622965475636920323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [TOP_MX] = True then 1 else 0 END' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>

    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Activations'>
      <repository-location derived-from='https://REDACTED_INTERNAL_HOST/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard/Activations?rev=' id='Activations' path='/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard' revision='' site='DoorDash' />
      <style />
      <size maxheight='3000' maxwidth='1400' minheight='3000' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
          <calculation class='tableau' formula='&quot;% of Signs&quot;' />
          <members>
            <member value='&quot;Total Signs&quot;' />
            <member value='&quot;\% of Signs&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
        <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
        <column caption='Clean Combined Country - Activations' datatype='string' name='[Clean Combined Country (copy 2)_7030541291992502274]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Combined Country (copy)_7030541291992104961]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
        </column>
        <column caption='Activation Date' datatype='date' name='[MERCHANT_ACTIVATION_DATE]' role='dimension' type='ordinal' />
        <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
        <column caption='QTD (last full week) - Activations' datatype='boolean' name='[QTD (last full week) (copy)_1819595047244267521]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Exclude this Week (copy)_1819595047244206080] = True then True&#10;end' />
        </column>
        <column caption='Team - Top Mx Activations Tracking' datatype='string' name='[ROLE_SP (Custom SQL Query1) (copy)_6190549589468631045]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query2)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query2)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query2)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
        </column>
        <column caption='T4-5 Activations by Team' datatype='string' name='[ROLE_SP (Custom SQL Query2) (copy)_6190549589466468355]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query2)] in (&apos;AE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;OB aAE&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;Inbound VND&apos;) then &apos;IB Vendors&apos;&#10;end' />
        </column>
        <column datatype='string' name='[ROLE_SP (Custom SQL Query2)]' role='dimension' type='nominal' />
        <column caption='Activations by Team' datatype='string' name='[Role Activations (copy)_2137872874715025422]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [ROLE_ACTIVATIONS] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;ML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;else [ROLE_ACTIVATIONS]&#10;end' />
        </column>
        <column caption='Week Goal Activations' datatype='date' name='[WEEK_GOAL_ACTIVATIONS]' role='dimension' type='ordinal' />
        <column datatype='date' name='[WEEK_GOAL_SP (Custom SQL Query2)]' role='dimension' type='ordinal' />

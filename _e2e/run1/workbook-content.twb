    <worksheet name='SMB Weekly Goals '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Æ </run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontsize='9'>QTD Goal</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Active HC - Goal' datatype='real' name='[AHC_GOAL]' role='measure' type='quantitative' />
            <column caption='Signs - Goal' datatype='real' datatype-customized='true' name='[CLOSES]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='avg({ fixed [Week] :sum(if [Role] in (&apos;ML&apos;, &apos;AE&apos;, &apos;Blitz (AE)...' datatype='real' name='[Calculation_1204290694312296478]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;ML&apos;, &apos;AE&apos;, &apos;Blitz (AE)&apos;, &apos;OB aAE&apos;, &apos;GML&apos;) then [AHC_GOAL] end)})' />
            </column>
            <column caption='avg({ fixed [Week] :sum(if [Role] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top...' datatype='real' name='[Calculation_1447274005187424258]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [AHC_GOAL] end)})' />
            </column>
            <column caption='SUM(if [Role] in (&apos;Inbound VND - TaskUs&apos;,&apos;Inbound VND - Regal...' datatype='real' name='[Calculation_1902419044328439810]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;Inbound VND - TaskUs&apos;,&apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Concentrix&apos;) then [CLOSES] end)' />
            </column>
            <column caption='avg({ fixed [Week] :sum(if [Role] in (&apos;Inbound VND - TaskUs&apos;,...' datatype='real' name='[Calculation_1902419044332216338]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in (&apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Concentrix&apos;) then [AHC_GOAL] end)})' />
            </column>
            <column caption='SP: Aces Goal' datatype='real' name='[Calculation_1906570804203618321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Aces&apos; then [INITIATIVE_GOAL] end)' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2310065177622220813]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED (2)'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='avg({ fixed [Week] :sum(if [Role] in (&apos;OB Vendors - Regalix&apos;,...' datatype='real' name='[Calculation_335729289228361730]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;&#10;:sum(if [ROLE] in&#10;(&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;, &apos;OB Vendors - Concentrix&apos;) then [AHC_GOAL] end)})' />
            </column>
            <column caption='SUM(if [Role] in (&apos;SML&apos;, &apos;SGL&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;Strat...' datatype='real' name='[Calculation_3604850030281306129]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;SML&apos;, &apos;SGL&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;Strategic Inbound&apos;) then [CLOSES] end)' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='SUM(if [Role] = &apos;Self Serve&apos; then [Signs - Goal] end)' datatype='real' name='[Calculation_607845257007996932]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED Goals'>
              <calculation class='tableau' formula='SUM(if [ROLE] = &apos;Self Serve&apos; then [CLOSES] end)' />
            </column>
            <column caption='SUM(if [Role] in (&apos;ML&apos;,&apos;AE&apos;, &apos;Blitz (AE)&apos;, &apos;GML&apos;, &apos;aGML&apos;) the...' datatype='real' name='[Calculation_7030541292011065348]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;ML&apos;,&apos;AE&apos;, &apos;Blitz (AE)&apos;, &apos;GML&apos;, &apos;aGML&apos;) then [CLOSES] end)' />
            </column>
            <column caption='SUM(if [Role] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Movate...' datatype='real' name='[Calculation_7030541292011474949]' role='measure' type='quantitative' user:unnamed='SMB Weekly Goals '>
              <calculation class='tableau' formula='SUM(if [ROLE] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Movate&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - MarketStar&apos;) then [CLOSES] end)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Initiative' datatype='string' name='[INITIATIVE]' role='dimension' type='nominal' />
            <column caption='Initiative Goal' datatype='real' name='[INITIATIVE_GOAL]' role='measure' type='quantitative' />
            <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
            </column>
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='Week' datatype='date' datatype-customized='true' name='[WEEK_OF (Custom SQL Query3)]' role='dimension' type='ordinal' />
            <column-instance column='[COUNTRY]' derivation='None' name='[none:COUNTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[CW_COUNTRY]' derivation='None' name='[none:CW_COUNTRY:nk]' pivot='key' type='nominal' />

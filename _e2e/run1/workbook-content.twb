    <worksheet name='TAM YoY'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>TAM</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#2a507e' fontsize='8'>CY</run>
            <run fontalignment='1' fontsize='8'> vs </run>
            <run bold='true' fontalignment='1' fontcolor='#898989' fontsize='8'>PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='previous tam' datatype='real' name='[Calculation_573927491581394946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='lookup(sum([INCREMENTAL_SIGN_TAM]),-52)'>
                <table-calc ordering-field='[federated.1d44dls1qne6m411a222e1j5w12c].[MERCHANT_CLOSE_DATE]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Lookup Date' datatype='integer' name='[Calculation_573927491585601539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='lookup(attr([Lookup Merchant Close Date]),0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='lookup filter' datatype='string' name='[Calculation_573927491585724420]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_573927491585601539] = year(TODAY()) &#10;and [Lookup Date (copy)_2117114051411013634]  = year(TODAY()) &#10;then &apos;Show&apos; else &apos;Hide&apos; end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Lookup Date (copy)' datatype='integer' name='[Lookup Date (copy)_2117114051411013634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='lookup(attr([Lookup Merchant Close Date]),0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[Lookup Merchant Close Date]' role='dimension' type='ordinal' user:agg-type='Year' user:base-field='MERCHANT_CLOSE_DATE' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [MERCHANT_CLOSE_DATE])' scope-isolation='false' />
            </column>
            <column caption='Activation Date' datatype='date' name='[MERCHANT_ACTIVATION_DATE]' role='dimension' type='ordinal' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
            </column>
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='CY TAM' datatype='real' name='[TAM (copy)_6340434971064840193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[INCREMENTAL_SIGN_TAM]' />
            </column>
            <column datatype='string' name='[US Historical Roles]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CW_OWNER_ROLE_OFFICIAL_TITLE]' new-bin='true'>
                <bin default-name='false' value='&quot;Historical Roles&quot;'>
                  <value>&quot;AE&quot;</value>
                  <value>&quot;AE Manager&quot;</value>
                  <value>&quot;Account Executive&quot;</value>
                  <value>&quot;Account Executive - In Training&quot;</value>
                  <value>&quot;Account Executive - Teleperformance&quot;</value>

          <relation connection='snowflake.1qfs4rw0zwf2c514yh1kh1wda6mp' name='Custom SQL Query4' type='text'>SELECT *
FROM REDACTED_DB.static.activations_goals_presales &quot;ACTIVATIONS_GOALS_PRESALES&quot;</relation>
          <relation connection='snowflake.1qfs4rw0zwf2c514yh1kh1wda6mp' name='Custom SQL Query7' type='text'>with final as (
select 
    case 
        when rep_segment = &apos;CAN SMB Sales&apos; then &apos;Canada&apos; 
        when rep_segment not in (&apos;AUS SMB Sales&apos;,&apos;CAN SMB Sales&apos;,&apos;NZ SMB Sales&apos;,&apos;ANZ SMB Sales&apos;) then &apos;United States&apos; 
        else null 
    end as country, 
    days_off,
    days_worked/iff(working_days=0,null,working_days) as hc,
    role_title as OWNER_ROLE_OFFICIAL_TITLE,
    &apos;Q&apos;||quarter(to_date(week)) as qtr,
        year(to_date(week)) as yr,
        qtr||&apos;-&apos;||right(yr,2) as qtr_yr,
    null as rep_rank,
    null as SALES_MANAGER,
    rep_name as sales_owner,
    ddmx_id as user_id,
    week as week_of
from REDACTED_DB.public.sales_analytics_bis
where country is not null
)
SELECT &quot;PRESALES_ACTIVE_HC&quot;.&quot;COUNTRY&quot; AS &quot;COUNTRY (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;DAYS_OFF&quot; AS &quot;DAYS_OFF&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;HC&quot; AS &quot;HC&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;OWNER_ROLE_OFFICIAL_TITLE&quot; AS &quot;OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;QTR&quot; AS &quot;QTR (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;QTR_YR&quot; AS &quot;QTR_YR (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;REP_RANK&quot; AS &quot;REP_RANK&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;SALES_MANAGER&quot; AS &quot;SALES_MANAGER&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;SALES_OWNER&quot; AS &quot;SALES_OWNER (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;USER_ID&quot; AS &quot;USER_ID&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;WEEK_OF&quot; AS &quot;WEEK_OF (PRESALES_ACTIVE_HC)&quot;,
  &quot;PRESALES_ACTIVE_HC&quot;.&quot;YR&quot; AS &quot;YR (PRESALES_ACTIVE_HC)&quot;
FROM final &quot;PRESALES_ACTIVE_HC&quot;</relation>
          <relation connection='snowflake.1qfs4rw0zwf2c514yh1kh1wda6mp' name='Custom SQL Query6' type='text'>SELECT &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;BASED&quot; AS &quot;BASED&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;ORG&quot; AS &quot;ORG&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;PRODUCT&quot; AS &quot;PRODUCT&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;PRODUCT_GOAL&quot; AS &quot;PRODUCT_GOAL&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;QTR_YR_PG&quot; AS &quot;QTR_YR_PG&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;ROLE&quot; AS &quot;ROLE (PRESALE_PRODUCT_GOALS)&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;TARGET&quot; AS &quot;TARGET&quot;,
  &quot;PRESALE_PRODUCT_GOALS&quot;.&quot;TEAM&quot; AS &quot;TEAM&quot;,
  (CASE WHEN (NOT (CAST(TO_TIMESTAMP(&quot;PRESALE_PRODUCT_GOALS&quot;.&quot;WEEK_GOAL&quot;, &apos;MM/DD/YYYY&apos;) AS DATE) IS NULL)) THEN CAST(TO_TIMESTAMP(&quot;PRESALE_PRODUCT_GOALS&quot;.&quot;WEEK_GOAL&quot;, &apos;MM/DD/YYYY&apos;) AS DATE) WHEN (NOT (TRY_CAST(&quot;PRESALE_PRODUCT_GOALS&quot;.&quot;WEEK_GOAL&quot; AS DATE) IS NULL)) THEN TRY_CAST(&quot;PRESALE_PRODUCT_GOALS&quot;.&quot;WEEK_GOAL&quot; AS DATE) ELSE NULL END) AS &quot;WEEK_GOAL&quot;
FROM &quot;STATIC&quot;.&quot;PRESALE_PRODUCT_GOALS&quot; &quot;PRESALE_PRODUCT_GOALS&quot;</relation>

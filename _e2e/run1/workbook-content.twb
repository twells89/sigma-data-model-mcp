            <column caption='Org - Top Mx Tracking' datatype='string' name='[Calculation_1755629837070975002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Team - Tier Tracking (copy)_4245346387490271233] in (&apos;Strategic&apos;, &apos;Regional&apos;, &apos;BD&apos;, &apos;OB Vendor&apos;) then &apos;Outbound Signs&apos; &#10;else &apos;Inbound + SSMO Signs&apos;&#10;end' />
            </column>
            <column caption='% of Total Signs' datatype='real' name='[Calculation_2226256020511526912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SP: Whales (copy)_3215429439119798272]/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='ZN([SP: Top Mx]/[SP: Top Mx Goal])' datatype='real' name='[Calculation_4653625801678729218]' role='measure' type='quantitative' user:unnamed='Selection: Top Mx CW'>
              <calculation class='tableau' formula='ZN([SP: Whales (copy)_3215429439119798272]/[SP: Whales Goal (copy)_3215429439120236545])' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Initiative' datatype='string' name='[INITIATIVE]' role='dimension' type='nominal' />
            <column caption='Initiative Goal' datatype='real' name='[INITIATIVE_GOAL]' role='measure' type='quantitative' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='QTD (last full week) - Top Mx' datatype='boolean' name='[QTD (last full week) (copy)_138767215421173763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
            </column>
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='Role - Top Mx Tracking' datatype='string' name='[ROLE_SP (copy 2)_8364240089214603296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ROLE_SP]' />
            </column>
            <column caption='ROLE_SP (copy)' datatype='string' name='[ROLE_SP (copy)_7013793520488321024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ROLE_SP]' />
            </column>
            <column datatype='string' name='[ROLE_SP]' role='dimension' type='nominal' />
            <column caption='Role - Top Mx Tracking (copy)' datatype='string' name='[Role - Top Mx Tracking (copy)_6870522710121390126]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ROLE_SP]' />
            </column>
            <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
              </aliases>
            </column>
            <column caption='SP: Top Mx' datatype='integer' name='[SP: Whales (copy)_3215429439119798272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [TOP_MX] = true then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='SP: Top Mx Goal' datatype='real' name='[SP: Whales Goal (copy)_3215429439120236545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [INITIATIVE] = &apos;Top Mx&apos; then [INITIATIVE_GOAL] end)' />
            </column>
            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column caption='Team' datatype='string' name='[TEAM]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[TOP_MX]' role='dimension' type='nominal' />
            <column caption='Team - Top Mx Tracking' datatype='string' name='[Team - Tier Tracking (copy)_4245346387490271233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_SP] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;ELSEIF [ROLE_SP] = &apos;BD&apos; then &apos;BD&apos;&#10;else [ROLE_SP]&#10;end' />
            </column>
            <column caption='Week Goal Sp' datatype='date' name='[WEEK_GOAL_SP]' role='dimension' type='ordinal' />

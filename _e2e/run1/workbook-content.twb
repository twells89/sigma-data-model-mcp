        <calculation class='tableau' formula='[% Ads &amp; Promos (copy)_1275714984654942208]/avg(if [PRODUCT] = &apos;Ads &amp; Promos&apos; and&#10;[ROLE (PRESALE_PRODUCT_GOALS)] in&#10;(&apos;SML&apos;, &apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;)&#10;then [Calculation_170784960780750853] else null end)' />

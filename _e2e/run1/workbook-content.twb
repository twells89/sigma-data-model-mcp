      <aliases enabled='yes' />
      <column caption='% Ads &amp; Promos (excl Vendor)' datatype='real' hidden='true' name='[% Ads &amp; Promos (copy)_1275714984654942208]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='countd(IF [IS_ADS_PROMOS] = 1 then&#10;(case [ROLE (PRESALE_PRODUCT_GOALS)] when  in (&apos;SML&apos;, &apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;)&#10;    then [STORE_ACCOUNT_ID] end)&#10;else null end)&#10;&#10;&#10;/&#10;countd(case [ROLE (PRESALE_PRODUCT_GOALS)] when  in (&apos;SML&apos;, &apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;)&#10;    then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='% Ads' datatype='real' hidden='true' name='[% Promos (copy)_170784960784449547]' role='measure' type='ordinal'>

    <dashboard name='CW Deep Dive'>
      <repository-location derived-from='https://REDACTED_INTERNAL_HOST/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard/CWDeepDive?rev=' id='CWDeepDive' path='/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard' revision='' site='DoorDash' />
      <style />
      <size maxheight='3000' maxwidth='1500' minheight='3000' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
      </datasources>
      <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
        <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
        <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
        </column>
        <column caption='WO Number' datatype='string' name='[Calculation_2837338173342060544]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[WORK_ORDER_NUMBER]' />
        </column>
        <column caption='Has SDR' datatype='boolean' name='[Calculation_3146749521975640072]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([SDR_ID]) then False &#10;&#9;else True&#10;    end' />
        </column>
        <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
        </column>
        <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
        </column>
        <column caption='Manager Name' datatype='string' name='[MANAGER_NAME]' role='dimension' type='nominal' />
        <column caption='Opportunity Id' datatype='string' name='[OPPORTUNITY_ID]' role='dimension' type='nominal' />
        <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
          </aliases>
        </column>
        <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='INT([TIER])' />
          <aliases>
            <alias key='%null%' value='No Tier' />
          </aliases>
        </column>
        <column datatype='boolean' name='[TOP_MX]' role='dimension' type='nominal' />
        <column caption='Week Of CW' datatype='date' name='[WEEK_OF]' role='dimension' type='ordinal' />
        <column caption='WO ID' datatype='string' name='[WORK_ORDER_ID]' role='dimension' type='nominal' />

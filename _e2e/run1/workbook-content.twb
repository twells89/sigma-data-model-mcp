      <column caption='Tiers 2 Calc' datatype='real' name='[Medal Rank: Tin Calc (copy)_1252141487245320205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and REGEXP_MATCH([Calculation_1252141487240110082], &apos;TIER 2&apos;)&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and REGEXP_MATCH([Calculation_1252141487240110082], &apos;TIER 2&apos;)&#10;then [STORE_ACCOUNT_ID] end)&#10;end)&#10;&#10;//CAN_Q3.23_TIER 1_P0' />
      </column>
      <column datatype='real' hidden='true' name='[NARR (PRESALE_WEEKLY_GOALS)]' role='measure' type='quantitative' />
      <column datatype='real' name='[NARR]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[NEVER_TRIED_ANY_DELIVERY]' role='measure' type='quantitative' />
      <column caption='Non Partner' datatype='boolean' hidden='true' name='[NON_PARTNER]' role='dimension' type='nominal' />
      <column caption='Ntam' datatype='real' name='[NTAM]' role='measure' type='quantitative' />
      <column caption='OB VND Promo Goal' datatype='real' hidden='true' name='[OB VND Ads Goal (copy)_6957850336412844045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [WEEK_OF] &lt; date(&apos;2023-05-01&apos;) then 0 else 0.05&#10;end' />
      </column>
      <column caption='Vendors IB Staffing' datatype='real' name='[OB Vendors Staffing (copy)_2310065177617342465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Ob Op' datatype='string' hidden='true' name='[OB_OP]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Only On One Comp' datatype='integer' hidden='true' name='[ONLY_ON_ONE_COMP]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='On Any Comp' datatype='integer' hidden='true' name='[ON_ANY_COMP]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='On Current Qtr Ll' datatype='integer' hidden='true' name='[ON_CURRENT_QTR_LL]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[ON_GRUB]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='On Pm' datatype='integer' hidden='true' name='[ON_PM]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[ON_UE]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='On Ue Or Pm' datatype='integer' hidden='true' name='[ON_UE_OR_PM]' role='dimension' type='ordinal' />
      <column caption='Opportunity Id' datatype='string' name='[OPPORTUNITY_ID]' role='dimension' type='nominal' />
      <column caption='Opp Id' datatype='string' hidden='true' name='[OPP_ID]' role='dimension' type='nominal' />
      <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
      </column>
      <column caption='Orders' datatype='integer' hidden='true' name='[ORDERS]' role='measure' type='quantitative' />
      <column caption='Team ' datatype='string' hidden='true' name='[ORG  (copy)_937100624850956290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_MX] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;) then &apos;IS Strategic&apos;&#10;elseif [ROLE_MX] in (&apos;SML&apos;, &apos;SGL&apos;) then &apos;OS Strategic&apos;&#10;elseif [ROLE_MX] in (&apos;AE&apos;, &apos;OB aAE&apos;) then &apos;IS Regional&apos;&#10;elseif [ROLE_MX] in (&apos;ML&apos;) then &apos;OS Regional&apos;&#10;ELSEIF [ROLE_MX] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Regalix&apos;) then &apos;Outbound Vendor&apos;&#10;elseif [ROLE_MX] in (&apos;Inbound VND - TaskUs&apos;&#10;,&apos;Inbound VND - Teleperformance&apos;&#10;,&apos;Inbound VND - Regalix&apos;&#10;) then &apos;Inbound Vendor&apos;&#10;else &apos;Self Serve&apos;&#10;end' />
      </column>
      <column caption='Org (Presale Product Goals1)' datatype='string' hidden='true' name='[ORG (PRESALE_PRODUCT_GOALS1)]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[ORG]' role='dimension' type='nominal' />
      <column caption='OS Strategic Ads Actuals' datatype='integer' hidden='true' name='[OS Regional Ads Actuals (copy)_6957850336415096853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(case [Cw Owner Role Official Title (group)]&#10;when &apos;OS Strategic&apos; then ([IS_ADS])&#10;else 0 end)' />
      </column>
      <column caption='OS Regional Promo Goal' datatype='real' hidden='true' name='[OS Regional Ads Goal (copy)_6957850336412844047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='.15' />
      </column>
      <column caption='OS Strategic Promo Goal' datatype='real' hidden='true' name='[OS Strategic Ads Goal (copy)_6957850336412844048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='.20' />
      </column>
      <column caption='OS v IS Mgr (copy)' datatype='string' hidden='true' name='[OS v IS Mgr (copy)_495184902996922371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;AE&apos;, &apos;OB aAE&apos;) then &apos;Inside&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;ML&apos;, &apos;SML&apos;, &apos;SGL&apos;) then &apos;Outside&apos; &#10;elseif [ROLE (PRESALE_MANAGER_GOALS)] in (&apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Regalix&apos;,&#10;&apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - Regalix&apos;) then &apos;Vendor&apos; &#10; end' />
      </column>
      <column datatype='string' hidden='true' name='[OWNER_ORG_FOCUS]' role='dimension' type='nominal' />
      <column caption='Role ' datatype='string' name='[OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]' role='dimension' type='nominal' />
      <column caption='Current Role' datatype='string' name='[OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[On Any Comp (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[ON_ANY_COMP]' new-bin='true'>
          <bin default-name='false' value='&quot;0&quot;'>
            <value>%null%</value>
            <value>0</value>
          </bin>
        </calculation>
      </column>
      <column caption='Menu Rejection Pacing' datatype='real' hidden='true' name='[On Time Pacing (copy)_2744451451377946627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 + (avg([Mx Health: Activations PDOA Goal (copy)_2744451451374632962]) - [Calculation_2744451451374333953])&#10;/ avg([Mx Health: Activations PDOA Goal (copy)_2744451451374632962])' />
      </column>
      <column caption='SGL Opp URL' datatype='string' hidden='true' name='[Opp URL (copy)_1906570804223905825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;https://figment.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;' />
      </column>
      <column caption='Outbound Onshore Signs Goal' datatype='real' hidden='true' name='[Outbound Onshore Signs (copy)_4738279400720318466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Outbound Signs (copy)_4738279400720318464] - [Outbound Vendors Signs (copy)_4738279400720318465]' />
      </column>
      <column caption='Outbound Signs Goal' datatype='real' hidden='true' name='[Outbound Signs (copy)_4738279400720318464]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='case [ROLE]&#10;when &apos;Inbound VND - Regalix&apos; then 0&#10;when &apos;Inbound VND - Teleperformance&apos; then 0&#10;when &apos;Inbound VND - TaskUs&apos; then 0&#10;when &apos;Self Serve&apos; then 0&#10;else [CLOSES]&#10;end' />
      </column>
      <column caption='Outbound Vendors Signs Goal' datatype='real' hidden='true' name='[Outbound Vendors Signs (copy)_4738279400720318465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [ROLE]&#10;when &apos;OB Vendors - Regalix&apos; then [CLOSES]&#10;when &apos;OB Vendors - Teleperformance&apos; then [CLOSES]&#10;when &apos;OB Vendors - TaskUs&apos; then [CLOSES]&#10;when &apos;OB Vendors - Concentrix&apos; then [CLOSES]&#10;else 0&#10;end' />
      </column>
      <column caption='Pdoa' datatype='date' hidden='true' name='[PDOA]' role='dimension' type='ordinal' />
      <column caption='Phasing' datatype='real' hidden='true' name='[PHASING]' role='measure' type='quantitative' />
      <column caption='Primary Campaign Source' datatype='string' name='[PRIMARY_CAMPAIGN_SOURCE]' role='dimension' type='nominal' />
      <column caption='Product' datatype='string' hidden='true' name='[PRODUCT]' role='dimension' type='nominal' />
      <column datatype='real' hidden='true' name='[PRODUCT_GOAL]' role='measure' type='quantitative' />
      <column caption='BIS QTD Avg' datatype='real' hidden='true' name='[Productivity QTD Avg (copy)_1335669156098588675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;        (sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([HC]) end) * &#10;        AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end))&#10;        - sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([DAYS_OFF]) end)&#10;        )&#10;    / AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end)&#10;&#10;/ COUNTD(&#10;(if [YoY Curr QTD (copy)_4470104127756128291] then [WEEK_OF (PRESALES_ACTIVE_HC)] end)&#10;)' />
      </column>
      <column caption='QTD (last full week) - Top Mx' datatype='boolean' name='[QTD (last full week) (copy)_138767215421173763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
      </column>
      <column caption='QTD (last full week) - Activations' datatype='boolean' name='[QTD (last full week) (copy)_1819595047244267521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Exclude this Week (copy)_1819595047244206080] = True then True&#10;end' />
      </column>
      <column caption='QTD (last full week) - Tiers' datatype='boolean' name='[QTD (last full week) - Top Mx (copy)_138767215421968388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
      </column>

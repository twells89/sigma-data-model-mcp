                <expression op='[ROLE_SP (Custom SQL Query2)]' />
              </expression>
              <expression op='='>
                <expression op='[CW_COUNTRY]' />
                <expression _.fcp.RelationshipCalculations.false...op='[&apos;United States&apos;]' _.fcp.RelationshipCalculations.true...op='&apos;United States&apos;' />
              </expression>
            </expression>
            <first-end-point object-id='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL)_A6FFA270C65B47D39FDA7F74F0E5475C' />
            <second-end-point object-id='_93F9184C549745838659BC5BB6A2E42B' />
          </relationship>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[CW_OWNER_ROLE_OFFICIAL_TITLE]' />
                <expression op='[ROLE_SP (Custom SQL Query)]' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[IF MERCHANT_CLOSE_DATE &gt;= DATETRUNC(&apos;quarter&apos;, MERCHANT_CLOSE_DATE) &#10;   AND MERCHANT_CLOSE_DATE &lt; DATETRUNC(&apos;week&apos;, dateadd(&apos;week&apos;, 1,DATETRUNC(&apos;quarter&apos;, MERCHANT_CLOSE_DATE)))&#10;THEN date(DATETRUNC(&apos;quarter&apos;, MERCHANT_CLOSE_DATE))&#10;ELSE date( DATETRUNC(&apos;week&apos;, MERCHANT_CLOSE_DATE))&#10;END]' _.fcp.RelationshipCalculations.true...op='IF [MERCHANT_CLOSE_DATE] &gt;= DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE]) &#10;   AND [MERCHANT_CLOSE_DATE] &lt; DATETRUNC(&apos;week&apos;, dateadd(&apos;week&apos;, 1,DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE])))&#10;THEN date(DATETRUNC(&apos;quarter&apos;, [MERCHANT_CLOSE_DATE]))&#10;ELSE date( DATETRUNC(&apos;week&apos;, [MERCHANT_CLOSE_DATE]))&#10;END' />
                <expression op='[WEEK_GOAL_SP (Custom SQL Query)]' />
              </expression>
            </expression>
            <first-end-point object-id='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL)_A6FFA270C65B47D39FDA7F74F0E5475C' />
            <second-end-point object-id='_9F61F7B11089431C9AA40F6C07FB37EE' />

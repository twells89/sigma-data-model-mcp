    <worksheet name='Productivity Per Role - Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='[Active HC - Actuals]/countd([Week Of (Presales Active Hc)])' datatype='real' name='[Calculation_2821927411409281027]' role='measure' type='quantitative' user:unnamed='Productivity Per Role'>
              <calculation class='tableau' formula='[Calculation_3783938539836088324]/countd([WEEK_OF (PRESALES_ACTIVE_HC)])' />
            </column>
            <column caption='[Signs - Actuals]/([Active HC - Actuals]/countd([Week Of (Pre...' datatype='real' name='[Calculation_2821927411417169933]' role='measure' type='quantitative' user:unnamed='Productivity Per Role'>
              <calculation class='tableau' formula='[Calculation_3783938539825639424]/([Calculation_3783938539836088324]/countd([WEEK_OF (PRESALES_ACTIVE_HC)]))' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Active HC - Actuals' datatype='integer' datatype-customized='true' name='[Calculation_3783938539836088324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))/avg([WORKING_DAYS]))' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Role Title' datatype='string' name='[Cw Owner Role Official Title (group) 1]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CW_OWNER_ROLE_OFFICIAL_TITLE]' new-bin='true'>
                <bin default-name='false' value='&quot;AE&quot;'>
                  <value>&quot;AE&quot;</value>
                  <value>&quot;Account Executive&quot;</value>
                  <value>&quot;Account Executive - In Training&quot;</value>
                  <value>&quot;Outbound AE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;CAN SAE&quot;'>
                  <value>&quot;CAN SAE&quot;</value>
                  <value>&quot;Team Lead, Inside Pre Sales&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Inbound &amp; Inbound Onshore&quot;'>
                  <value>&quot;Inbound&quot;</value>
                  <value>&quot;Inbound Onshore&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Inbound Vendor&quot;'>
                  <value>&quot;Inbound VND - Regalix&quot;</value>
                  <value>&quot;Inbound VND - TaskUs&quot;</value>
                  <value>&quot;Inbound VND - Teleperformance&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Misc&quot;'>
                  <value>&quot;AE Manager&quot;</value>
                  <value>&quot;AUS AE&quot;</value>
                  <value>&quot;Associate Inside Sales Manager&quot;</value>
                  <value>&quot;CAN Manager&quot;</value>
                  <value>&quot;Caviar AE&quot;</value>
                  <value>&quot;Contingent Worker&quot;</value>
                  <value>&quot;Inbound Manager&quot;</value>
                  <value>&quot;Inbound SDR&quot;</value>
                  <value>&quot;Inside Sales Manager&quot;</value>
                  <value>&quot;ML Manager&quot;</value>
                  <value>&quot;Manager, Outside Pre Sales - Marketplace&quot;</value>
                  <value>&quot;Outbound SDR&quot;</value>
                  <value>&quot;Outside Strategic SDR&quot;</value>
                  <value>&quot;Quality Associate&quot;</value>
                  <value>&quot;Strategic Sales Manager&quot;</value>
                  <value>&quot;Strategic Team Lead&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Outbound Vendor&quot;'>
                  <value>&quot;OB Vendors - Regalix&quot;</value>
                  <value>&quot;OB Vendors - Teleperformance&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Days Off' datatype='real' name='[DAYS_OFF]' role='measure' type='quantitative' />
            <column datatype='real' name='[HC]' role='measure' type='quantitative' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />

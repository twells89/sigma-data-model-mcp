      <column caption='Qtr Yr Mx' datatype='string' hidden='true' name='[QTR_YR_MX]' role='dimension' type='nominal' />
      <column caption='Qtr Yr Pg (Presale Product Goals1)' datatype='string' hidden='true' name='[QTR_YR_PG (PRESALE_PRODUCT_GOALS1)]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[QTR_YR_PG]' role='dimension' type='nominal' />

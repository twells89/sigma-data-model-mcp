            <column-instance column='[ROLE]' derivation='None' name='[none:ROLE:nk]' pivot='key' type='nominal' />
            <column-instance column='[WEEK_OF (Custom SQL Query3)]' derivation='None' name='[none:WEEK_OF (Custom SQL Query3):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4738279400726106126]' derivation='Sum' name='[sum:Calculation_4738279400726106126:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3783938539825639424]' derivation='User' name='[usr:Calculation_3783938539825639424:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3783938539836088324]' derivation='User' name='[usr:Calculation_3783938539836088324:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3783938539841773579]' derivation='User' name='[usr:Calculation_3783938539841773579:qk]' pivot='key' type='quantitative' />

    <worksheet name='Outside Regional - GML'>
      <layout-options>
        <title>
          <formatted-text>
            <run>GML / Top Gun</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
              <calculation class='tableau' formula='&quot;% of Signs&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Active HC - Goal' datatype='real' name='[AHC_GOAL]' role='measure' type='quantitative' />
            <column caption='Queen - Signs by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy) (copy)_1829939221928001542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Queen&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF  [DECK_RANK] = &apos;Queen&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='King - Signs by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy)_1829939221927989253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;King&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;King&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Signs - Goal' datatype='real' datatype-customized='true' name='[CLOSES]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='% SDR Supported' datatype='real' name='[Calculation_1814950712652083200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([SDR_OWNER])/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Ace - Signs by Deck Rank' datatype='real' name='[Calculation_1829939221923893248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Ace&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Ace&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
            </column>
            <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Signs Pacing' datatype='real' name='[Calculation_3783938539829059585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3783938539825639424])/round(SUM([CLOSES]),0)' />
            </column>
            <column caption='Active HC - Actuals' datatype='integer' datatype-customized='true' name='[Calculation_3783938539836088324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))/avg([WORKING_DAYS]))' />
            </column>
            <column caption='Active HC Pacing' datatype='real' name='[Calculation_3783938539841773579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3783938539836088324])/SUM([AHC_GOAL])' />
            </column>
            <column caption='Dashpass Attachment' datatype='real' name='[Calculation_3783938539842052109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([IS_DASHPASS])/([Calculation_3783938539825639424])' />
            </column>
            <column caption='Pickup Attachment' datatype='real' name='[Calculation_3783938539854696462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([IS_PICKUP])/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Alcohol Attachment' datatype='real' name='[Calculation_3783938539854921743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([IS_ALCOHOL])/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Storefront Attachment' datatype='real' name='[Calculation_3783938539855089680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([IS_STOREFRONT])/[Calculation_3783938539825639424]' />
            </column>
            <column caption='CWs / AHC' datatype='real' name='[Calculation_3783938539858427923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3783938539825639424])/([Calculation_3783938539836088324])' />
            </column>
            <column caption='TAM / CW' datatype='real' name='[Calculation_3783938539858702356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([INCREMENTAL_SIGN_TAM])/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Holdouts (table)' datatype='real' name='[Calculation_4387350494069833729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [IS_HOLDOUT] = 1&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [IS_HOLDOUT] = 1&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Days Off' datatype='real' name='[DAYS_OFF]' role='measure' type='quantitative' />
            <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
            <column datatype='real' name='[HC]' role='measure' type='quantitative' />
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Is Alcohol' datatype='integer' name='[IS_ALCOHOL]' role='dimension' type='ordinal' />
            <column caption='Dashpass' datatype='integer' name='[IS_DASHPASS]' role='dimension' type='ordinal' />
            <column caption='Is Holdout' datatype='integer' name='[IS_HOLDOUT]' role='measure' type='quantitative' />
            <column caption='Pickup' datatype='integer' name='[IS_PICKUP]' role='dimension' type='ordinal' />
            <column caption='Storefront' datatype='integer' name='[IS_STOREFRONT]' role='dimension' type='ordinal' />
            <column caption='Activation Date' datatype='date' name='[MERCHANT_ACTIVATION_DATE]' role='dimension' type='ordinal' />
            <column datatype='real' name='[NARR]' role='measure' type='quantitative' />
            <column caption='Unranked - Signs by Deck Rank' datatype='real' name='[Queen - Signs by Deck Rank (copy) (copy)_1829939221928345608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF isnull([DECK_RANK])&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF  isnull([DECK_RANK])&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Joker - Signs by Deck Rank' datatype='real' name='[Queen - Signs by Deck Rank (copy)_1829939221928333319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Joker&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF  [DECK_RANK] = &apos;Joker&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='SDR' datatype='string' name='[SDR_OWNER]' role='dimension' type='nominal' />

        <calculation class='tableau' formula='sum(if [WEEK_OF] &lt;= DATEADD(&apos;week&apos;, -3, TODAY()) = true then [INCREMENTAL_SIGN_TAM] end)' />
      </column>
      <column caption='TAM excl last 2 weeks YoY' datatype='real' name='[Calculation_1538401536364507147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [WEEK_OF] &lt;= DATEADD(&apos;week&apos;, -3, TODAY()) = true and [Calculation_2307320765861478405] = true then [INCREMENTAL_SIGN_TAM] end)&#10;&#10;/&#10;&#10;sum(&#10;if [Calculation_2307320765864128521] = true &#10;and datepart(&apos;week&apos;,[WEEK_OF]) &lt;= datepart(&apos;week&apos;,DATEADD(&apos;week&apos;, -3, TODAY()))&#10;then [INCREMENTAL_SIGN_TAM]&#10;end)&#10;- 1' />
      </column>
      <column caption='Selection Param Filter' datatype='real' name='[Calculation_1538401536513917038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 17]&#10;when &apos;Signs&apos; then [Calculation_3783938539825639424]&#10;when &apos;TAM&apos; then sum([INCREMENTAL_SIGN_TAM])&#10;when &apos;TAM per Sign&apos; then [Calculation_3783938539858702356]&#10;end' />
      </column>
      <column caption='Signs with SDR' datatype='integer' name='[Calculation_1656550670929633282]' role='measure' type='quantitative'>

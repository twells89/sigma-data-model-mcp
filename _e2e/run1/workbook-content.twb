    <worksheet name='Selection: Tiers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Tiers CW Progress</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Filtering for quarters prior to 2024 Q4 will give you data for T3-5. For 2024 Q4 onwards, the data in this chart is for T4-5. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Org - Tier Tracking' datatype='string' name='[Calculation_1755629837072850971]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_4245346387489398784] in (&apos;Strategic&apos;, &apos;Regional&apos;, &apos;OB Vendor&apos;) then &apos;Outbound Signs&apos; &#10;else &apos;Inbound + SSMO Signs&apos; &#10;end' />
            </column>
            <column caption='% of Total Signs (T4-5)' datatype='real' name='[Calculation_2226256020515844097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SP: Top Mx (copy)_5820832199702355969]/[Calculation_3783938539825639424]' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='Team - Tier Activations Tracking' datatype='string' name='[Calculation_4245346387489398784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;,&apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Tier Pacing' datatype='real' name='[Calculation_7013793520515731457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([SP: Top Mx (copy)_5820832199702355969]/[SP: Top Mx Goal (copy)_5820832199702355970])' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Initiative_SP_Copy' datatype='string' name='[INITIATIVE (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Initiative_Goal_Copy' datatype='real' name='[INITIATIVE_GOAL (Custom SQL Query)]' role='measure' type='quantitative' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='QTD (last full week) - Tiers' datatype='boolean' name='[QTD (last full week) - Top Mx (copy)_138767215421968388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
            </column>
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='Role_SP_Copy' datatype='string' name='[ROLE_SP (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
              </aliases>
            </column>
            <column caption='Tier Actuals' datatype='integer' name='[SP: Top Mx (copy)_5820832199702355969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#10;&#10;if [MERCHANT_CLOSE_DATE] &lt;= date(&apos;2024-09-30&apos;) &#10;&#9;then  (if [TIER (copy)_4245346387496407042] in (3,4,5)&#10;&#9;&#9;&#9;or [ROLE_SP (Custom SQL Query)] = &apos;Blitz (AE)&apos;&#10;&#9;&#9;&#9;or ([SUBMARKET_ID]&lt;&gt;0 and isnull([TIER (copy)_4245346387496407042]) )&#10;&#9;&#9;&#9; then [STORE_ACCOUNT_ID] end)&#10; &#10; elseif [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2024-10-01&apos;) &#10;&#9; then  (if [TIER (copy)_4245346387496407042] in (4,5)&#10;&#9;&#9;&#9;//or [Role_SP_Copy] = &apos;Blitz (AE)&apos;&#10;&#9;&#9;&#9;&#10;&#9;&#9;&#9; then [STORE_ACCOUNT_ID] end)&#10;end)&#10;&#10;/*&#10;(&#10;    if [TIER] in (&apos;3&apos;,&apos;4&apos;,&apos;5&apos;) OR&#10;        ((str([LEAD_LIST_CUSTOMIZED]) &gt;= &apos;2024-01-01&apos; or str([LEAD_LIST_CUSTOMIZED]) &lt; &apos;2024-04-01&apos;)&#10;            and [TIER] in (&apos;1&apos;, &apos;2&apos;))&#10;    THEN [Account Id]&#10;END&#10;&#10;)&#10;*/' />
            </column>
            <column caption='Tier Goal' datatype='real' name='[SP: Top Mx Goal (copy)_5820832199702355970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query)] = &apos;T3-5 CW&apos; or  [INITIATIVE (Custom SQL Query)] = &apos;T4-5 CW&apos;&#10;then [INITIATIVE_GOAL (Custom SQL Query)] end)' />
            </column>
            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[SUBMARKET_ID]' role='measure' type='quantitative' />
            <column caption='Team' datatype='string' name='[TEAM]' role='dimension' type='nominal' />
            <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([TIER])' />
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column datatype='string' datatype-customized='true' name='[TIER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column caption='Week_SP_Copy' datatype='date' name='[WEEK_GOAL_SP (Custom SQL Query)]' role='dimension' type='ordinal' />

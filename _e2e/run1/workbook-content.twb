      <column caption='King - Activations by Deck Rank' datatype='real' name='[Ace - Activations by Deck Rank (copy)_2137872874710343685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;King&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;King&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='Queen - Signs by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy) (copy)_1829939221928001542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Queen&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF  [DECK_RANK] = &apos;Queen&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='King - Signs by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy)_1829939221927989253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;King&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;King&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='Ace - Activations by Deck Rank' datatype='real' name='[Ace - Signs by Deck Rank (copy)_2137872874709295108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Ace&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Ace&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='BIS' datatype='real' hidden='true' name='[Active HC - Actuals (copy)_4334925757750915082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((sum([HC]) * avg([WORKING_DAYS]))-sum([DAYS_OFF]))/avg([WORKING_DAYS])/COUNTD([WEEK_OF (Custom SQL Query3)]))' />
      </column>
      <column caption='% Product Attach Toggle' datatype='real' hidden='true' name='[Ads &amp; Promo Toggle (copy)_170784961147109420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;when &quot;Ads&quot; then [% Promos (copy)_170784960784449547]&#10;when &quot;Promos&quot; then [Calculation_170784960782204935]&#10;when &quot;Ads &amp; Promos&quot; then [% Promos (copy)_170784960787558418]&#10;when &quot;PickUp&quot; then [Calculation_3783938539854696462]&#10;when &quot;DashPass&quot; then [Calculation_3783938539842052109]&#10;when &quot;Storefront Attach&quot; then [Calculation_3783938539855089680]&#10;end' />
      </column>
      <column caption='Based (Presale Product Goals1)' datatype='string' hidden='true' name='[BASED (PRESALE_PRODUCT_GOALS1)]' role='dimension' type='nominal' />
      <column caption='Based' datatype='string' hidden='true' name='[BASED]' role='dimension' type='nominal' />
      <column caption='BIS Goal' datatype='real' hidden='true' name='[BIS (copy)_4334925757753368588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AHC_GOAL])/countd([WEEK_OF (Custom SQL Query3)])' />
      </column>
      <column caption='BIS (copy)' datatype='real' hidden='true' name='[BIS (copy)_4470104127777243198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((sum(if &#10; [OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos;&#10;then null&#10;else&#10;[HC] end)&#10;*&#10;avg(if &#10; [OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos;&#10;then null&#10;else&#10;[WORKING_DAYS] end)&#10;)&#10;-&#10;sum(if &#10; [OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos;&#10;then null&#10;else&#10;[DAYS_OFF] end))&#10;/&#10;avg(if &#10; [OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos;&#10;then null&#10;else&#10;[WORKING_DAYS] end))&#10;/COUNTD([WEEK_OF (PRESALES_ACTIVE_HC)])' />
      </column>
      <column caption='BIS - Progress' datatype='real' hidden='true' name='[BIS (copy)_5843842750856818714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((sum(if [Parameters].[Parameter 7] = &apos;Last Week&apos; and [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [HC]&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; and [Calculation_4334925757746180098] = True&#10;then [HC]&#10;end)&#10;* avg([WORKING_DAYS]))-sum([DAYS_OFF]))&#10;&#10;/avg([WORKING_DAYS]))&#10;&#10;/&#10;COUNTD(&#10;if [Parameters].[Parameter 7] = &apos;Last Week&apos; and [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [WEEK_OF (PRESALES_ACTIVE_HC)]&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; and [Calculation_4334925757746180098] = True&#10;then [WEEK_OF (PRESALES_ACTIVE_HC)]&#10;end)&#10;&#10;/*&#10;sum(if [Signs v Goals Param] = &apos;Last Week&apos; and [Last Week - Goals] = True&#10;then [Active HC - Goal]&#10;elseif [Signs v Goals Param] = &apos;QTD&apos; and [QTD Goal] = True&#10;then [Active HC - Goal]&#10;end)&#10;*/' />
      </column>
      <column caption='BIS - Progress (copy)' datatype='real' hidden='true' name='[BIS - Progress (copy)_5843842750861742109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg((((&#10;if [Parameters].[Parameter 7] = &apos;Last Week&apos;  then&#10;    (if [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [HC]&#10;end)&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;    (if [Calculation_4334925757746180098] = True&#10;then [HC]&#10;end)&#10;    end)&#10;&#10;* &#10;&#10;(if [Parameters].[Parameter 7] = &apos;Last Week&apos;  then&#10;    (if [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [WORKING_DAYS]&#10;end)&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;    (if [Calculation_4334925757746180098] = True&#10;then [WORKING_DAYS]&#10;end)&#10;    end)&#10;)&#10;&#10;-&#10;&#10;(if [Parameters].[Parameter 7] = &apos;Last Week&apos;  then&#10;    (if [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [DAYS_OFF]&#10;end)&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;    (if [Calculation_4334925757746180098] = True&#10;then [DAYS_OFF]&#10;end)&#10;    end)&#10;)&#10;&#10;/&#10;(if [Parameters].[Parameter 7] = &apos;Last Week&apos;  then&#10;    (if [Last Week - Goals (copy)_5843842750859100188] = True&#10;then [WORKING_DAYS]&#10;end)&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then&#10;    (if [Calculation_4334925757746180098] = True&#10;then [WORKING_DAYS]&#10;end)&#10;    end)&#10;&#10;)&#10;&#10;/&#10;COUNTD([WEEK_OF (PRESALES_ACTIVE_HC)])&#10;&#10;/*&#10;sum(if [Signs v Goals Param] = &apos;Last Week&apos; and [Last Week - Goals] = True&#10;then [Active HC - Goal]&#10;elseif [Signs v Goals Param] = &apos;QTD&apos; and [QTD Goal] = True&#10;then [Active HC - Goal]&#10;end)&#10;*/' />
      </column>
      <column caption='BIS Goal - Progress' datatype='real' hidden='true' name='[BIS Goal (copy)_5843842750855536665]' role='measure' type='quantitative'>

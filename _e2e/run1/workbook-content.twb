    <dashboard name='Total Pre-Sale Org'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='16'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://REDACTED_INTERNAL_HOST/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard/TotalPre-SaleOrg?rev=' id='TotalPre-SaleOrg' path='/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard' revision='' site='DoorDash' />
      <style />
      <size maxheight='3200' maxwidth='1400' minheight='3200' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
          <calculation class='tableau' formula='&quot;% of Signs&quot;' />
          <members>
            <member value='&quot;Total Signs&quot;' />
            <member value='&quot;\% of Signs&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
        <column caption='Is Activated?' datatype='string' name='[Calculation_2500482980966989824]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if isnull([MERCHANT_ACTIVATION_DATE]) then &quot;No&quot; else &quot;Yes&quot; end' />
        </column>
        <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
        </column>
        <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
        </column>
        <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
        </column>
        <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
        <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
        </column>
        <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
        <column caption='Goals by Team' datatype='string' name='[Strategic v Regional v Vendor (copy)_6915347642917163098]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [ROLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;CAN ML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN SML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN AE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE (Top Mx)&apos; then &apos;CAN Inside&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
          <aliases>
            <alias key='&quot;US Strategic&quot;' value='Strategic' />

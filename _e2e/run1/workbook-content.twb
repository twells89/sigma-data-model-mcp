              <zone forceUpdate='true' h='4063' id='1131' type-v2='text' w='11200' x='88267' y='7940'>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>- Select &quot;Total Signs&quot; to see how many signs were closed for each Deck Rank and how many signs in a given week were holdouts</run>

    <worksheet name='Deck Rank by Mgr'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'><![CDATA[<[Parameters].[Parameter 10]> by Deck Rank]]></run>
            <run fontalignment='1' fontsize='12'><![CDATA[ by Manager: <[federated.1d44dls1qne6m411a222e1j5w12c].[none:Calculation_4591490232318570497:nk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='9'>Use the &quot;Quarter&quot; drop down above to filter for a specific quarter</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='9'>Use the &quot;Total Signs vs % of Signs&quot;toggle  to switch between % of Signs per Deck Rank and Total Signs per Deck Rank (will also update the chart above)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
              <calculation class='tableau' formula='&quot;% of Signs&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='&lt;1 Deck Rank Param Calc' datatype='real' name='[&gt;1 Deck Rank Param Calc (copy)_272115961664331782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_272115961656373248] = 0 then 0&#10;elseif [Calculation_272115961656373248] &lt; 1 then&#10;[Calculation_272115961656373248]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Deck Rank Param Calc' datatype='real' name='[Calculation_272115961656373248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 10]&#10;when &quot;Total Signs&quot; then [Calculation_3783938539825639424]&#10;when &quot;% of Signs&quot; then [Calculation_3783938539825639424]/window_sum([Calculation_3783938539825639424])&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='&gt;1 Deck Rank Param Calc' datatype='real' name='[Calculation_272115961664032773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_272115961656373248] = 0 then 0&#10;elseif [Calculation_272115961656373248] &gt; 1 then&#10;[Calculation_272115961656373248]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OS v IS' datatype='string' name='[Calculation_272115961694973986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Cw Owner Role Official Title (group)]&#10;when &apos;IS Regional&apos; then &apos;Inside&apos;&#10;when &apos;OS Regional&apos; then &apos;Outside&apos;&#10;when &apos;IS Strategic&apos; then &apos;Inside&apos;&#10;when &apos;OS Strategic&apos; then &apos;Outside&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;else &apos;Inside&apos;&#10;end' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />

      <column caption='Team - Top Mx Activations Tracking' datatype='string' name='[ROLE_SP (Custom SQL Query1) (copy)_6190549589468631045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query2)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query2)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query2)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
      </column>
      <column caption='T4-5 Activations by Team' datatype='string' name='[ROLE_SP (Custom SQL Query2) (copy)_6190549589466468355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query2)] in (&apos;AE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;OB aAE&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;Inbound VND&apos;) then &apos;IB Vendors&apos;&#10;end' />
      </column>

        <calculation class='tableau' formula='countd(if [IS_HOLDOUT] = 1 then [STORE_ACCOUNT_ID] end)' />
      </column>
      <column caption='SML Staffing - agg then average' datatype='real' hidden='true' name='[Strategic Staffing (copy)_4591490232377417779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;    avg({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [HC] end)})&#10;    *&#10;    avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] : avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [WORKING_DAYS] end)})&#10;    )&#10;-&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] : sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [DAYS_OFF] end)})&#10;)&#10;&#10;&#10;/&#10;&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] : avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] = &apos;SML&apos; then [WORKING_DAYS] end)})&#10;&#10;&#10;&#10;///countd([Week Of (Presales Active Hc)])&#10;&#10;//(([sml HC] * [sml working week days]) - [Days off per week sml])/[sml working week days]' />
      </column>
      <column caption='Regional Staffing' datatype='real' name='[Strategic Staffing (copy)_4591490232394051671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Strategic Staffing QoQ' datatype='real' hidden='true' name='[Strategic Staffing YoY (copy)_148126253408931874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;/&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [QoQ: Prev YR QTD (copy)_148126253408821281] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Regional Staffing YoY' datatype='real' name='[Strategic Staffing YoY (copy)_6915347642907799614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;/&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Presales Orgs' datatype='string' hidden='true' name='[Strategic v Regional v Vendor (copy)_1906570804204990490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
      </column>
      <column caption='Goals by Team' datatype='string' name='[Strategic v Regional v Vendor (copy)_6915347642917163098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [ROLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;CAN ML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN SML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN AE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE (Top Mx)&apos; then &apos;CAN Inside&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
        <aliases>
          <alias key='&quot;US Strategic&quot;' value='Strategic' />
        </aliases>
      </column>
      <column caption='T3-5 Actuals (copy)' datatype='integer' name='[T3-5 Actuals (copy)_475059441989722113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([SP: Top Mx (copy)_5820832199702355969])' />
      </column>
      <column caption='CY TAM' datatype='real' name='[TAM (copy)_6340434971064840193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[INCREMENTAL_SIGN_TAM]' />
      </column>
      <column caption='YoY: TAM / HC ' datatype='integer' hidden='true' name='[TAM / HC (copy)_3548766151984914439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - 1' />
      </column>
      <column caption='TAM / HC for Reps with CWs' datatype='real' name='[TAM / HC (copy)_5843842750844387346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([INCREMENTAL_SIGN_TAM])/COUNTD([SALES_OWNER])' />
      </column>
      <column caption='TAM temp curr qtd (copy)' datatype='real' hidden='true' name='[TAM temp curr qtd (copy)_2307320765862879240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//get week nums&#10;if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt;= (datepart(&apos;week&apos;,date(today())))&#10;and quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;then ([INCREMENTAL_SIGN_TAM])&#10;else 0&#10;end' />
      </column>
      <column caption='Target (Presale Product Goals1)' datatype='string' hidden='true' name='[TARGET (PRESALE_PRODUCT_GOALS1)]' role='dimension' type='nominal' />
      <column caption='Target' datatype='string' hidden='true' name='[TARGET]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[TEAM (PRESALE_MX_HEALTH_GOALS)]' role='dimension' type='nominal' />
      <column caption='Team (Presale Product Goals1)' datatype='string' hidden='true' name='[TEAM (PRESALE_PRODUCT_GOALS1)]' role='dimension' type='nominal' />
      <column caption='Team' datatype='string' name='[TEAM]' role='dimension' type='nominal' />
      <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([TIER])' />
        <aliases>
          <alias key='%null%' value='No Tier' />
        </aliases>
      </column>
      <column datatype='string' datatype-customized='true' name='[TIER]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='No Tier' />
        </aliases>
      </column>
      <column caption='Team - Top Mx Tracking' datatype='string' name='[Team - Tier Tracking (copy)_4245346387490271233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ROLE_SP] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;ELSEIF [ROLE_SP] = &apos;BD&apos; then &apos;BD&apos;&#10;else [ROLE_SP]&#10;end' />
      </column>
      <column caption='Non-Tier Calc' datatype='real' name='[Tiers 5 Calc (copy)_1252141487247577104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and isnull([Calculation_1252141487240110082])&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and isnull([Calculation_1252141487240110082])&#10;then [STORE_ACCOUNT_ID] end)&#10;end)&#10;&#10;//CAN_Q3.23_TIER 1_P0' />
      </column>
      <column caption='T4-5 Activations' datatype='integer' name='[Top Mx Activations (copy)_6190549589460205569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if ([TIER (copy)_4245346387496407042] = 4 or [TIER (copy)_4245346387496407042]=5) and  isnull([MERCHANT_ACTIVATION_DATE]) = False then [STORE_ID] end)' />
      </column>
      <column caption='T4-5 Activations Goal' datatype='real' name='[Top Mx Activations Goal (copy)_6190549589460205570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query2)] = &apos;T4-5 Activations&apos; then [INITIATIVE_GOAL (Custom SQL Query2)] end)' />
      </column>
      <column caption='T4-5 Activations Pacing' datatype='real' name='[Top Mx Activations Pacing (copy)_6190549589460205568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Top Mx Activations (copy)_6190549589460205569]/[Top Mx Activations Goal (copy)_6190549589460205570])' />
      </column>
      <column caption='Total Org - Activations' datatype='string' hidden='true' name='[Total Org (copy)_2137872874714820621]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if not isnull([ROLE_ACTIVATIONS]) then &apos;Total Org&apos; end' />
      </column>

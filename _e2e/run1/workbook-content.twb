            <column caption='Non-Tier Calc' datatype='real' name='[Tiers 5 Calc (copy)_1252141487247577104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and isnull([Calculation_1252141487240110082])&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and isnull([Calculation_1252141487240110082])&#10;then [STORE_ACCOUNT_ID] end)&#10;end)&#10;&#10;//CAN_Q3.23_TIER 1_P0' />

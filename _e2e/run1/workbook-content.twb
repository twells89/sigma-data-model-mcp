      <column caption='Joker - Activations by Deck Rank' datatype='real' name='[Jack - Activations by Deck Rank (copy)_2137872874711425033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Joker&apos; &#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF [DECK_RANK] = &apos;Joker&apos; &#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='Unranked - Activations by Deck Rank' datatype='real' name='[Jack - Activations by Deck Rank (copy)_2137872874711531530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF isnull([DECK_RANK])&#10;               AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;        /&#10;        COUNTD(&#10;            IF not(isnull([MERCHANT_ACTIVATION_DATE])) &#10;            THEN [STORE_ID] &#10;            END&#10;        )&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF isnull([DECK_RANK])&#10;           AND not(isnull([MERCHANT_ACTIVATION_DATE]))&#10;        THEN [STORE_ID] &#10;        END&#10;    )&#10;END' />
      </column>

            <column caption='Role Activations' datatype='string' name='[ROLE_ACTIVATIONS]' role='dimension' type='nominal' />
            <column caption='Activations by Team' datatype='string' name='[Role Activations (copy)_2137872874715025422]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_ACTIVATIONS] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;ML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif regexp_match([ROLE_ACTIVATIONS], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;elseif [ROLE_ACTIVATIONS] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;else [ROLE_ACTIVATIONS]&#10;end' />
            </column>

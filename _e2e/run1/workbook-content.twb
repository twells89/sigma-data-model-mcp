en &apos;OB Vendors - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;                when &apos;OB Vendors - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;                else null&#10;                end&#10;                )&#10;            end&#10;            )&#10;            )&#10;        )&#10;        )&#10;)&#10;/&#10; (&#10;            (countd(if [YoY: Prev YR QTD (copy)_607845257020370963] then &#10;                (&#10;                case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;                when &apos;Inbound VND - Regalix&apos; then null&#10;                when &apos;Inbound VND - Teleperformance&apos; then null&#10;                when &apos;Inbound VND - TaskUs&apos; then null&#10;                when &apos;Self Serve&apos; then null&#10;                when &apos;Self-Serve Integration User&apos; then null&#10;                else [STORE_ACCOUNT_ID]&#10;                end&#10;                )&#10;            end&#10;            )&#10;            -&#10;            (countd(if [YoY: Prev YR QTD (copy)_607845257020370963] then &#10;                (&#10;                case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;                when &apos;OB Vendors - Regalix&apos; then [STORE_ACCOUNT_ID]&#10;                when &apos;OB Vendors - Teleperformance&apos; then [STORE_ACCOUNT_ID]&#10;                else null&#10;                end&#10;                )&#10;            end&#10;            )&#10;            )&#10;        )&#10;        )' />

        <calculation class='tableau' formula='IF &#10;[PRODUCT_GOAL] = 0 THEN NULL ELSE [PRODUCT_GOAL] end' />
      </column>
      <column caption='% Promos' datatype='real' hidden='true' name='[Calculation_170784960782204935]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if sum([IS_PROMO])/[Calculation_3783938539825639424] = 0 then null else sum([IS_PROMO])/[Calculation_3783938539825639424]&#10;end' />
      </column>
      <column caption='Product Attach Toggle' datatype='integer' hidden='true' name='[Calculation_170784960789442581]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;when &quot;Ads&quot; then [IS_ADS]&#10;when &quot;Promos&quot; then [IS_PROMO]&#10;when &quot;Ads &amp; Promos&quot; then [IS_ADS_PROMOS]&#10;when &quot;PickUp&quot; then [IS_PICKUP]&#10;when &quot;DashPass&quot; then [IS_DASHPASS]&#10;when &quot;Storefront Attach&quot; then [IS_STOREFRONT]&#10;end' />
      </column>
      <column caption='Product Toggle Calc' datatype='real' hidden='true' name='[Calculation_170784960789639190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_170784960789442581])/[Calculation_3783938539825639424]' />
      </column>
      <column caption='Last Product' datatype='boolean' hidden='true' name='[Calculation_170784960796749851]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 1'>

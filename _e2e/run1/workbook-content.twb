        <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
        <column caption='Activation_Week' datatype='date' name='[Calculation_2788220767980802053]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='if [MERCHANT_ACTIVATION_DATE] = date(&apos;2024-09-30&apos;) then date(dateadd(&apos;day&apos;, -7, datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)))&#10;elseif date(datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)) = date(&apos;2024-09-30&apos;) then date( datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;tuesday&apos;))&#10;else date(datetrunc(&apos;week&apos;, [MERCHANT_ACTIVATION_DATE], &apos;monday&apos;)) end' />
        </column>
        <column caption='WO Number' datatype='string' name='[Calculation_2837338173342060544]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[WORK_ORDER_NUMBER]' />
        </column>
        <column caption='Has SDR' datatype='boolean' name='[Calculation_3146749521975640072]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([SDR_ID]) then False &#10;&#9;else True&#10;    end' />
        </column>
        <column caption='Quarter of Activations' datatype='string' name='[Calculation_3146749531872968718]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='str(YEAR([WEEK_GOAL_ACTIVATIONS]))+&quot;-Q&quot;+str(QUARTER([WEEK_GOAL_ACTIVATIONS]))' />
        </column>

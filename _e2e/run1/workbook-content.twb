    <worksheet name='SMB Weekly WW QTD Pacing'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='2' fontsize='12'>Æ </run>
            <run fontalignment='2' fontsize='9'>W/W Pacing Change</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Active HC - Goal' datatype='real' name='[AHC_GOAL]' role='measure' type='quantitative' />
            <column caption='Signs - Goal' datatype='real' datatype-customized='true' name='[CLOSES]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='W/W % Pacing Change: Signs' datatype='real' name='[Calculation_3645452848249196560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(running_sum(COUNTD(if [WEEK_OF] &lt;=  dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;=  dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; then [CLOSES] end)) //last week goal&#10;)&#10;-&#10;(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;=  dateadd(&apos;day&apos;, 2, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [CLOSES] end)) //last week goal&#10;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='0' datatype='integer' name='[Calculation_3645452848288170032]' role='measure' type='quantitative' user:unnamed='SMB Weekly WW QTD Pacing'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Strategic v Regional v Vendor' datatype='string' name='[Calculation_4591490232365199376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
            </column>
            <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Days Off' datatype='real' name='[DAYS_OFF]' role='measure' type='quantitative' />
            <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
            <column datatype='real' name='[HC]' role='measure' type='quantitative' />
            <column caption='Initiative' datatype='string' name='[INITIATIVE]' role='dimension' type='nominal' />
            <column caption='Initiative Goal' datatype='real' name='[INITIATIVE_GOAL]' role='measure' type='quantitative' />
            <column caption='Is Holdout' datatype='integer' name='[IS_HOLDOUT]' role='measure' type='quantitative' />
            <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
            </column>
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='Role ' datatype='string' name='[OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]' role='dimension' type='nominal' />
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column caption='W/W % Pacing Change: IB Vendor Signs' datatype='real' name='[W/W % Pacing Change: OB Vendor Signs (copy)_3645452848294289480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; and [Calculation_4591490232365199376] = &apos;Vendor OB&apos;&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; and [ROLE] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Concentrix&apos;)&#10; then [CLOSES] end)) //last week goal&#10;)&#10;-&#10;(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; and [Calculation_4591490232365199376] = &apos;Vendor OB&apos;&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 2, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; and [ROLE] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Regalix&apos;, &apos;Inbound VND - Concentrix&apos;)&#10; then [CLOSES] end)) //last week goal&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W/W % Pacing Change: IB Vendors Staffing' datatype='real' name='[W/W % Pacing Change: OB Vendors Staffing (copy)_3645452848296878156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today()))) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today()))) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today()))) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;)&#10;&#10; //last week actuals&#10;/&#10;running_sum(&#10;avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;:sum(if [ROLE] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today())))&#10;then [AHC_GOAL] end)})&#10;)&#10;)&#10;-&#10;(&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10;&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (PRESALES_ACTIVE_HC)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10; then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;&#10;/&#10;running_sum(&#10;avg({ fixed [WEEK_OF (Custom SQL Query3)]&#10;:sum(if [ROLE] in  (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) and [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today())))&#10;&#10;then [AHC_GOAL] end)})&#10;)&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W/W % Pacing Change: SSMO Signs' datatype='real' name='[W/W % Pacing Change: Regional Signs (copy)_3645452848296038474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today()))) and [Calculation_4591490232365199376] = &apos;SSMO&apos;&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-1,today()))) and [ROLE] in (&apos;Self Serve&apos;)&#10; then [CLOSES] end)) //last week goal&#10;)&#10;-&#10;(running_sum(COUNTD(if [WEEK_OF] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today()))) and [Calculation_4591490232365199376] = &apos;SSMO&apos;&#10; then [STORE_ACCOUNT_ID] end)) //last week actuals&#10;/&#10;running_sum(sum(if [WEEK_OF (Custom SQL Query3)] &lt;= dateadd(&apos;day&apos;, 1, datetrunc(&apos;week&apos;, dateadd(&apos;week&apos;,-2,today()))) and [ROLE] in (&apos;Self Serve&apos;)&#10; then [CLOSES] end)) //last week goal&#10;)'>

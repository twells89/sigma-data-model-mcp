            <column caption='(countd(if [Strategic v Regional v Vendor] = &apos;Strategic&apos; and ...' datatype='real' name='[Calculation_7654993470871425047]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='(countd(if [Calculation_4591490232365199376] = &apos;Strategic&apos; and [Calculation_2307320765861478405] = True&#10;then [STORE_ACCOUNT_ID] end)&#10;/ countd(if [Calculation_4591490232365199376] = &apos;Strategic&apos; and [Calculation_2307320765864128521] = TRUE&#10;then [STORE_ACCOUNT_ID] end))-1' />

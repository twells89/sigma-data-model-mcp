      <column caption='NARR Pacing (incl. Product Attach)' datatype='real' hidden='true' name='[Calculation_6585388618080165888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TOTAL_NARR])/SUM([NARR (PRESALE_WEEKLY_GOALS)])' />
      </column>
      <column caption='Top Mx' datatype='integer' name='[Calculation_6622965475636920323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [TOP_MX] = True then 1 else 0 END' />
      </column>
      <column caption='% of CWs without a Trial' datatype='real' hidden='true' name='[Calculation_6826331197752209425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [IS_TRIAL] = 0 THEN [STORE_ACCOUNT_ID] END)/COUNTD([STORE_ACCOUNT_ID])' />
      </column>
      <column caption='Detrimental Inflation %' datatype='real' hidden='true' name='[Calculation_6826331197753061395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([HAS_DETRIMENTAL_INF])/COUNT([HAS_DETRIMENTAL_INF])' />
      </column>
      <column caption='First Product Line Item CWs' datatype='integer' hidden='true' name='[Calculation_6915347642817273856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [FIRST_PRODUCT_LINE_ITEM]&#10;in (&apos;Caviar Premier Package&apos;,&#10;&apos;Pickup Only Package&apos;,&#10;&apos;Self-Delivery - Basic Package&apos;,&#10;&apos;Self-Delivery - Premier Package&apos;,&#10;&apos;Self-Delivery Package&apos;)&#10;then [STORE_ACCOUNT_ID]&#10;end&#10;)' />
      </column>
      <column caption='Strategic Staffing YoY' datatype='real' name='[Calculation_6915347642895224878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD (copy)_4470104127756128291] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)&#10;/&#10;avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]: &#10;((sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [DAYS_OFF] end)&#10;)&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;) AND [YoY Curr QTD - HC (copy)_6915347642895757359] = TRUE THEN [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
      </column>
      <column caption='Total Org' datatype='string' name='[Calculation_6915347642917834844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if not isnull([Role (copy)_6915347642917625947]) then &apos;Total Org&apos; end' />
      </column>
      <column caption='IB VND Ads Goal' datatype='real' hidden='true' name='[Calculation_6957850336411131908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [WEEK_OF] &lt; date(&apos;2023-05-01&apos;) then 0 else 0.05&#10;end' />
      </column>
      <column caption='IS Regional Ads Actuals' datatype='real' hidden='true' name='[Calculation_6957850336413966354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*sum(case [Regional v Strategic v OS v IS]&#10;when &apos;IS Regional&apos; then ([IS_ADS])&#10;else 0 end) &#10;/&#10;countd(case [Regional v Strategic v OS v IS]&#10;when &apos;IS Regional&apos; then ([Account Id])&#10;else null end)&#10;*/&#10;&#10;sum(case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then ([IS_ADS])&#10;when &apos;OB aAE&apos; then ([IS_ADS])&#10;else 0 end) &#10;/&#10;countd(case [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then ([STORE_ACCOUNT_ID])&#10;when &apos;OB aAE&apos; then ([STORE_ACCOUNT_ID])&#10;else null end)' />

    <worksheet name='Selection: Tiers Activations'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Tiers 4-5 Activations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Top Mx Activations Pacing' datatype='real' name='[Calculation_4245346387502854149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([SP: Top Mx (copy)_4245346387502661635]/[SP: Top Mx Goal (copy)_4245346387502661636])' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Exclude this Week - Activations' datatype='boolean' name='[Exclude this Week (copy)_1819595047244206080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([MERCHANT_ACTIVATION_DATE])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column datatype='string' name='[INITIATIVE (Custom SQL Query2)]' role='dimension' type='nominal' />
            <column datatype='real' name='[INITIATIVE_GOAL (Custom SQL Query2)]' role='measure' type='quantitative' />
            <column caption='Activation Date' datatype='date' name='[MERCHANT_ACTIVATION_DATE]' role='dimension' type='ordinal' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='QTD (last full week) - Activations' datatype='boolean' name='[QTD (last full week) (copy)_1819595047244267521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Exclude this Week (copy)_1819595047244206080] = True then True&#10;end' />
            </column>
            <column caption='T4-5 Activations by Team' datatype='string' name='[ROLE_SP (Custom SQL Query2) (copy)_6190549589466468355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query2)] in (&apos;AE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;OB aAE&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SML&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;elseif [ROLE_SP (Custom SQL Query2)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;elseif REGEXP_MATCH([ROLE_SP (Custom SQL Query2)], &apos;Inbound VND&apos;) then &apos;IB Vendors&apos;&#10;end' />
            </column>
            <column datatype='string' name='[ROLE_SP (Custom SQL Query2)]' role='dimension' type='nominal' />
            <column caption='Top Mx Activations' datatype='integer' name='[SP: Top Mx (copy)_4245346387502661635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [TOP_MX] = true &#10;and isnull([MERCHANT_CLOSE_DATE])=false then [STORE_ID] end)' />
            </column>
            <column caption='Top Mx Activations Goal' datatype='real' name='[SP: Top Mx Goal (copy)_4245346387502661636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query2)] = &apos;Top Mx Activations&apos; then [INITIATIVE_GOAL (Custom SQL Query2)] end)' />
            </column>
            <column datatype='real' name='[STORE_ID]' role='measure' type='quantitative' />
            <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([TIER])' />
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column datatype='string' datatype-customized='true' name='[TIER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column datatype='boolean' name='[TOP_MX]' role='dimension' type='nominal' />
            <column caption='T4-5 Activations' datatype='integer' name='[Top Mx Activations (copy)_6190549589460205569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([TIER (copy)_4245346387496407042] = 4 or [TIER (copy)_4245346387496407042]=5) and  isnull([MERCHANT_ACTIVATION_DATE]) = False then [STORE_ID] end)' />
            </column>
            <column caption='T4-5 Activations Goal' datatype='real' name='[Top Mx Activations Goal (copy)_6190549589460205570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [INITIATIVE (Custom SQL Query2)] = &apos;T4-5 Activations&apos; then [INITIATIVE_GOAL (Custom SQL Query2)] end)' />
            </column>
            <column caption='T4-5 Activations Pacing' datatype='real' name='[Top Mx Activations Pacing (copy)_6190549589460205568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Top Mx Activations (copy)_6190549589460205569]/[Top Mx Activations Goal (copy)_6190549589460205570])' />
            </column>

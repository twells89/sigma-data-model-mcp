        <calculation class='tableau' formula='/*datediff(&apos;quarter&apos;, [Merchant Close Date], TODAY())=4 and [Merchant Close Date]&#10;&lt;= dateadd(&apos;year&apos;,-1,today())*/&#10;datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) - 13&#10;and&#10;quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today()) - 1&#10;and year([MERCHANT_CLOSE_DATE]) = year(TODAY())' />
      </column>
      <column caption='YoY: Prev YR QTD Q2' datatype='boolean' hidden='true' name='[YoY: Prev YR QTD (copy)_607845257020370963]' role='dimension' type='nominal'>

            <column caption='Regional Staffing' datatype='real' name='[Strategic Staffing (copy)_4591490232394051671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />

      <column caption='Signs Goal Toggle Calc excl SSMO' datatype='real' hidden='true' name='[Signs Goal Toggle Calc (copy)_4470104127787495511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then sum(&#10;if [ROLE] != &apos;Self Serve&apos; and [Last Week (copy)_5843842750852259863]&#10;then [CLOSES] end)&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then running_sum(sum(&#10;if [ROLE] != &apos;Self Serve&apos; and [Calculation_4334925757746180098]&#10;then [CLOSES] end))end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Signs Goal Toggle Calc - Progress' datatype='real' hidden='true' name='[Signs Goal Toggle Calc (copy)_5843842750851801110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(if [Parameters].[Parameter 7] = &apos;Last Week&apos; and [Last Week (copy)_5843842750852259863] = True&#10;then [CLOSES]&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; and [Calculation_4334925757746180098] = True&#10;then [CLOSES]&#10;end)' />
      </column>
      <column caption='Productivity QTD Avg' datatype='real' hidden='true' name='[Signs QTD Avg (copy)_4470104127793184864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_2307320765861478405] and [ROLE] != &apos;Self Serve&apos;&#10;then [STORE_ACCOUNT_ID] END)&#10; / &#10;&#10;(&#10;(&#10;    (&#10;        (sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([HC]) end) * &#10;        AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end))&#10;        - sum(if [YoY Curr QTD (copy)_4470104127756128291] then ([DAYS_OFF]) end)&#10;        )&#10;    / AVG(if [YoY Curr QTD (copy)_4470104127756128291] then ([WORKING_DAYS]) end)&#10;&#10;) &#10;)' />
      </column>
      <column caption='Signs Toggle Calc excl SSMO' datatype='integer' hidden='true' name='[Signs Toggle Calc (copy)_4470104127771701294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then &#10;countd(if [YoY Curr QTD (copy)_5843842750849249299] and [ROLE] != &apos;Self Serve&apos; then [STORE_ACCOUNT_ID] end)&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then &#10;&#10;countd(if [Calculation_2307320765861478405] and [ROLE] != &apos;Self Serve&apos; then [STORE_ACCOUNT_ID] end)&#10;end' />
      </column>
      <column caption='Signs Goal Toggle Calc' datatype='real' hidden='true' name='[Signs Toggle Calc (copy)_5843842750778810370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;Last Week&apos; then sum([CLOSES])&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; then running_sum(sum([CLOSES]))&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Signs Toggle Calc - Progress' datatype='integer' hidden='true' name='[Signs Toggle Calc (copy)_5843842750789283852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Parameters].[Parameter 7] = &apos;Last Week&apos; and [YoY Curr QTD (copy)_5843842750849249299] = True&#10;&#10;then [STORE_ACCOUNT_ID]&#10;&#10;elseif [Parameters].[Parameter 7] = &apos;QTD&apos; and [Calculation_4334925757746180098] = True&#10;then [STORE_ACCOUNT_ID]&#10;end)' />
      </column>
      <column caption='Signs Toggle Calc excl SSMO all' datatype='integer' hidden='true' name='[Signs Toggle Calc excl SSMO INB (copy)_4470104127778132032]' role='measure' type='quantitative'>

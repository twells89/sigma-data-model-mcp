            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column caption='Goals by Team' datatype='string' name='[Strategic v Regional v Vendor (copy)_6915347642917163098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [ROLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;CAN ML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN SML&apos; then &apos;CAN Outside&apos;&#10;when &apos;CAN AE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE&apos; then &apos;CAN Inside&apos;&#10;when &apos;CAN SAE (Top Mx)&apos; then &apos;CAN Inside&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
              <aliases>
                <alias key='&quot;US Strategic&quot;' value='Strategic' />

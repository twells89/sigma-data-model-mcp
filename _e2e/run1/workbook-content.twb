            <column caption='Vendors OB Staffing' datatype='real' name='[Regional Staffing (copy)_2310065177616936960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
            </column>

    <worksheet name='SMB Weekly UPDATED YoY Pacing'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Æ </run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontsize='9'>Y/Y Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='TAM excl last 2 weeks YoY' datatype='real' name='[Calculation_1538401536364507147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [WEEK_OF] &lt;= DATEADD(&apos;week&apos;, -3, TODAY()) = true and [Calculation_2307320765861478405] = true then [INCREMENTAL_SIGN_TAM] end)&#10;&#10;/&#10;&#10;sum(&#10;if [Calculation_2307320765864128521] = true &#10;and datepart(&apos;week&apos;,[WEEK_OF]) &lt;= datepart(&apos;week&apos;,DATEADD(&apos;week&apos;, -3, TODAY()))&#10;then [INCREMENTAL_SIGN_TAM]&#10;end)&#10;- 1' />
            </column>
            <column caption='YoY Curr QTD' datatype='boolean' name='[Calculation_2307320765861478405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//get week nums&#10;datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,today()))&#10;and quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;and year([MERCHANT_CLOSE_DATE]) = year(today())' />
            </column>
            <column caption='YoY: Prev YR QTD' datatype='boolean' name='[Calculation_2307320765864128521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*datediff(&apos;quarter&apos;, [Merchant Close Date], TODAY())=4 and [Merchant Close Date]&#10;&lt;= dateadd(&apos;year&apos;,-1,today())*/&#10;datepart(&apos;week&apos;,[MERCHANT_CLOSE_DATE]-1) &lt;= datepart(&apos;week&apos;,today()-1) and&#10;quarter([MERCHANT_CLOSE_DATE]) = QUARTER(today())&#10;and year([MERCHANT_CLOSE_DATE]) = year(today())-1&#10;and [OPP_TYPE] = &apos;Marketplace&apos;&#10;and [Calculation_6116099428441112578] in (&apos;Inbound VND&apos;, &apos;OS Strategic&apos;, &apos;IS Strategic&apos; , &apos;OS Regional&apos;, &apos;IS Regional&apos;, &apos;Outbound VND&apos;, &apos;SSMO&apos;)' />
            </column>
            <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='Strategic v Regional v Vendor' datatype='string' name='[Calculation_4591490232365199376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
            </column>
            <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_4863183911928840232]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_4863183911931142185]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_4863183911931179050]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_4863183911931199531]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Strategic v Regional (Current Role Title)' datatype='string' name='[Calculation_6116099428441112578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case &#10;(&#10;IFNULL(&#10;        (case&#10;        [OWNER_ROLE_OFFICIAL_TITLE]&#10;        when &quot;ML&quot; then &quot;OS Regional&quot;&#10;        when &quot;SML&quot; then &quot;OS Strategic&quot;&#10;        when &quot;GML&quot; then &quot;OS Regional&quot;&#10;        when &quot;aGML&quot; then &quot;OS Regional&quot;&#10;        when &quot;SGL&quot; then &quot;OS Strategic&quot;&#10;        When &quot;AE&quot; then &quot;IS Regional&quot;&#10;        when &quot;Blitz (AE)&quot; then &quot;IS Regional&quot;&#10;        when &quot;OB aAE&quot; then &quot;IS Regional&quot;&#10;        when &quot;SAE&quot; then &quot;IS Strategic&quot;&#10;        when &quot;SAE (Top Mx)&quot; then &quot;IS Strategic&quot;&#10;        when &quot;Self Serve&quot; then &quot;SSMO&quot;&#10;        when &quot;Formstack&quot; then &quot;SSMO&quot;&#10;        when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;        when &quot;OB Vendors - Regalix&quot; then &quot;Outbound VND&quot;&#10;&#9;&#9;when &quot;OB Vendors - MarketStar&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - Movate&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - Teleperformance&quot; then &quot;Outbound VND&quot;&#10;       when &quot;OB Vendors - Concentrix&quot; then &quot;Outbound VND&quot;&#10;        when &quot;OB Vendors - TaskUs&quot; then &quot;Outbound VND&quot;&#10;        when &quot;Inbound VND - Regalix&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Inbound VND - Teleperformance&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Inbound VND - TaskUs&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Concentrix&quot; then &quot;Inbound VND&quot;&#10;        when &quot;Team Lead- Outside Sales&quot; then &quot;OS Regional&quot;&#10;        end)&#10;    , [CW_OWNER_ROLE_OFFICIAL_TITLE])&#10;)&#10;when &quot;ML&quot; then &quot;OS Regional&quot;&#10;when &quot;SML&quot; then &quot;OS Strategic&quot;&#10;when &quot;SGL&quot; then &quot;OS Strategic&quot;&#10;when &quot;GML&quot; then &quot;OS Regional&quot;&#10;when &quot;aGML&quot; then &quot;OS Regional&quot;&#10;When &quot;AE&quot; then &quot;IS Regional&quot;&#10;When &quot;Blitz (AE)&quot; then &quot;IS Regional&quot;&#10;when &quot;OB aAE&quot; then &quot;IS Regional&quot;&#10;when &quot;SAE&quot; then &quot;IS Strategic&quot;&#10;when &quot;SAE (Top Mx)&quot; then &quot;IS Strategic&quot;&#10;when &quot;Self Serve&quot; then &quot;SSMO&quot;&#10;when &quot;Formstack&quot; then &quot;SSMO&quot;&#10;when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;when &quot;OB Vendors - Regalix&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Teleperformance&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - TaskUs&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - MarketStar&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Movate&quot; then &quot;Outbound VND&quot;&#10;when &quot;OB Vendors - Concentrix&quot; then &quot;Outbound VND&quot;&#10;when &quot;Inbound VND - Regalix&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Teleperformance&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - TaskUs&quot; then &quot;Inbound VND&quot;&#10;when &quot;Inbound VND - Concentrix&quot; then &quot;Inbound VND&quot;&#10;when &quot;OS Regional&quot; then &quot;OS Regional&quot;&#10;when &quot;IS Regional&quot; then &quot;IS Regional&quot;&#10;when &quot;OS Strategic&quot; then &quot;OS Strategic&quot;&#10;when &quot;IS Strategic&quot; then &quot;IS Strategic&quot;&#10;when &quot;SSMO&quot; then &quot;SSMO&quot;&#10;when &quot;Inbound VND&quot; then &quot;Inbound VND&quot;&#10;when &quot;Outbound VND&quot; then &quot;Outbound VND&quot;&#10;end' />
            </column>
            <column caption='(countd(if [YoY Curr QTD] = True then [ACCOUNT_ID] end) / cou...' datatype='real' name='[Calculation_6915347642883936274]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED YoY Pacing'>
              <calculation class='tableau' formula='(countd(if [Calculation_2307320765861478405] = True&#10; then [STORE_ACCOUNT_ID] end)&#10;/ countd(if [Calculation_2307320765864128521] = TRUE&#10; then [STORE_ACCOUNT_ID] end)) - 1' />

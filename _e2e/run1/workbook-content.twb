    <worksheet name='CW View Selection'>
      <layout-options>
        <title>
          <formatted-text>
            <run>CW Detail</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Account Name' datatype='string' name='[ACCOUNT_NAME]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='Opp URL' datatype='string' name='[Calculation_170784961179340851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [MERCHANT_CLOSE_DATE] &lt; DATE(2024-10-28) THEN&#10;&quot;https://figment.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;ELSE &quot;https://doordashmx.lightning.force.com/lightning/r/Opportunity/&quot; + [OPPORTUNITY_ID] + &quot;/view&quot;&#10;END' />
            </column>
            <column caption='Org - Top Mx Tracking' datatype='string' name='[Calculation_1755629837070975002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Team - Tier Tracking (copy)_4245346387490271233] in (&apos;Strategic&apos;, &apos;Regional&apos;, &apos;BD&apos;, &apos;OB Vendor&apos;) then &apos;Outbound Signs&apos; &#10;else &apos;Inbound + SSMO Signs&apos;&#10;end' />
            </column>
            <column caption='Team - Tier Activations Tracking' datatype='string' name='[Calculation_4245346387489398784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;,&apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Show/Hide' datatype='string' name='[Calculation_573927491580395521]' role='measure' type='nominal'>
              <calculation class='tableau' formula='If INDEX()&lt;=200&#10;then &apos;Show&apos;&#10;else &apos;Hide&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Top Mx' datatype='integer' name='[Calculation_6622965475636920323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [TOP_MX] = True then 1 else 0 END' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Is Holdout' datatype='integer' name='[IS_HOLDOUT]' role='measure' type='quantitative' />
            <column caption='Manager Name' datatype='string' name='[MANAGER_NAME]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[MARKET_MAKER]' role='dimension' type='nominal' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column caption='Opportunity Id' datatype='string' name='[OPPORTUNITY_ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='Primary Campaign Source' datatype='string' name='[PRIMARY_CAMPAIGN_SOURCE]' role='dimension' type='nominal' />
            <column datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='Role_SP_Copy' datatype='string' name='[ROLE_SP (Custom SQL Query)]' role='dimension' type='nominal' />
            <column datatype='string' name='[ROLE_SP]' role='dimension' type='nominal' />
            <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
              </aliases>
            </column>
            <column caption='SDR' datatype='string' name='[SDR_OWNER]' role='dimension' type='nominal' />
            <column caption='Commission Rate' datatype='real' name='[SFDC_COMMISSION]' role='measure' type='quantitative' />
            <column caption='Market Maker' datatype='integer' name='[SP: Top Mx (copy)_5850457434446196736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [MARKET_MAKER] = True then 1 else 0 END' />
            </column>
            <column caption='SP: Top Mx' datatype='integer' name='[SP: Whales (copy)_3215429439119798272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [TOP_MX] = true then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column caption='Submarket' datatype='string' name='[SUBMARKET]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([TIER])' />
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column datatype='string' datatype-customized='true' name='[TIER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Tier' />
              </aliases>
            </column>
            <column datatype='boolean' name='[TOP_MX]' role='dimension' type='nominal' />
            <column caption='Team - Top Mx Tracking' datatype='string' name='[Team - Tier Tracking (copy)_4245346387490271233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ROLE_SP] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;ELSEIF [ROLE_SP] = &apos;BD&apos; then &apos;BD&apos;&#10;else [ROLE_SP]&#10;end' />
            </column>
            <column caption='Week_SP_Copy' datatype='date' name='[WEEK_GOAL_SP (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column caption='Week Goal Sp' datatype='date' name='[WEEK_GOAL_SP]' role='dimension' type='ordinal' />
            <column caption='Week' datatype='date' datatype-customized='true' name='[WEEK_OF (Custom SQL Query3)]' role='dimension' type='ordinal' />
            <column caption='Week Of CW' datatype='date' name='[WEEK_OF]' role='dimension' type='ordinal' />
            <column-instance column='[ACCOUNT_NAME]' derivation='None' name='[none:ACCOUNT_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[CW_COUNTRY]' derivation='None' name='[none:CW_COUNTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_170784961179340851]' derivation='None' name='[none:Calculation_170784961179340851:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4591490232318570497]' derivation='None' name='[none:Calculation_4591490232318570497:nk]' pivot='key' type='nominal' />
            <column-instance column='[Cw Country (copy)_522769460683739155]' derivation='None' name='[none:Cw Country (copy)_522769460683739155:nk]' pivot='key' type='nominal' />
            <column-instance column='[DECK_RANK]' derivation='None' name='[none:DECK_RANK:nk]' pivot='key' type='nominal' />
            <column-instance column='[MANAGER_NAME]' derivation='None' name='[none:MANAGER_NAME:nk]' pivot='key' type='nominal' />

    <worksheet name='SMB Weekly UPDATED'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Æ </run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontsize='9'> QTD Actuals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
          </datasources>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cw Owner Role Official Title' datatype='string' name='[CW_OWNER_ROLE_OFFICIAL_TITLE]' role='dimension' type='nominal' />
            <column caption='TAM, excl last 2 weeks' datatype='real' name='[Calculation_1538401536361832451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [WEEK_OF] &lt;= DATEADD(&apos;week&apos;, -3, TODAY()) = true then [INCREMENTAL_SIGN_TAM] end)' />
            </column>
            <column caption='QTD (last full week)' datatype='boolean' name='[Calculation_3645452848303554638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_4591490232371261484] = True then True&#10;end' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Temp Filter (Virtual Brand)' datatype='string' name='[Calculation_3884143598579994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SALES_OWNER] in (&apos;Ivory Mae Montecillo&apos;&#10;                        , &apos;Ivory Montecillo&apos;&#10;                        , &apos;Jamaica Lambunao&apos;&#10;                        , &apos;Caleb Rivera&apos;&#10;                        , &apos;Christian Marquez&apos;&#10;                        , &apos;Irah Manalang&apos;&#10;                        , &apos;Jerome Noquiao&apos;&#10;                        , &apos;Rienel Acierto&apos;&#10;                        , &apos;Aldwin Clark Albaladejo&apos;&#10;                        , &apos;Erika Tanya De Leon&apos;&#10;                        , &apos;Gerkin Charles Viray&apos;&#10;                        , &apos;Engeline Suba&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;elseif [SALES_OWNER] = &apos;Shane Mejia&apos; and [MERCHANT_CLOSE_DATE] &gt;= date(&apos;2025-04-14&apos;)&#10;&#9;then &apos;Virtual Brand&apos; &#10;else &apos;Include&apos;&#10;End' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Strategic v Regional v Vendor' datatype='string' name='[Calculation_4591490232365199376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [CW_OWNER_ROLE_OFFICIAL_TITLE]&#10;when &apos;AE&apos; then &apos;Regional&apos;&#10;when &apos;Blitz (AE)&apos; then &apos;Regional&apos;&#10;when &apos;OB aAE&apos; then &apos;Regional&apos;&#10;when &apos;ML&apos; then &apos;Regional&apos;&#10;when &apos;GML&apos; then &apos;Regional&apos;&#10;when &apos;aGML&apos; then &apos;Regional&apos;&#10;when &apos;SML&apos; then &apos;Strategic&apos;&#10;when &apos;SAE&apos; then &apos;Strategic&apos;&#10;when &apos;SAE (Top Mx)&apos; then &apos;Strategic&apos;&#10;when &apos;SGL&apos; then &apos;Strategic&apos;&#10;when &apos;Strategic Inbound&apos; then &apos;Strategic&apos;&#10;when &apos;Inbound VND - TaskUs&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Teleperformance&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Concentrix&apos; then &apos;Vendor IB&apos;&#10;when &apos;Inbound VND - Regalix&apos; then &apos;Vendor IB&apos;&#10;when &apos;OB Vendors - Regalix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - MarketStar&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - TaskUs&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Concentrix&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Teleperformance&apos; then &apos;Vendor OB&apos;&#10;when &apos;OB Vendors - Movate&apos; then &apos;Vendor OB&apos;&#10;when &apos;Self Serve&apos; then &apos;SSMO&apos;&#10;end' />
            </column>
            <column caption='countd(if [Deck Rank] = &apos;Ace&apos; then [ACCOUNT_ID] end)' datatype='integer' name='[Calculation_4591490232366718997]' role='measure' type='quantitative' user:unnamed='Sheet 71'>
              <calculation class='tableau' formula='countd(if [DECK_RANK] = &apos;Ace&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Regional&apos; then [...' datatype='integer' name='[Calculation_4591490232367271958]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Regional&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Strategic&apos; then ...' datatype='integer' name='[Calculation_4591490232367312920]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Strategic&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Vendor OB&apos; then ...' datatype='integer' name='[Calculation_4591490232367542300]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor OB&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;Vendor IB&apos; then ...' datatype='integer' name='[Calculation_4591490232367599646]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;Vendor IB&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='countd(if [Strategic v Regional v Vendor] = &apos;SSMO&apos; then [ACCO...' datatype='integer' name='[Calculation_4591490232367620128]' role='measure' type='quantitative' user:unnamed='SMB Weekly UPDATED'>
              <calculation class='tableau' formula='countd(if [Calculation_4591490232365199376] = &apos;SSMO&apos; then [STORE_ACCOUNT_ID] end)' />
            </column>
            <column caption='Exclude this Week' datatype='boolean' name='[Calculation_4591490232371261484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datepart(&apos;week&apos;,([WEEK_OF (Custom SQL Query3)])) &lt; (datepart(&apos;week&apos;,date(today())))' />
            </column>
            <column caption='Strategic Staffing' datatype='real' name='[Calculation_4591490232373194802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;SML&apos;, &apos;SAE&apos;, &apos;SAE (Top Mx)&apos;, &apos;SGL&apos;, &apos;Strategic Inbound&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Holdout Signs' datatype='integer' name='[Calculation_5359283586570813441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [IS_HOLDOUT] = 1 then [STORE_ACCOUNT_ID] else null end)' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Days Off' datatype='real' name='[DAYS_OFF]' role='measure' type='quantitative' />
            <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
            <column datatype='real' name='[HC]' role='measure' type='quantitative' />
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Is Holdout' datatype='integer' name='[IS_HOLDOUT]' role='measure' type='quantitative' />
            <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
            <column caption='Vendors IB Staffing' datatype='real' name='[OB Vendors Staffing (copy)_2310065177617342465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;Inbound VND - Teleperformance&apos;, &apos;Inbound VND - TaskUs&apos;, &apos;Inbound VND - Concentrix&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
            </column>
            <column caption='Exclude SSMO Drive CWs' datatype='string' name='[OPP_TYPE (copy)_6587429269050871809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;Self Serve&apos; or [CW_OWNER_ROLE_OFFICIAL_TITLE] = &apos;SSMO&apos;)&#10;and [OPP_TYPE] = &apos;DoorDash Drive&apos; &#10;then &apos;null&apos;&#10;else &apos;Exclude SSMO Drive&apos;&#10;end' />
            </column>
            <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
            <column caption='Role ' datatype='string' name='[OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]' role='dimension' type='nominal' />
            <column datatype='string' name='[REP_SEGMENT]' role='dimension' type='nominal' />
            <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
            <column caption='Vendors OB Staffing' datatype='real' name='[Regional Staffing (copy)_2310065177616936960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;OB Vendors - Regalix&apos;, &apos;OB Vendors - Teleperformance&apos;, &apos;OB Vendors - Concentrix&apos;, &apos;OB Vendors - TaskUs&apos;, &apos;OB Vendors - MarketStar&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
            </column>
            <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
              </aliases>
            </column>
            <column caption='ACCOUNT_ID' datatype='string' name='[STORE_ACCOUNT_ID]' role='dimension' type='nominal' />
            <column caption='Regional Staffing' datatype='real' name='[Strategic Staffing (copy)_4591490232394051671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ fixed [WEEK_OF (PRESALES_ACTIVE_HC)] :&#10;sum(&#10;({fixed [WEEK_OF (PRESALES_ACTIVE_HC)], [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)]:&#10;(&#10;(sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;)&#10; then [HC] end)&#10;*avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end))&#10;-&#10;&#10;sum(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [DAYS_OFF] end)&#10;)&#10;&#10;/&#10;&#10;avg(if [OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)] in (&apos;ML&apos;, &apos;AE&apos;, &apos;OB aAE&apos;, &apos;GML&apos;, &apos;Blitz (AE)&apos;, &apos;aGML&apos;) then [WORKING_DAYS] end)&#10;}&#10;))&#10;}&#10;)' />
            </column>

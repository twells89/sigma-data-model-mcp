            <column caption='Jack - Signs by Deck Rank' datatype='real' name='[Unranked - Signs by Deck Rank (copy)_1829939221928534025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(if [Deck Rank] = &apos;Ace&apos; then [Deck Rank Param Calc] else 0 end)&#10;&#10;&#10;//if [Deck Rank Signs vs % Param] = &apos;Total Signs&apos;&#10;      //  then [Account Id]&#10;&#10;IF [Parameters].[Parameter 10] = &apos;% of Signs&apos; THEN&#10;    -(&#10;        COUNTD(&#10;            IF [DECK_RANK] = &apos;Jack&apos;&#10;            THEN [STORE_ACCOUNT_ID] &#10;            END&#10;        )&#10;        / [Calculation_3783938539825639424]&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Total Signs&apos; THEN&#10;    COUNTD(&#10;        IF  [DECK_RANK] = &apos;Jack&apos;&#10;        THEN [STORE_ACCOUNT_ID] &#10;        END&#10;    )&#10;END' />

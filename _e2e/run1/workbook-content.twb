    <dashboard name='Selection Strategy'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='9'>Click on a cell in any of the tables to filter the CW Detail at the bottom</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='8' italic='true'>If you are missing CWs due to the sales roster, please reach out to the Data Infrastructure team (Bhanuprakash Nallabothula) directly. </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://REDACTED_INTERNAL_HOST/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard/SelectionStrategy?rev=' id='SelectionStrategy' path='/t/DoorDash/workbooks/DDMXPre-SalesWeeklyOKRDashboard' revision='' site='DoorDash' />
      <style />
      <size maxheight='5500' maxwidth='1500' minheight='5500' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Selection Param' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;Signs&quot;'>
          <calculation class='tableau' formula='&quot;Signs&quot;' />
          <members>
            <member value='&quot;Signs&quot;' />
            <member value='&quot;TAM&quot;' />
            <member value='&quot;TAM per Sign&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
        <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Team - Tier Activations Tracking' datatype='string' name='[Calculation_4245346387489398784]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [ROLE_SP (Custom SQL Query)] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;,&apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP (Custom SQL Query)] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP (Custom SQL Query)], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;end' />
        </column>
        <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
        </column>
        <column caption='Deck Rank' datatype='string' name='[DECK_RANK]' role='dimension' type='nominal' />
        <column caption='Is Holdout' datatype='integer' name='[IS_HOLDOUT]' role='measure' type='quantitative' />
        <column caption='Manager Name' datatype='string' name='[MANAGER_NAME]' role='dimension' type='nominal' />
        <column datatype='boolean' name='[MARKET_MAKER]' role='dimension' type='nominal' />
        <column caption='Merchant Close Date' datatype='date' name='[MERCHANT_CLOSE_DATE]' role='dimension' type='ordinal' />
        <column caption='Opportunity Id' datatype='string' name='[OPPORTUNITY_ID]' role='dimension' type='nominal' />
        <column datatype='string' name='[OPP_TYPE]' role='dimension' type='nominal' />
        <column caption='Primary Campaign Source' datatype='string' name='[PRIMARY_CAMPAIGN_SOURCE]' role='dimension' type='nominal' />
        <column caption='QTD (last full week) - Top Mx' datatype='boolean' name='[QTD (last full week) (copy)_138767215421173763]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
        </column>
        <column caption='QTD (last full week) - Tiers' datatype='boolean' name='[QTD (last full week) - Top Mx (copy)_138767215421968388]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(today()))) = True then True&#10;end' />
        </column>
        <column caption='Role' datatype='string' name='[ROLE]' role='dimension' type='nominal' />
        <column caption='Sales Owner' datatype='string' name='[SALES_OWNER]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Formstack Integration User&quot;' value='Nintex' />
          </aliases>
        </column>
        <column caption='Team' datatype='string' name='[TEAM]' role='dimension' type='nominal' />
        <column caption='Tier ' datatype='integer' datatype-customized='true' name='[TIER (copy)_4245346387496407042]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='INT([TIER])' />
          <aliases>
            <alias key='%null%' value='No Tier' />
          </aliases>
        </column>
        <column datatype='boolean' name='[TOP_MX]' role='dimension' type='nominal' />
        <column caption='Team - Top Mx Tracking' datatype='string' name='[Team - Tier Tracking (copy)_4245346387490271233]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [ROLE_SP] in (&apos;SGL&apos;, &apos;SAE&apos;, &apos;SML&apos;, &apos;SAE (Top Mx)&apos;, &apos;Top Gun (ML)&apos;, &apos;Strategic Inbound&apos;) then &apos;Strategic&apos;&#10;ELSEIF [ROLE_SP] in (&apos;AE&apos;, &apos;OB aAE&apos;, &apos;ML&apos;, &apos;GML&apos;, &apos;aGML&apos;, &apos;Blitz (AE)&apos;) then &apos;Regional&apos;&#10;ELSEIF [ROLE_SP] in (&apos;Self Serve&apos;) then &apos;Self Serve&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;Inbound VND&apos;) then &apos;IB Vendor&apos;&#10;ELSEIF REGEXP_MATCH([ROLE_SP], &apos;OB Vendor&apos;) then &apos;OB Vendor&apos;&#10;ELSEIF [ROLE_SP] = &apos;BD&apos; then &apos;BD&apos;&#10;else [ROLE_SP]&#10;end' />
        </column>
        <column caption='Week_SP_Copy' datatype='date' name='[WEEK_GOAL_SP (Custom SQL Query)]' role='dimension' type='ordinal' />
        <column caption='Week Goal Sp' datatype='date' name='[WEEK_GOAL_SP]' role='dimension' type='ordinal' />
        <column-instance column='[CW_COUNTRY]' derivation='None' name='[none:CW_COUNTRY:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_4245346387489398784]' derivation='None' name='[none:Calculation_4245346387489398784:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_4591490232318570497]' derivation='None' name='[none:Calculation_4591490232318570497:nk]' pivot='key' type='nominal' />
        <column-instance column='[DECK_RANK]' derivation='None' name='[none:DECK_RANK:nk]' pivot='key' type='nominal' />
        <column-instance column='[MANAGER_NAME]' derivation='None' name='[none:MANAGER_NAME:nk]' pivot='key' type='nominal' />
        <column-instance column='[MARKET_MAKER]' derivation='None' name='[none:MARKET_MAKER:nk]' pivot='key' type='nominal' />
        <column-instance column='[MERCHANT_CLOSE_DATE]' derivation='None' name='[none:MERCHANT_CLOSE_DATE:ok]' pivot='key' type='ordinal' />
        <column-instance column='[OPPORTUNITY_ID]' derivation='None' name='[none:OPPORTUNITY_ID:nk]' pivot='key' type='nominal' />
        <column-instance column='[OPP_TYPE]' derivation='None' name='[none:OPP_TYPE:nk]' pivot='key' type='nominal' />
        <column-instance column='[PRIMARY_CAMPAIGN_SOURCE]' derivation='None' name='[none:PRIMARY_CAMPAIGN_SOURCE:nk]' pivot='key' type='nominal' />
        <column-instance column='[QTD (last full week) (copy)_138767215421173763]' derivation='None' name='[none:QTD (last full week) (copy)_138767215421173763:nk]' pivot='key' type='nominal' />
        <column-instance column='[QTD (last full week) - Top Mx (copy)_138767215421968388]' derivation='None' name='[none:QTD (last full week) - Top Mx (copy)_138767215421968388:nk]' pivot='key' type='nominal' />
        <column-instance column='[ROLE]' derivation='None' name='[none:ROLE:nk]' pivot='key' type='nominal' />
        <column-instance column='[SALES_OWNER]' derivation='None' name='[none:SALES_OWNER:nk]' pivot='key' type='nominal' />
        <column-instance column='[TEAM]' derivation='None' name='[none:TEAM:nk]' pivot='key' type='nominal' />
        <column-instance column='[TOP_MX]' derivation='None' name='[none:TOP_MX:nk]' pivot='key' type='nominal' />
        <column-instance column='[Team - Tier Tracking (copy)_4245346387490271233]' derivation='None' name='[none:Team - Tier Tracking (copy)_4245346387490271233:nk]' pivot='key' type='nominal' />
        <column-instance column='[IS_HOLDOUT]' derivation='Sum' name='[sum:IS_HOLDOUT:qk]' pivot='key' type='quantitative' />
        <column-instance column='[TIER (copy)_4245346387496407042]' derivation='Sum' name='[sum:TIER (copy)_4245346387496407042:qk]' pivot='key' type='quantitative' />
        <column-instance column='[WEEK_GOAL_SP (Custom SQL Query)]' derivation='Quarter-Trunc' name='[tqr:WEEK_GOAL_SP (Custom SQL Query):ok]' pivot='key' type='ordinal' />
        <column-instance column='[WEEK_GOAL_SP]' derivation='Quarter-Trunc' name='[tqr:WEEK_GOAL_SP:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>

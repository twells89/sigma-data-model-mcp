    <worksheet name='Canada: Total Org Medal'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&#10;Canada: Total Org</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PRESALES_CW_LEVEL (TABLEAU.PRESALES_CW_LEVEL) (TABLEAU)' name='federated.1d44dls1qne6m411a222e1j5w12c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Deck Rank Signs vs % Param' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Signs&quot;'>
              <calculation class='tableau' formula='&quot;% of Signs&quot;' />
            </column>
            <column caption='CAN Switch Medals and Tiers PARAM' datatype='string' name='[Parameter 18]' param-domain-type='list' role='measure' type='nominal' value='&quot;Medal Rank&quot;'>
              <calculation class='tableau' formula='&quot;Medal Rank&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d44dls1qne6m411a222e1j5w12c'>
            <column caption='Account Name' datatype='string' name='[ACCOUNT_NAME]' role='dimension' type='nominal' />
            <column caption='CAN Special Roles' datatype='string' name='[CAN SPECIAL ROLES]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[FULL_NAME]' default='&quot;Normal Roles&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;BDE&quot;'>
                  <value>&quot;PERSON_051&quot;</value>
                  <value>&quot;PERSON_069&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;REDACTED_ACCOUNT_1&quot;'>
                  <value>&quot;Matt Lang&quot;</value>
                  <value>&quot;Min Ma&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Top Mx&quot;'>
                  <value>&quot;Jessica Zhai&quot;</value>
                  <value>&quot;Royal Abedin&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Signs - Goal' datatype='real' datatype-customized='true' name='[CLOSES]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CW Country' datatype='string' name='[CW_COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='CAN Switch Medals and Tiers FILTER' datatype='string' name='[Calculation_1252141487249985553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 18]' />
            </column>
            <column caption='Signs - Actuals' datatype='integer' default-format='*#,##0; -#,##0;&quot;&quot;' name='[Calculation_3783938539825639424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    [STORE_ACCOUNT_ID]&#10;)' />
            </column>
            <column caption='Signs Pacing' datatype='real' name='[Calculation_3783938539829059585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3783938539825639424])/round(SUM([CLOSES]),0)' />
            </column>
            <column caption='Quarter of CW FILTER' datatype='string' name='[Calculation_4591490232318570497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(YEAR([WEEK_OF (Custom SQL Query3)]))+&quot;-Q&quot;+str(QUARTER([WEEK_OF (Custom SQL Query3)]))' />
            </column>
            <column caption='Combined Country' datatype='string' name='[Calculation_522769460686950421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([COUNTRY],&apos;Null&apos;)+ifnull([CW_COUNTRY],&apos;Null&apos;)' />
            </column>
            <column caption='Canada roles' datatype='string' name='[Calculation_5837439233833500672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([CW_COUNTRY])+([ROLE])' />
            </column>
            <column caption='Clean Combined Country' datatype='string' name='[Cw Country (copy)_522769460683739155]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='//contcatenatoin of goal country and presales_cw_level country&#10;case [Calculation_522769460686950421]&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;when &apos;CanadaCanada&apos; then &apos;Canada&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;Canada&apos;&#10;when &apos;NullCanada&apos; then &apos;Canada&apos;&#10;when &apos;CanadaNull&apos; then &apos;Canada&apos;&#10;//when &apos;CanadaUnited States&apos; then &apos;United States&apos;&#10;when &apos;United StatesNull&apos; then &apos;United States&apos;&#10;when &apos;United StatesUnited States&apos; then &apos;United States&apos;&#10;//when &apos;NullUnited States&apos; then &apos;United States&apos;&#10;//when &apos;United StatesCanada&apos; then &apos;United States&apos;&#10;else &apos;United States&apos;&#10;end' />
            </column>
            <column caption='Medal Rank: Bronze Calc' datatype='real' name='[Deck Rank Param Calc (copy)_1252141487239774209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [MEDAL_RANK] = &apos;Bronze&apos;&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [MEDAL_RANK] = &apos;Bronze&apos;&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Full Name' datatype='string' name='[FULL_NAME]' role='dimension' type='nominal' />
            <column caption='TAM' datatype='real' name='[INCREMENTAL_SIGN_TAM]' role='measure' type='quantitative' />
            <column caption='Medal Rank' datatype='string' name='[MEDAL_RANK]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;bronze&quot;' value='Bronze' />
                <alias key='&quot;gold&quot;' value='Gold' />
                <alias key='&quot;platinum&quot;' value='Platinum' />
                <alias key='&quot;silver&quot;' value='Silver' />
                <alias key='&quot;tin&quot;' value='Tin' />
              </aliases>
            </column>
            <column caption='Medal Rank: Gold Calc' datatype='real' name='[Medal Rank: Bronze Calc (copy) (copy)_1252141487242088454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [MEDAL_RANK] = &apos;Gold&apos;&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [MEDAL_RANK] = &apos;Gold&apos;&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Medal Rank: Silver Calc' datatype='real' name='[Medal Rank: Bronze Calc (copy)_1252141487242072069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [MEDAL_RANK] = &apos;Silver&apos;&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [MEDAL_RANK] = &apos;Silver&apos;&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Medal Rank: Tin Calc' datatype='real' name='[Medal Rank: Silver Calc (copy) (copy)_1252141487242268680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [MEDAL_RANK] = &apos;Tin&apos;&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [MEDAL_RANK] = &apos;Tin&apos;&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Medal Rank: Platinum Calc' datatype='real' name='[Medal Rank: Silver Calc (copy)_1252141487242256391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and [MEDAL_RANK] = &apos;Platinum&apos;&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and [MEDAL_RANK] = &apos;Platinum&apos;&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>
            <column caption='Medal Rank: Null' datatype='real' name='[Medal Rank: Tin Calc (copy)_1252141487244546057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;case [CAN Tier Signs vs % Param]&#10;when &quot;Total Signs&quot; then [Signs - Actuals]&#10;when &quot;% of Signs&quot; then [Signs - Actuals]/window_sum([Signs - Actuals])&#10;end&#10;*/&#10;&#10;(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; then&#10;-(countd(if [Parameters].[Parameter 10] = &apos;% of Signs&apos; and isnull([MEDAL_RANK])&#10;        then [STORE_ACCOUNT_ID] end)&#10;/ COUNTD([STORE_ACCOUNT_ID]))&#10;&#10;elseif [Parameters].[Parameter 10] = &apos;Total Signs&apos; then&#10;countd(if [Parameters].[Parameter 10] = &apos;Total Signs&apos; and isnull([MEDAL_RANK])&#10;then [STORE_ACCOUNT_ID] end)&#10;end)' />
            </column>

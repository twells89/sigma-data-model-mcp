      <column caption='YoY Storefront Attach' datatype='real' hidden='true' name='[YoY Commission Rate - Outbound (copy)_833799264835051542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//curr year&#10;(&#10;(sum((if [YoY Curr QTD (copy)_607845257019625490] then ([IS_STOREFRONT]) end)) / countd((if [YoY Curr QTD (copy)_607845257019625490] then ([STORE_ACCOUNT_ID]) end)))&#10;-&#10;(sum((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([IS_STOREFRONT]) end)) / countd((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([STORE_ACCOUNT_ID]) end)))&#10;)&#10;&#10;/&#10;&#10;(sum((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([IS_STOREFRONT]) end)) / countd((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([STORE_ACCOUNT_ID]) end)))' />
      </column>
      <column caption='YoY Curr QTD - HC' datatype='boolean' name='[YoY Curr QTD (copy)_4470104127756128291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//get week nums&#10;datepart(&apos;week&apos;,([WEEK_OF (PRESALES_ACTIVE_HC)])) &lt; (datepart(&apos;week&apos;,date(today())))&#10;and quarter([WEEK_OF (PRESALES_ACTIVE_HC)]) = QUARTER(today())&#10;and year([WEEK_OF (PRESALES_ACTIVE_HC)]) = year(TODAY())' />
      </column>
      <column caption='Last Week' datatype='boolean' hidden='true' name='[YoY Curr QTD (copy)_5843842750849249299]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) = (datepart(&apos;week&apos;,date(today()))) - 1&#10;and&#10;datepart(&apos;quarter&apos;,([MERCHANT_CLOSE_DATE])) = (datepart(&apos;quarter&apos;,date(today()))) &#10;and &#10;datepart(&apos;year&apos;,([MERCHANT_CLOSE_DATE])) = (datepart(&apos;year&apos;,date(today())))' />
      </column>
      <column caption='YoY Curr QTD Q2' datatype='boolean' hidden='true' name='[YoY Curr QTD (copy)_607845257019625490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//get week nums&#10;datepart(&apos;week&apos;,([MERCHANT_CLOSE_DATE])) &lt; (datepart(&apos;week&apos;,date(&apos;2023-06-30&apos;)))&#10;and quarter([MERCHANT_CLOSE_DATE]) = QUARTER(date(&apos;2023-06-30&apos;))&#10;and year([MERCHANT_CLOSE_DATE]) = year(date(&apos;2023-06-30&apos;))' />
      </column>
      <column caption='YoY Prev QTD - HC' datatype='boolean' name='[YoY Curr QTD - HC (copy)_6915347642895757359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//get week nums&#10;datepart(&apos;week&apos;,([WEEK_OF (PRESALES_ACTIVE_HC)]), &apos;monday&apos;) &lt;= (datepart(&apos;week&apos;,date(today()), &apos;monday&apos;)) and&#10;quarter([WEEK_OF (PRESALES_ACTIVE_HC)]) = QUARTER(today())&#10;and year([WEEK_OF (PRESALES_ACTIVE_HC)]) = year(TODAY())-1' />
      </column>
      <column caption='YoY Pickup Attach' datatype='real' hidden='true' name='[YoY Dashpass Attach (copy)_833799264839712793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//curr year&#10;(&#10;(sum((if [YoY Curr QTD (copy)_607845257019625490] then ([IS_PICKUP]) end)) / countd((if [YoY Curr QTD (copy)_607845257019625490] then ([STORE_ACCOUNT_ID]) end)))&#10;-&#10;(sum((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([IS_PICKUP]) end)) / countd((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([STORE_ACCOUNT_ID]) end)))&#10;)&#10;&#10;/&#10;&#10;(sum((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([IS_PICKUP]) end)) / countd((if [YoY: Prev YR QTD (copy)_607845257020370963] then ([STORE_ACCOUNT_ID]) end)))' />
      </column>

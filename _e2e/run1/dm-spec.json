        {
          "id": "C0YOkXtaNW",
          "name": "presales_cw_level",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "kind": "sql",
            "statement": "WITH __f AS (\nselect \nMERCHANT_CLOSE_DATE,\nWEEK_OF,\nCW_WEEK,\nQTR,\nYR,\nQTR_YR,\nREADINESS_CHECK_COMPLETE_DATE,\nMERCHANT_ACTIVATION_DATE,\nMX_ONBOARDING_LINK_SENT_DATE,\nOPPORTUNITY_ID,\nSTORE_ACCOUNT_ID,\nBUSINESS_ACCOUNT_ID,\nLEAD_ID,\nWORK_ORDER_ID,\nWORK_ORDER_NUMBER,\nSTORE_ID,\nBUSINESS_ID,\nPROVISIONING_STATUS,\nSALES_OWNER_ID,\nSALES_OWNER,\nFULL_NAME,\nMANAGER_NAME,\nREP_ROLE,\nOWNER_TEAM,\nOWNER_ORG_FOCUS,\nREP_SEGMENT,\nSDR_OWNER,\nSDR_ID,\nSDR_MANAGER_ID,\nSDR_MANAGER_NAME,\nSDR_ROLE,\nSDR_COUNTRY,\nREP_COUNTRY,\nCW_COUNTRY,\nCLEAN_COUNTRY,\nOWNER_ROLE_OFFICIAL_TITLE,\nCW_OWNER_ROLE_OFFICIAL_TITLE,\nSFDC_COMMISSION,\nDASHPASS_COMMISSION,\nNARR,\nOPPORTUNITY_NAME,\nOPP_TYPE,\nACCOUNT_NAME,\nSTORE_NAME,\nBUSINESS_NAME,\nDECK_RANK,\nPRIMARY_VERTICAL,\nCOUNTRY,\nSTARTING_POINT_ID,\nSTARTING_POINT,\nSUBMARKET,\nSUBMARKET_ID,\nTOP_MX,\nMARKET_MAKER,\nIS_GNC,\nIS_DASHPASS,\nIS_PICKUP,\nIS_STOREFRONT,\nIS_ALCOHOL,\nIS_TRIAL,\nIS_PROMO,\nIS_ADS,\nIS_ADS_PROMOS,\nPACKAGE_SOLD,\nNTAM,\nINCREMENTAL_SIGN_TAM,\nHISTORICAL_DELAY_REASONS_CUSTOMIZED,\nLEAD_LIST_CUSTOMIZED,\nTRIAL_PERIOD,\nTOP_MX_SIGNING_BONUS_APPROVAL_THRESHOLD,\nACTIVATION_BONUS_AMOUNT,\nPRODUCT_LIST,\nREGION,\nTIER,\nSFDC_SOURCE,\nLAST_ETL_RUN\nfrom REDACTED_DB.static.presales_cw_level\n),\n__s0 AS (\n  SELECT\n    \"ROLE_ACTIVATIONS\" AS \"ROLE_ACTIVATIONS\",\n    \"COUNTRY\" AS \"COUNTRY\",\n    MAX(\"WEEK_GOAL_ACTIVATIONS\") AS \"WEEK_GOAL_ACTIVATIONS\",\n    SUM(\"ACTIVATION_GOAL\") AS \"ACTIVATION_GOAL\",\n    MAX(\"QUARTER_YEAR\") AS \"QUARTER_YEAR\"\n  FROM (\nSELECT *\nFROM REDACTED_DB.static.activations_goals_presales \"ACTIVATIONS_GOALS_PRESALES\"\n) \"__src_0\"\n  GROUP BY \"ROLE_ACTIVATIONS\", \"COUNTRY\"\n),\n__s1 AS (\n  SELECT\n    \"OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)\" AS \"OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)\",\n    \"QTR_YR (PRESALES_ACTIVE_HC)\" AS \"QTR_YR (PRESALES_ACTIVE_HC)\",\n    MAX(\"COUNTRY (PRESALES_ACTIVE_HC)\") AS \"COUNTRY (PRESALES_ACTIVE_HC)\",\n    SUM(\"DAYS_OFF\") AS \"DAYS_OFF\",\n    SUM(\"HC\") AS \"HC\",\n    MAX(\"QTR (PRESALES_ACTIVE_HC)\") AS \"QTR (PRESALES_ACTIVE_HC)\",\n    MAX(\"REP_RANK\") AS \"REP_RANK\",\n    MAX(\"SALES_MANAGER\") AS \"SALES_MANAGER\",\n    MAX(\"SALES_OWNER (PRESALES_ACTIVE_HC)\") AS \"SALES_OWNER (PRESALES_ACTIVE_HC)\",\n    MAX(\"USER_ID\") AS \"USER_ID\",\n    MAX(\"WEEK_OF (PRESALES_ACTIVE_HC)\") AS \"WEEK_OF (PRESALES_ACTIVE_HC)\",\n    SUM(\"YR (PRESALES_ACTIVE_HC)\") AS \"YR (PRESALES_ACTIVE_HC)\"\n  FROM (\nwith final as (\nselect \n    case \n        when rep_segment = 'CAN SMB Sales' then 'Canada' \n        when rep_segment not in ('AUS SMB Sales','CAN SMB Sales','NZ SMB Sales','ANZ SMB Sales') then 'United States' \n        else null \n    end as country, \n    days_off,\n    days_worked/iff(working_days=0,null,working_days) as hc,\n    role_title as OWNER_ROLE_OFFICIAL_TITLE,\n    'Q'||quarter(to_date(week)) as qtr,\n        year(to_date(week)) as yr,\n        qtr||'-'||right(yr,2) as qtr_yr,\n    null as rep_rank,\n    null as SALES_MANAGER,\n    rep_name as sales_owner,\n    ddmx_id as user_id,\n    week as week_of\nfrom REDACTED_DB.public.sales_analytics_bis\nwhere country is not null\n)\nSELECT \"PRESALES_ACTIVE_HC\".\"COUNTRY\" AS \"COUNTRY (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"DAYS_OFF\" AS \"DAYS_OFF\",\n  \"PRESALES_ACTIVE_HC\".\"HC\" AS \"HC\",\n  \"PRESALES_ACTIVE_HC\".\"OWNER_ROLE_OFFICIAL_TITLE\" AS \"OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"QTR\" AS \"QTR (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"QTR_YR\" AS \"QTR_YR (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"REP_RANK\" AS \"REP_RANK\",\n  \"PRESALES_ACTIVE_HC\".\"SALES_MANAGER\" AS \"SALES_MANAGER\",\n  \"PRESALES_ACTIVE_HC\".\"SALES_OWNER\" AS \"SALES_OWNER (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"USER_ID\" AS \"USER_ID\",\n  \"PRESALES_ACTIVE_HC\".\"WEEK_OF\" AS \"WEEK_OF (PRESALES_ACTIVE_HC)\",\n  \"PRESALES_ACTIVE_HC\".\"YR\" AS \"YR (PRESALES_ACTIVE_HC)\"\nFROM final \"PRESALES_ACTIVE_HC\"\n) \"__src_1\"\n  GROUP BY \"OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)\", \"QTR_YR (PRESALES_ACTIVE_HC)\"\n),\n__s2 AS (\n  SELECT\n    \"WEEK_GOAL\" AS \"WEEK_GOAL\",\n    \"ROLE (PRESALE_PRODUCT_GOALS)\" AS \"ROLE (PRESALE_PRODUCT_GOALS)\",\n    MAX(\"BASED\") AS \"BASED\",\n    MAX(\"ORG\") AS \"ORG\",\n    MAX(\"PRODUCT\") AS \"PRODUCT\",\n    SUM(\"PRODUCT_GOAL\") AS \"PRODUCT_GOAL\",\n    MAX(\"QTR_YR_PG\") AS \"QTR_YR_PG\",\n    MAX(\"TARGET\") AS \"TARGET\",\n    MAX(\"TEAM\") AS \"TEAM\"\n  FROM (\nSELECT \"PRESALE_PRODUCT_GOALS\".\"BASED\" AS \"BASED\",\n  \"PRESALE_PRODUCT_GOALS\".\"ORG\" AS \"ORG\",\n  \"PRESALE_PRODUCT_GOALS\".\"PRODUCT\" AS \"PRODUCT\",\n  \"PRESALE_PRODUCT_GOALS\".\"PRODUCT_GOAL\" AS \"PRODUCT_GOAL\",\n  \"PRESALE_PRODUCT_GOALS\".\"QTR_YR_PG\" AS \"QTR_YR_PG\",\n  \"PRESALE_PRODUCT_GOALS\".\"ROLE\" AS \"ROLE (PRESALE_PRODUCT_GOALS)\",\n  \"PRESALE_PRODUCT_GOALS\".\"TARGET\" AS \"TARGET\",\n  \"PRESALE_PRODUCT_GOALS\".\"TEAM\" AS \"TEAM\",\n  (CASE WHEN (NOT (CAST(TO_TIMESTAMP(\"PRESALE_PRODUCT_GOALS\".\"WEEK_GOAL\", 'MM/DD/YYYY') AS DATE) IS NULL)) THEN CAST(TO_TIMESTAMP(\"PRESALE_PRODUCT_GOALS\".\"WEEK_GOAL\", 'MM/DD/YYYY') AS DATE) WHEN (NOT (TRY_CAST(\"PRESALE_PRODUCT_GOALS\".\"WEEK_GOAL\" AS DATE) IS NULL)) THEN TRY_CAST(\"PRESALE_PRODUCT_GOALS\".\"WEEK_GOAL\" AS DATE) ELSE NULL END) AS \"WEEK_GOAL\"\nFROM REDACTED_DB.\"STATIC\".\"PRESALE_PRODUCT_GOALS\" \"PRESALE_PRODUCT_GOALS\"\n) \"__src_2\"\n  GROUP BY \"WEEK_GOAL\", \"ROLE (PRESALE_PRODUCT_GOALS)\"\n),\n__s3 AS (\n  SELECT\n    \"ROLE_SP\" AS \"ROLE_SP\",\n    MAX(\"WEEK_GOAL_SP\") AS \"WEEK_GOAL_SP\",\n    MAX(\"INITIATIVE\") AS \"INITIATIVE\",\n    SUM(\"INITIATIVE_GOAL\") AS \"INITIATIVE_GOAL\",\n    MAX(\"QTR_YR_SP\") AS \"QTR_YR_SP\"\n  FROM (\nSELECT *\nFROM REDACTED_DB.static.presale_special_projects_goals\n) \"__src_3\"\n  GROUP BY \"ROLE_SP\"\n),\n__s4 AS (\n  SELECT\n    \"CW_WEEK\" AS \"CW_WEEK\",\n    \"ROLE\" AS \"ROLE\",\n    \"QTR_YR\" AS \"QTR_YR\",\n    \"COUNTRY\" AS \"COUNTRY\",\n    MAX(\"QTR\") AS \"QTR\",\n    SUM(\"YR\") AS \"YR\",\n    SUM(\"CLOSES\") AS \"CLOSES\",\n    SUM(\"NARR\") AS \"NARR\",\n    SUM(\"WORKING_DAYS\") AS \"WORKING_DAYS\",\n    SUM(\"AHC_GOAL\") AS \"AHC_GOAL\",\n    SUM(\"CLOSE_PHASING\") AS \"CLOSE_PHASING\",\n    MAX(\"WEEK_OF\") AS \"WEEK_OF\"\n  FROM (\nselect * from REDACTED_DB.static.presale_weekly_goals\n) \"__src_4\"\n  GROUP BY \"CW_WEEK\", \"ROLE\", \"QTR_YR\", \"COUNTRY\"\n),\n__s5 AS (\n  SELECT\n    \"ROLE_SP\" AS \"ROLE_SP\",\n    MAX(\"WEEK_GOAL_SP\") AS \"WEEK_GOAL_SP\",\n    MAX(\"INITIATIVE\") AS \"INITIATIVE\",\n    SUM(\"INITIATIVE_GOAL\") AS \"INITIATIVE_GOAL\",\n    MAX(\"QTR_YR_SP\") AS \"QTR_YR_SP\"\n  FROM (\nselect * from REDACTED_DB.static.presale_special_projects_goals\n) \"__src_5\"\n  GROUP BY \"ROLE_SP\"\n),\n__s6 AS (\n  SELECT\n    \"ROLE_SP\" AS \"ROLE_SP\",\n    MAX(\"WEEK_GOAL_SP\") AS \"WEEK_GOAL_SP\",\n    MAX(\"INITIATIVE\") AS \"INITIATIVE\",\n    SUM(\"INITIATIVE_GOAL\") AS \"INITIATIVE_GOAL\",\n    MAX(\"QTR_YR_SP\") AS \"QTR_YR_SP\"\n  FROM (\nselect * from REDACTED_DB.static.presale_special_projects_goals\n) \"__src_6\"\n  GROUP BY \"ROLE_SP\"\n)\nSELECT\n  __f.\"MERCHANT_CLOSE_DATE\" AS \"MERCHANT_CLOSE_DATE\",\n  __f.\"WEEK_OF\" AS \"WEEK_OF\",\n  __f.\"CW_WEEK\" AS \"CW_WEEK\",\n  __f.\"QTR\" AS \"QTR\",\n  __f.\"YR\" AS \"YR\",\n  __f.\"QTR_YR\" AS \"QTR_YR\",\n  __f.\"READINESS_CHECK_COMPLETE_DATE\" AS \"READINESS_CHECK_COMPLETE_DATE\",\n  __f.\"MERCHANT_ACTIVATION_DATE\" AS \"MERCHANT_ACTIVATION_DATE\",\n  __f.\"MX_ONBOARDING_LINK_SENT_DATE\" AS \"MX_ONBOARDING_LINK_SENT_DATE\",\n  __f.\"OPPORTUNITY_ID\" AS \"OPPORTUNITY_ID\",\n  __f.\"STORE_ACCOUNT_ID\" AS \"STORE_ACCOUNT_ID\",\n  __f.\"BUSINESS_ACCOUNT_ID\" AS \"BUSINESS_ACCOUNT_ID\",\n  __f.\"LEAD_ID\" AS \"LEAD_ID\",\n  __f.\"WORK_ORDER_ID\" AS \"WORK_ORDER_ID\",\n  __f.\"WORK_ORDER_NUMBER\" AS \"WORK_ORDER_NUMBER\",\n  __f.\"STORE_ID\" AS \"STORE_ID\",\n  __f.\"BUSINESS_ID\" AS \"BUSINESS_ID\",\n  __f.\"PROVISIONING_STATUS\" AS \"PROVISIONING_STATUS\",\n  __f.\"SALES_OWNER_ID\" AS \"SALES_OWNER_ID\",\n  __f.\"SALES_OWNER\" AS \"SALES_OWNER\",\n  __f.\"FULL_NAME\" AS \"FULL_NAME\",\n  __f.\"MANAGER_NAME\" AS \"MANAGER_NAME\",\n  __f.\"REP_ROLE\" AS \"REP_ROLE\",\n  __f.\"OWNER_TEAM\" AS \"OWNER_TEAM\",\n  __f.\"OWNER_ORG_FOCUS\" AS \"OWNER_ORG_FOCUS\",\n  __f.\"REP_SEGMENT\" AS \"REP_SEGMENT\",\n  __f.\"SDR_OWNER\" AS \"SDR_OWNER\",\n  __f.\"SDR_ID\" AS \"SDR_ID\",\n  __f.\"SDR_MANAGER_ID\" AS \"SDR_MANAGER_ID\",\n  __f.\"SDR_MANAGER_NAME\" AS \"SDR_MANAGER_NAME\",\n  __f.\"SDR_ROLE\" AS \"SDR_ROLE\",\n  __f.\"SDR_COUNTRY\" AS \"SDR_COUNTRY\",\n  __f.\"REP_COUNTRY\" AS \"REP_COUNTRY\",\n  __f.\"CW_COUNTRY\" AS \"CW_COUNTRY\",\n  __f.\"CLEAN_COUNTRY\" AS \"CLEAN_COUNTRY\",\n  __f.\"OWNER_ROLE_OFFICIAL_TITLE\" AS \"OWNER_ROLE_OFFICIAL_TITLE\",\n  __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" AS \"CW_OWNER_ROLE_OFFICIAL_TITLE\",\n  __f.\"SFDC_COMMISSION\" AS \"SFDC_COMMISSION\",\n  __f.\"DASHPASS_COMMISSION\" AS \"DASHPASS_COMMISSION\",\n  __f.\"NARR\" AS \"NARR\",\n  __f.\"OPPORTUNITY_NAME\" AS \"OPPORTUNITY_NAME\",\n  __f.\"OPP_TYPE\" AS \"OPP_TYPE\",\n  __f.\"ACCOUNT_NAME\" AS \"ACCOUNT_NAME\",\n  __f.\"STORE_NAME\" AS \"STORE_NAME\",\n  __f.\"BUSINESS_NAME\" AS \"BUSINESS_NAME\",\n  __f.\"DECK_RANK\" AS \"DECK_RANK\",\n  __f.\"PRIMARY_VERTICAL\" AS \"PRIMARY_VERTICAL\",\n  __f.\"COUNTRY\" AS \"COUNTRY\",\n  __f.\"STARTING_POINT_ID\" AS \"STARTING_POINT_ID\",\n  __f.\"STARTING_POINT\" AS \"STARTING_POINT\",\n  __f.\"SUBMARKET\" AS \"SUBMARKET\",\n  __f.\"SUBMARKET_ID\" AS \"SUBMARKET_ID\",\n  __f.\"TOP_MX\" AS \"TOP_MX\",\n  __f.\"MARKET_MAKER\" AS \"MARKET_MAKER\",\n  __f.\"IS_GNC\" AS \"IS_GNC\",\n  __f.\"IS_DASHPASS\" AS \"IS_DASHPASS\",\n  __f.\"IS_PICKUP\" AS \"IS_PICKUP\",\n  __f.\"IS_STOREFRONT\" AS \"IS_STOREFRONT\",\n  __f.\"IS_ALCOHOL\" AS \"IS_ALCOHOL\",\n  __f.\"IS_TRIAL\" AS \"IS_TRIAL\",\n  __f.\"IS_PROMO\" AS \"IS_PROMO\",\n  __f.\"IS_ADS\" AS \"IS_ADS\",\n  __f.\"IS_ADS_PROMOS\" AS \"IS_ADS_PROMOS\",\n  __f.\"PACKAGE_SOLD\" AS \"PACKAGE_SOLD\",\n  __f.\"NTAM\" AS \"NTAM\",\n  __f.\"INCREMENTAL_SIGN_TAM\" AS \"INCREMENTAL_SIGN_TAM\",\n  __f.\"HISTORICAL_DELAY_REASONS_CUSTOMIZED\" AS \"HISTORICAL_DELAY_REASONS_CUSTOMIZED\",\n  __f.\"LEAD_LIST_CUSTOMIZED\" AS \"LEAD_LIST_CUSTOMIZED\",\n  __f.\"TRIAL_PERIOD\" AS \"TRIAL_PERIOD\",\n  __f.\"TOP_MX_SIGNING_BONUS_APPROVAL_THRESHOLD\" AS \"TOP_MX_SIGNING_BONUS_APPROVAL_THRESHOLD\",\n  __f.\"ACTIVATION_BONUS_AMOUNT\" AS \"ACTIVATION_BONUS_AMOUNT\",\n  __f.\"PRODUCT_LIST\" AS \"PRODUCT_LIST\",\n  __f.\"REGION\" AS \"REGION\",\n  __f.\"TIER\" AS \"TIER\",\n  __f.\"SFDC_SOURCE\" AS \"SFDC_SOURCE\",\n  __f.\"LAST_ETL_RUN\" AS \"LAST_ETL_RUN\",\n  __s0.\"WEEK_GOAL_ACTIVATIONS\" AS \"WEEK_GOAL_ACTIVATIONS\",\n  __s0.\"ACTIVATION_GOAL\" AS \"ACTIVATION_GOAL\",\n  __s0.\"QUARTER_YEAR\" AS \"QUARTER_YEAR\",\n  __s1.\"COUNTRY (PRESALES_ACTIVE_HC)\" AS \"COUNTRY_2\",\n  __s1.\"DAYS_OFF\" AS \"DAYS_OFF\",\n  __s1.\"HC\" AS \"HC\",\n  __s1.\"QTR (PRESALES_ACTIVE_HC)\" AS \"QTR_2\",\n  __s1.\"REP_RANK\" AS \"REP_RANK\",\n  __s1.\"SALES_MANAGER\" AS \"SALES_MANAGER\",\n  __s1.\"SALES_OWNER (PRESALES_ACTIVE_HC)\" AS \"SALES_OWNER_2\",\n  __s1.\"USER_ID\" AS \"USER_ID\",\n  __s1.\"WEEK_OF (PRESALES_ACTIVE_HC)\" AS \"WEEK_OF_2\",\n  __s1.\"YR (PRESALES_ACTIVE_HC)\" AS \"YR_2\",\n  __s2.\"BASED\" AS \"BASED\",\n  __s2.\"ORG\" AS \"ORG\",\n  __s2.\"PRODUCT\" AS \"PRODUCT\",\n  __s2.\"PRODUCT_GOAL\" AS \"PRODUCT_GOAL\",\n  __s2.\"QTR_YR_PG\" AS \"QTR_YR_PG\",\n  __s2.\"TARGET\" AS \"TARGET\",\n  __s2.\"TEAM\" AS \"TEAM\",\n  __s3.\"WEEK_GOAL_SP\" AS \"WEEK_GOAL_SP\",\n  __s3.\"INITIATIVE\" AS \"INITIATIVE\",\n  __s3.\"INITIATIVE_GOAL\" AS \"INITIATIVE_GOAL\",\n  __s3.\"QTR_YR_SP\" AS \"QTR_YR_SP\",\n  __s4.\"QTR\" AS \"QTR_3\",\n  __s4.\"YR\" AS \"YR_3\",\n  __s4.\"CLOSES\" AS \"CLOSES\",\n  __s4.\"NARR\" AS \"NARR_2\",\n  __s4.\"WORKING_DAYS\" AS \"WORKING_DAYS\",\n  __s4.\"AHC_GOAL\" AS \"AHC_GOAL\",\n  __s4.\"CLOSE_PHASING\" AS \"CLOSE_PHASING\",\n  __s4.\"WEEK_OF\" AS \"WEEK_OF_3\",\n  __s5.\"WEEK_GOAL_SP\" AS \"WEEK_GOAL_SP_2\",\n  __s5.\"INITIATIVE\" AS \"INITIATIVE_2\",\n  __s5.\"INITIATIVE_GOAL\" AS \"INITIATIVE_GOAL_2\",\n  __s5.\"QTR_YR_SP\" AS \"QTR_YR_SP_2\",\n  __s6.\"WEEK_GOAL_SP\" AS \"WEEK_GOAL_SP_3\",\n  __s6.\"INITIATIVE\" AS \"INITIATIVE_3\",\n  __s6.\"INITIATIVE_GOAL\" AS \"INITIATIVE_GOAL_3\",\n  __s6.\"QTR_YR_SP\" AS \"QTR_YR_SP_3\"\nFROM __f\nLEFT JOIN __s0 ON __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s0.\"ROLE_ACTIVATIONS\" AND __f.\"CW_COUNTRY\" = __s0.\"COUNTRY\"\nLEFT JOIN __s1 ON __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s1.\"OWNER_ROLE_OFFICIAL_TITLE (PRESALES_ACTIVE_HC)\" AND __f.\"QTR_YR\" = __s1.\"QTR_YR (PRESALES_ACTIVE_HC)\"\nLEFT JOIN __s2 ON __f.\"WEEK_OF\" = __s2.\"WEEK_GOAL\" AND __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s2.\"ROLE (PRESALE_PRODUCT_GOALS)\"\nLEFT JOIN __s3 ON __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s3.\"ROLE_SP\"\nLEFT JOIN __s4 ON __f.\"CW_WEEK\" = __s4.\"CW_WEEK\" AND __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s4.\"ROLE\" AND __f.\"QTR_YR\" = __s4.\"QTR_YR\" AND __f.\"CW_COUNTRY\" = __s4.\"COUNTRY\"\nLEFT JOIN __s5 ON __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s5.\"ROLE_SP\"\nLEFT JOIN __s6 ON __f.\"CW_OWNER_ROLE_OFFICIAL_TITLE\" = __s6.\"ROLE_SP\""
          },
